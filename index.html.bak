<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#0B0716">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="author" content="Yasin Ullah — Bannu Software Solutions">
  <meta name="copyright" content="Copyright (c) 2026 Yasin Ullah. All Rights Reserved.">
  <meta name="description"
    content="BRICKPOP NOVA ULTIMATE — Offline neon arcade brick breaker with unlimited levels, dynamic ranks, 4 game modes, daily missions, 11 power-ups, bosses, skins, and pro stats. Created by Yasin Ullah, dedicated to little Muhib Ullah.">
  <title>BRICKPOP NOVA ULTIMATE — By Yasin Ullah</title>
  <style>
    /* ============ TOKENS ============ */
    :root {
      --bg: #0B0716;
      --bg2: #120A24;
      --surface: #171029;
      --surface2: #211741;
      --surface3: #2A1D52;
      --line: rgba(160, 140, 255, .15);
      --line2: rgba(160, 140, 255, .28);
      --violet: #8B5CF6;
      --violet2: #7C4DFF;
      --magenta: #FF3D8A;
      --cyan: #22D3EE;
      --lime: #A3E635;
      --amber: #FFB020;
      --blue: #38BDF8;
      --success: #34D399;
      --warning: #FFB020;
      --danger: #FF4D5E;
      --info: #38BDF8;
      --text: #F4F1FF;
      --muted: #9C93C2;
      --faint: #766D9E;
      --grad-primary: linear-gradient(135deg, #7C4DFF 0%, #B44DF0 55%, #FF3D8A 100%);
      --grad-cyan: linear-gradient(135deg, #22D3EE, #8B5CF6);
      --grad-hot: linear-gradient(135deg, #FFB020, #FF3D8A);
      --grad-acid: linear-gradient(135deg, #A3E635, #22D3EE);
      --hdr-h: calc(58px + env(safe-area-inset-top, 0px));
      --tab-h: calc(64px + env(safe-area-inset-bottom, 0px));
      --r-lg: 22px;
      --r-md: 16px;
      --r-sm: 11px;
      --font-d: 'Segoe UI', 'Trebuchet MS', 'Arial Black', system-ui, sans-serif;
      --font-b: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      --shadow-card: 0 8px 28px rgba(4, 2, 12, .5);
    }

    body.high-contrast {
      --bg: #05030C;
      --surface: #120C24;
      --surface2: #1D1438;
      --line: rgba(200, 190, 255, .35);
      --line2: rgba(220, 210, 255, .65);
      --text: #FFFFFF;
      --muted: #D5CEF2;
      --faint: #ABA2D4;
    }

    body.reduced-motion *,
    body.reduced-motion *::before,
    body.reduced-motion *::after {
      animation-duration: .01s !important;
      transition-duration: .01s !important;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent
    }

    html,
    body {
      height: 100%;
      overflow: hidden
    }

    body {
      position: fixed;
      inset: 0;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-b);
      font-size: 15px;
      line-height: 1.45;
      display: flex;
      align-items: center;
      justify-content: center;
      overscroll-behavior: none;
      -webkit-user-select: none;
      user-select: none;
      -webkit-touch-callout: none;
    }

    button {
      font-family: inherit;
      color: inherit;
      background: none;
      border: none;
      cursor: pointer;
      touch-action: manipulation
    }

    input {
      font-family: inherit
    }

    :focus {
      outline: none
    }

    :focus-visible {
      outline: 2px solid var(--cyan);
      outline-offset: 2px;
      border-radius: 8px
    }

    ::-webkit-scrollbar {
      width: 7px;
      height: 7px
    }

    ::-webkit-scrollbar-track {
      background: rgba(139, 92, 246, .06);
      border-radius: 8px
    }

    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #7C4DFF, #FF3D8A);
      border-radius: 8px
    }

    * {
      scrollbar-width: thin;
      scrollbar-color: #7C4DFF rgba(139, 92, 246, .08)
    }

    /* ============ AMBIENT PAGE ============ */
    #bg {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0
    }

    #bg .aur {
      position: absolute;
      border-radius: 50%;
      filter: blur(70px);
      opacity: .48;
      will-change: transform
    }

    #bg .a1 {
      width: 56vmax;
      height: 56vmax;
      left: -18vmax;
      top: -20vmax;
      background: radial-gradient(circle, #7C4DFF 0%, transparent 65%);
      animation: drift1 26s ease-in-out infinite alternate
    }

    #bg .a2 {
      width: 48vmax;
      height: 48vmax;
      right: -16vmax;
      bottom: -18vmax;
      background: radial-gradient(circle, #FF3D8A 0%, transparent 65%);
      animation: drift2 31s ease-in-out infinite alternate
    }

    #bg .a3 {
      width: 34vmax;
      height: 34vmax;
      right: 8vmax;
      top: -12vmax;
      background: radial-gradient(circle, #22D3EE 0%, transparent 65%);
      opacity: .3;
      animation: drift3 22s ease-in-out infinite alternate
    }

    @keyframes drift1 {
      to {
        transform: translate(9vmax, 7vmax) scale(1.12)
      }
    }

    @keyframes drift2 {
      to {
        transform: translate(-8vmax, -9vmax) scale(1.08)
      }
    }

    @keyframes drift3 {
      to {
        transform: translate(-6vmax, 8vmax)
      }
    }

    #bg .fbrick {
      position: absolute;
      border-radius: 8px;
      opacity: .15;
      filter: blur(1px);
      animation: floaty 14s ease-in-out infinite alternate
    }

    @keyframes floaty {
      to {
        transform: translateY(-46px) rotate(14deg)
      }
    }

    .side {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      z-index: 1;
      display: none;
      pointer-events: none
    }

    .side-l {
      left: max(24px, calc(50vw - 565px))
    }

    .side-r {
      right: max(24px, calc(50vw - 565px));
      pointer-events: auto
    }

    .side-logo {
      font-family: var(--font-d);
      font-weight: 900;
      font-size: 66px;
      line-height: .96;
      letter-spacing: 1.5px;
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(160, 140, 255, .35)
    }

    .side-logo b {
      display: block;
      background: var(--grad-primary);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-stroke: 0;
      color: transparent
    }

    .side-tag {
      margin-top: 14px;
      color: var(--muted);
      font-size: 13.5px;
      max-width: 240px
    }

    .side-ded {
      margin-top: 10px;
      font-size: 12px;
      color: #FFD166;
      font-weight: 700
    }

    .side-chips {
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      max-width: 260px
    }

    .side-chip {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .6px;
      padding: 5px 10px;
      border-radius: 999px;
      border: 1px solid var(--line2);
      color: var(--cyan);
      background: rgba(34, 211, 238, .06)
    }

    .side-chip.m {
      color: var(--magenta);
      background: rgba(255, 61, 138, .06)
    }

    .side-chip.l {
      color: var(--lime);
      background: rgba(163, 230, 53, .06)
    }

    .side-chip.g {
      color: var(--amber);
      background: rgba(255, 176, 32, .06)
    }

    .keys-card {
      background: rgba(23, 16, 41, .82);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 18px;
      width: 236px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: var(--shadow-card)
    }

    .keys-card h4 {
      font-size: 11px;
      letter-spacing: 2.4px;
      color: var(--faint);
      font-weight: 800;
      margin-bottom: 12px
    }

    .key-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 5.5px 0;
      font-size: 12.5px;
      color: var(--muted)
    }

    kbd {
      font-family: var(--font-b);
      font-weight: 700;
      font-size: 10.5px;
      color: var(--text);
      background: var(--surface3);
      border: 1px solid var(--line2);
      border-bottom-width: 2px;
      border-radius: 6px;
      padding: 2px 7px;
      min-width: 24px;
      text-align: center;
      display: inline-block
    }

    .side-copy {
      margin-top: 14px;
      font-size: 11px;
      color: var(--faint);
      max-width: 236px;
      line-height: 1.5
    }

    @media(min-width:1180px) {
      .side {
        display: block
      }
    }

    /* ============ APP SHELL ============ */
    #app {
      position: relative;
      z-index: 2;
      width: 100vw;
      width: min(100vw, calc(100dvh * .74));
      height: 100vh;
      height: 100dvh;
      background: linear-gradient(180deg, #100A20 0%, #0B0716 60%, #0D0818 100%);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    @media(min-width:700px) {
      #app {
        height: min(calc(100dvh - 36px), 960px);
        width: min(620px, calc((100dvh - 36px)*.74));
        border-radius: 34px;
        border: 1px solid var(--line2);
        box-shadow: 0 0 0 1px rgba(10, 5, 25, .9), 0 30px 90px rgba(3, 1, 10, .8), 0 0 90px rgba(124, 77, 255, .22), 0 0 40px rgba(255, 61, 138, .12);
      }
    }

    #app:fullscreen {
      width: 100vw !important;
      height: 100vh !important;
      border-radius: 0 !important;
      border: none !important;
      max-width: none !important
    }

    /* header */
    #hdr {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: var(--hdr-h);
      padding: env(safe-area-inset-top, 0px) 12px 0;
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 30;
      background: linear-gradient(180deg, rgba(11, 7, 22, .94), rgba(11, 7, 22, .74) 72%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px)
    }

    .logo {
      font-family: var(--font-d);
      font-weight: 900;
      font-size: 16px;
      letter-spacing: .8px;
      display: flex;
      align-items: center;
      gap: 2px
    }

    .logo .l1 {
      background: var(--grad-cyan);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent
    }

    .logo .l2 {
      background: var(--grad-hot);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent
    }

    .logo .dia {
      width: 8px;
      height: 8px;
      background: var(--grad-primary);
      transform: rotate(45deg);
      border-radius: 2px;
      margin: 0 3px;
      box-shadow: 0 0 10px rgba(255, 61, 138, .8);
      animation: diaspin 5s linear infinite
    }

    @keyframes diaspin {
      to {
        transform: rotate(405deg)
      }
    }

    #hdr .sp {
      flex: 1
    }

    .rank-pill-hdr {
      display: flex;
      align-items: center;
      gap: 5px;
      background: rgba(139, 92, 246, .16);
      border: 1px solid rgba(139, 92, 246, .42);
      color: #DDD2FF;
      font-weight: 800;
      font-size: 11.5px;
      padding: 6px 10px;
      border-radius: 999px;
      max-width: 128px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap
    }

    .coins-chip {
      display: flex;
      align-items: center;
      gap: 5px;
      background: rgba(255, 197, 61, .1);
      border: 1px solid rgba(255, 197, 61, .36);
      color: #FFC53D;
      font-weight: 800;
      font-size: 13px;
      padding: 6px 10px;
      border-radius: 999px;
      transition: transform .15s
    }

    .coins-chip:active {
      transform: scale(.94)
    }

    .coins-chip.pulse {
      animation: coinpulse .5s ease
    }

    @keyframes coinpulse {
      30% {
        transform: scale(1.14);
        box-shadow: 0 0 18px rgba(255, 197, 61, .5)
      }
    }

    .mute-btn,
    .fs-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      font-size: 12px;
      font-weight: 700;
      padding: 7px 9px;
      border-radius: 999px;
      border: 1px solid rgba(34, 211, 238, .4);
      color: var(--cyan);
      background: rgba(34, 211, 238, .08);
      transition: all .2s
    }

    .mute-btn .ic,
    .fs-btn .ic {
      font-size: 15px
    }

    .mute-btn.off {
      color: var(--faint);
      border-color: var(--line);
      background: rgba(110, 101, 150, .08)
    }

    .mute-btn:active,
    .fs-btn:active {
      transform: scale(.92)
    }

    /* screens */
    #screens {
      position: absolute;
      inset: 0
    }

    .screen {
      position: absolute;
      top: var(--hdr-h);
      bottom: var(--tab-h);
      left: 0;
      right: 0;
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior: contain;
      padding: 12px 15px 26px;
      display: none;
      -webkit-overflow-scrolling: touch
    }

    .screen.active {
      display: block
    }

    .screen.active>* {
      animation: fadeUp .38s cubic-bezier(.22, 1, .36, 1) both
    }

    .screen.active>*:nth-child(2) {
      animation-delay: .04s
    }

    .screen.active>*:nth-child(3) {
      animation-delay: .08s
    }

    .screen.active>*:nth-child(4) {
      animation-delay: .12s
    }

    .screen.active>*:nth-child(5) {
      animation-delay: .16s
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(14px)
      }

      to {
        opacity: 1;
        transform: none
      }
    }

    #screen-game {
      top: 0;
      bottom: 0;
      padding: 0;
      overflow: hidden;
      background: #0B0716
    }

    #screen-game.active {
      display: flex;
      flex-direction: column
    }

    #app:fullscreen #hdr,
    #app:fullscreen #tabbar,
    #app:fullscreen .screen:not(#screen-game) {
      max-width: 680px;
      margin-left: auto;
      margin-right: auto;
      left: 0;
      right: 0
    }

    #app:fullscreen .sheet {
      max-width: 640px;
      margin-left: auto;
      margin-right: auto
    }

    #app.in-game #hdr,
    #app.in-game #tabbar {
      display: none
    }

    /* tabbar */
    #tabbar {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: var(--tab-h);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      display: flex;
      z-index: 30;
      background: rgba(16, 10, 32, .92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid var(--line)
    }

    .tab {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      color: var(--faint);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .25px;
      position: relative;
      transition: color .2s
    }

    .tab .ic {
      font-size: 20px;
      transition: transform .25s cubic-bezier(.34, 1.56, .64, 1)
    }

    .tab:active .ic {
      transform: scale(.85)
    }

    .tab.active {
      color: var(--text)
    }

    .tab.active .ic {
      transform: translateY(-2px);
      filter: drop-shadow(0 0 8px rgba(139, 92, 246, .9))
    }

    .tab.active::before {
      content: '';
      position: absolute;
      top: 0;
      width: 32px;
      height: 3px;
      border-radius: 0 0 4px 4px;
      background: var(--grad-primary);
      box-shadow: 0 2px 12px rgba(255, 61, 138, .7)
    }

    .tab .badge {
      position: absolute;
      top: 7px;
      right: calc(50% - 22px);
      min-width: 16px;
      height: 16px;
      border-radius: 8px;
      background: var(--danger);
      color: #fff;
      font-size: 9.5px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      box-shadow: 0 0 10px rgba(255, 77, 94, .7)
    }

    /* icons */
    .ic {
      display: inline-flex;
      width: 1em;
      height: 1em;
      flex: none
    }

    .ic svg {
      width: 100%;
      height: 100%;
      display: block
    }

    /* generic cards & buttons */
    .card {
      background: linear-gradient(160deg, var(--surface) 0%, #140D26 100%);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      padding: 15px;
      box-shadow: var(--shadow-card);
      margin-bottom: 13px
    }

    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 800;
      font-size: 14.5px;
      border-radius: 15px;
      padding: 13px 16px;
      transition: transform .12s, filter .2s;
      min-height: 48px
    }

    .btn:active {
      transform: scale(.96)
    }

    .btn .ic {
      font-size: 17px
    }

    .btn-primary {
      background: var(--grad-primary);
      color: #fff;
      box-shadow: 0 6px 22px rgba(124, 77, 255, .4), 0 2px 8px rgba(255, 61, 138, .35);
      text-shadow: 0 1px 3px rgba(30, 5, 40, .4)
    }

    .btn-primary:hover {
      filter: brightness(1.08)
    }

    .btn-cyan {
      background: var(--grad-cyan);
      color: #08131F;
      box-shadow: 0 6px 22px rgba(34, 211, 238, .28)
    }

    .btn-gold {
      background: var(--grad-hot);
      color: #1E0914;
      box-shadow: 0 6px 20px rgba(255, 176, 32, .32)
    }

    .btn-ghost {
      background: var(--surface2);
      border: 1px solid var(--line2);
      color: var(--text)
    }

    .btn-danger {
      background: rgba(255, 77, 94, .12);
      border: 1px solid rgba(255, 77, 94, .45);
      color: var(--danger)
    }

    .btn-sm {
      min-height: 36px;
      padding: 7px 13px;
      font-size: 12.5px;
      border-radius: 11px
    }

    .btn[disabled],
    .btn.dis {
      opacity: .45;
      filter: saturate(.4)
    }

    .btn-row {
      display: flex;
      gap: 9px
    }

    .btn-row .btn {
      flex: 1
    }

    .btn-icon {
      width: 40px;
      height: 40px;
      min-height: 0;
      padding: 0;
      border-radius: 12px;
      background: rgba(23, 16, 41, .78);
      border: 1px solid var(--line2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px)
    }

    .btn-icon:active {
      transform: scale(.9)
    }

    .sec-title {
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--faint);
      text-transform: uppercase;
      margin: 18px 2px 9px
    }

    .big-title {
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -.3px
    }

    .sub-title {
      color: var(--muted);
      font-size: 13px;
      margin-top: 2px
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .5px;
      padding: 4px 9px;
      border-radius: 999px;
      border: 1px solid var(--line2);
      color: var(--muted)
    }

    /* ============ DEDICATION BANNER ============ */
    .dedication-strip {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      background: linear-gradient(90deg, rgba(255, 176, 32, .1), rgba(255, 61, 138, .14), rgba(139, 92, 246, .12));
      border: 1px solid rgba(255, 176, 32, .28);
      border-radius: 14px;
      padding: 8px 12px;
      margin-bottom: 12px;
      font-size: 12px;
      font-weight: 700;
      color: #FFE6A7;
      text-align: center;
    }

    /* ============ HOME ============ */
    .hero {
      position: relative;
      border-radius: 24px;
      padding: 17px;
      overflow: hidden;
      border: 1px solid var(--line2);
      margin-bottom: 13px;
      box-shadow: var(--shadow-card)
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(140deg, var(--wa, #22D3EE) -30%, transparent 45%), linear-gradient(320deg, var(--wb, #FF3D8A) -40%, transparent 50%), linear-gradient(160deg, #1B1233, #120A24)
    }

    .hero>* {
      position: relative;
      z-index: 1
    }

    .hero-kicker {
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: 2.2px;
      color: var(--wa, #22D3EE);
      display: flex;
      align-items: center;
      gap: 6px
    }

    .hero-main {
      display: flex;
      gap: 12px;
      align-items: center;
      margin: 9px 0 12px
    }

    .hero-num {
      font-family: var(--font-d);
      font-weight: 900;
      font-size: 38px;
      line-height: 1;
      background: linear-gradient(180deg, #fff, var(--wa, #22D3EE));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent
    }

    .hero-name {
      font-weight: 800;
      font-size: 16.5px
    }

    .hero-sub {
      color: var(--muted);
      font-size: 12px;
      margin-top: 2px
    }

    .hero-prev {
      margin-left: auto;
      width: 108px;
      height: 72px;
      border-radius: 11px;
      background: rgba(8, 4, 18, .55);
      border: 1px solid var(--line);
      flex: none
    }

    .hero-bar {
      height: 7px;
      border-radius: 4px;
      background: rgba(8, 4, 18, .6);
      overflow: hidden;
      margin-bottom: 12px;
      border: 1px solid rgba(160, 140, 255, .1)
    }

    .hero-bar i {
      display: block;
      height: 100%;
      border-radius: 4px;
      background: linear-gradient(90deg, var(--wa, #22D3EE), var(--wb, #FF3D8A));
      transition: width .5s ease
    }

    .hero-meta {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--muted);
      margin: -6px 2px 10px;
      font-weight: 600
    }

    .rank-banner {
      display: flex;
      align-items: center;
      gap: 12px;
      background: linear-gradient(135deg, rgba(124, 77, 255, .18), rgba(34, 211, 238, .1));
      border: 1px solid rgba(139, 92, 246, .35);
      border-radius: 18px;
      padding: 12px 14px;
      margin-bottom: 13px
    }

    .rank-emblem {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: rgba(8, 4, 18, .6);
      border: 1px solid var(--line2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex: none
    }

    .rank-info {
      flex: 1;
      min-width: 0
    }

    .rank-info b {
      font-size: 14px;
      display: block
    }

    .rank-info small {
      font-size: 11.5px;
      color: var(--muted);
      display: block
    }

    .xp-bar {
      height: 6px;
      border-radius: 4px;
      background: rgba(8, 4, 18, .7);
      overflow: hidden;
      margin-top: 6px
    }

    .xp-bar i {
      display: block;
      height: 100%;
      background: var(--grad-acid);
      border-radius: 4px;
      transition: width .4s ease
    }

    .daily {
      display: flex;
      align-items: center;
      gap: 12px
    }

    .daily-ic {
      width: 44px;
      height: 44px;
      flex: none;
      border-radius: 14px;
      background: var(--grad-hot);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 21px;
      color: #2A0D18
    }

    .daily-info {
      flex: 1;
      min-width: 0
    }

    .daily-info b {
      font-size: 14.5px
    }

    .daily-info p {
      font-size: 11.5px;
      color: var(--muted)
    }

    .mode-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 13px
    }

    .mode {
      position: relative;
      border-radius: 18px;
      padding: 13px;
      border: 1px solid var(--line);
      overflow: hidden;
      text-align: left;
      transition: transform .14s;
      box-shadow: var(--shadow-card)
    }

    .mode:active {
      transform: scale(.96)
    }

    .mode::before {
      content: '';
      position: absolute;
      inset: 0;
      opacity: .92
    }

    .mode.endless::before {
      background: linear-gradient(150deg, rgba(139, 92, 246, .34), rgba(20, 13, 38, .92) 64%), var(--surface)
    }

    .mode.timed::before {
      background: linear-gradient(150deg, rgba(255, 176, 32, .28), rgba(20, 13, 38, .92) 64%), var(--surface)
    }

    .mode.dailyc::before {
      background: linear-gradient(150deg, rgba(255, 61, 138, .3), rgba(20, 13, 38, .92) 64%), var(--surface)
    }

    .mode.help::before {
      background: linear-gradient(150deg, rgba(34, 211, 238, .26), rgba(20, 13, 38, .92) 64%), var(--surface)
    }

    .mode>* {
      position: relative
    }

    .mode .m-ic {
      font-size: 22px;
      margin-bottom: 6px;
      display: inline-flex
    }

    .mode.endless .m-ic {
      color: var(--violet)
    }

    .mode.timed .m-ic {
      color: var(--amber)
    }

    .mode.dailyc .m-ic {
      color: var(--magenta)
    }

    .mode.help .m-ic {
      color: var(--cyan)
    }

    .mode b {
      display: block;
      font-size: 14px
    }

    .mode span {
      font-size: 11px;
      color: var(--muted)
    }

    .strip {
      display: flex;
      gap: 9px;
      margin-bottom: 13px
    }

    .stat-chip {
      flex: 1;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 15px;
      padding: 10px 6px;
      text-align: center
    }

    .stat-chip b {
      font-family: var(--font-d);
      font-weight: 800;
      font-size: 15px;
      display: block
    }

    .stat-chip span {
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: .7px;
      color: var(--faint);
      text-transform: uppercase
    }

    .stat-chip.s1 b {
      color: var(--amber)
    }

    .stat-chip.s2 b {
      color: var(--cyan)
    }

    .stat-chip.s3 b {
      color: var(--magenta)
    }

    .tip-card {
      display: flex;
      gap: 10px;
      align-items: flex-start
    }

    .tip-card .ic {
      font-size: 18px;
      color: var(--lime);
      margin-top: 2px
    }

    #tipText {
      font-size: 12.5px;
      color: var(--muted);
      transition: opacity .3s
    }

    #tipText.fade {
      opacity: 0
    }

    .foot {
      color: var(--faint);
      font-size: 11px;
      text-align: center;
      margin-top: 8px;
      line-height: 1.55
    }

    .foot strong {
      color: var(--muted)
    }

    /* ============ LEVELS ============ */
    .sector-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin: 10px 0 8px
    }

    .sector-nav {
      display: flex;
      align-items: center;
      gap: 6px
    }

    .filter-row {
      display: flex;
      gap: 5px;
      background: rgba(8, 4, 18, .6);
      border: 1px solid var(--line);
      border-radius: 11px;
      padding: 3px
    }

    .filter-row button {
      padding: 5px 9px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      color: var(--muted)
    }

    .filter-row button.active {
      background: var(--grad-primary);
      color: #fff
    }

    .wchips {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      padding: 2px 2px 10px;
      margin: 0 -2px
    }

    .wchip {
      flex: none;
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 8px 12px;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--line);
      font-weight: 700;
      font-size: 12px;
      color: var(--muted);
      transition: all .2s
    }

    .wchip .wchip-num {
      font-family: var(--font-d);
      font-weight: 800;
      font-size: 12px;
      color: var(--wa)
    }

    .wchip.active {
      color: var(--text);
      border-color: var(--wa);
      background: linear-gradient(140deg, color-mix(in srgb, var(--wa) 20%, #171029), #171029)
    }

    .wchip.locked {
      opacity: .45
    }

    .wbanner {
      border-radius: 18px;
      padding: 14px 15px;
      margin-bottom: 13px;
      border: 1px solid var(--line2);
      position: relative;
      overflow: hidden
    }

    .wbanner::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, var(--wa) -60%, transparent 55%), linear-gradient(300deg, var(--wb) -70%, transparent 55%), var(--surface)
    }

    .wbanner>* {
      position: relative
    }

    .wbanner h3 {
      font-size: 18px;
      font-weight: 800
    }

    .wbanner p {
      font-size: 12px;
      color: var(--muted)
    }

    .wbanner .wb-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 9px
    }

    .wb-bar {
      flex: 1;
      height: 6px;
      border-radius: 3px;
      background: rgba(8, 4, 18, .6);
      overflow: hidden
    }

    .wb-bar i {
      display: block;
      height: 100%;
      background: linear-gradient(90deg, var(--wa), var(--wb));
      border-radius: 3px
    }

    .wb-stars {
      font-size: 12px;
      font-weight: 800;
      color: var(--amber);
      display: flex;
      align-items: center;
      gap: 4px
    }

    .lvl-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 9px
    }

    .lvl {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 15px;
      padding: 7px;
      text-align: left;
      transition: transform .12s
    }

    .lvl:active {
      transform: scale(.94)
    }

    .lvl-prev {
      display: block;
      width: 100%;
      aspect-ratio: 3/2;
      border-radius: 8px;
      background: rgba(8, 4, 18, .5)
    }

    .lvl-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 5px;
      padding: 0 2px
    }

    .lvl-num {
      font-family: var(--font-d);
      font-weight: 800;
      font-size: 11.5px;
      color: var(--muted)
    }

    .lvl-stars {
      display: flex;
      gap: 1px;
      font-size: 10px;
      color: #3A3160
    }

    .lvl-stars .on {
      color: var(--amber)
    }

    .lvl-stars .on svg {
      fill: currentColor
    }

    .lvl.locked {
      opacity: .48
    }

    .lvl.locked .lvl-prev {
      filter: grayscale(.8) brightness(.6)
    }

    .lvl-lock {
      position: absolute;
      top: 34%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 18px;
      color: var(--muted)
    }

    .lvl.next {
      border-color: var(--cyan);
      box-shadow: 0 0 0 1px var(--cyan), 0 0 18px rgba(34, 211, 238, .28)
    }

    .lvl.next .lvl-num {
      color: var(--cyan)
    }

    .lvl-play {
      position: absolute;
      top: 6px;
      right: 6px;
      font-size: 8px;
      font-weight: 800;
      letter-spacing: .9px;
      background: var(--grad-cyan);
      color: #08131F;
      padding: 2px 6px;
      border-radius: 5px
    }

    .lvl-boss {
      position: absolute;
      top: 6px;
      left: 6px;
      font-size: 12px;
      color: var(--amber)
    }

    .lvl.boss {
      border-color: rgba(255, 176, 32, .42)
    }

    /* ============ SHOP ============ */
    .balance {
      display: flex;
      align-items: center;
      gap: 13px
    }

    .balance .b-ic {
      width: 48px;
      height: 48px;
      border-radius: 15px;
      background: linear-gradient(135deg, #FFC53D, #FF8A3D);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: #3A2004
    }

    .balance b {
      font-family: var(--font-d);
      font-size: 24px;
      font-weight: 900;
      color: #FFC53D;
      display: block;
      line-height: 1.1
    }

    .balance span {
      font-size: 12px;
      color: var(--muted)
    }

    .shop-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid rgba(160, 140, 255, .08)
    }

    .shop-item:last-child {
      border-bottom: none
    }

    .si-ic {
      width: 44px;
      height: 44px;
      flex: none;
      border-radius: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: #0B0716;
      position: relative
    }

    .si-own {
      position: absolute;
      top: -6px;
      right: -6px;
      background: var(--surface3);
      border: 1px solid var(--line2);
      color: var(--text);
      font-size: 10px;
      font-weight: 800;
      border-radius: 8px;
      padding: 1px 6px
    }

    .si-info {
      flex: 1;
      min-width: 0
    }

    .si-info b {
      font-size: 14px;
      display: block
    }

    .si-info p {
      font-size: 11.5px;
      color: var(--muted)
    }

    .si-buy {
      display: flex;
      align-items: center;
      gap: 5px;
      font-weight: 800;
      font-size: 12.5px;
      color: #FFC53D;
      background: rgba(255, 197, 61, .1);
      border: 1px solid rgba(255, 197, 61, .35);
      padding: 8px 11px;
      border-radius: 10px
    }

    .si-buy:active {
      transform: scale(.92)
    }

    .si-buy.cant {
      opacity: .45
    }

    .skins-row {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 2px 2px 8px
    }

    .skin {
      flex: none;
      width: 142px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 17px;
      padding: 10px
    }

    .skin.equipped {
      border-color: var(--cyan);
      box-shadow: 0 0 14px rgba(34, 211, 238, .25)
    }

    .skin-prev {
      height: 58px;
      border-radius: 10px;
      background: radial-gradient(ellipse at 50% 120%, color-mix(in srgb, var(--sc1) 25%, transparent), transparent 70%), rgba(8, 4, 18, .6);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden
    }

    .skin-pad {
      width: 70px;
      height: 12px;
      border-radius: 6px;
      background: linear-gradient(90deg, var(--sc1), var(--sc2), var(--sc3));
      box-shadow: 0 0 14px var(--sc1)
    }

    .skin-ball {
      position: absolute;
      top: 13px;
      left: 50%;
      width: 8px;
      height: 8px;
      margin-left: -4px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 10px var(--sc1);
      animation: skinbounce 1.6s ease-in-out infinite alternate
    }

    @keyframes skinbounce {
      to {
        transform: translate(20px, 13px)
      }
    }

    .skin b {
      font-size: 12.5px;
      display: block;
      margin: 8px 0 6px
    }

    .skin .btn {
      width: 100%
    }

    /* ============ PRO STATS / AWARDS / MISSIONS ============ */
    .subtabs {
      display: flex;
      gap: 5px;
      background: rgba(8, 4, 18, .65);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 4px;
      margin: 12px 0 14px
    }

    .subtabs button {
      flex: 1;
      padding: 8px 4px;
      border-radius: 10px;
      font-size: 11.5px;
      font-weight: 800;
      color: var(--muted);
      transition: all .18s
    }

    .subtabs button.active {
      background: var(--grad-primary);
      color: #fff
    }

    .profile-box {
      display: flex;
      align-items: center;
      gap: 12px
    }

    .avatar-btn {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      background: var(--grad-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      flex: none;
      box-shadow: 0 6px 18px rgba(124, 77, 255, .35)
    }

    .name-input {
      width: 100%;
      background: rgba(8, 4, 18, .65);
      border: 1px solid var(--line2);
      border-radius: 10px;
      padding: 8px 11px;
      color: var(--text);
      font-weight: 700;
      font-size: 14px;
      margin-top: 4px
    }

    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-bottom: 13px
    }

    .sg-tile {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 15px;
      padding: 12px
    }

    .sg-tile b {
      font-family: var(--font-d);
      font-weight: 800;
      font-size: 18px;
      display: block;
      background: var(--grad-cyan);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent
    }

    .sg-tile:nth-child(2n) b {
      background: var(--grad-hot);
      -webkit-background-clip: text;
      background-clip: text
    }

    .sg-tile span {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .7px;
      color: var(--faint);
      text-transform: uppercase
    }

    .cat-rank-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 9px 0;
      border-bottom: 1px solid rgba(160, 140, 255, .08);
      font-size: 13px
    }

    .cat-rank-row:last-child {
      border-bottom: none
    }

    .cat-rank-row b {
      color: var(--cyan);
      font-size: 12.5px
    }

    .chart-bars {
      display: flex;
      align-items: flex-end;
      gap: 6px;
      height: 96px;
      padding: 8px 4px 2px;
      background: rgba(8, 4, 18, .5);
      border-radius: 12px;
      border: 1px solid var(--line);
      margin-top: 8px
    }

    .cbar-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      height: 100%;
      justify-content: flex-end
    }

    .cbar {
      width: 100%;
      border-radius: 5px 5px 2px 2px;
      background: var(--grad-cyan);
      min-height: 4px;
      transition: height .4s ease
    }

    .cbar-lbl {
      font-size: 9px;
      color: var(--faint);
      font-weight: 700
    }

    .btype-row {
      margin-bottom: 8px
    }

    .btype-head {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      margin-bottom: 4px;
      color: var(--muted)
    }

    .btype-head b {
      color: var(--text)
    }

    .btype-track {
      height: 6px;
      border-radius: 4px;
      background: rgba(8, 4, 18, .7);
      overflow: hidden
    }

    .btype-track i {
      display: block;
      height: 100%;
      border-radius: 4px
    }

    .ach {
      display: flex;
      gap: 11px;
      align-items: center;
      padding: 11px 0;
      border-bottom: 1px solid rgba(160, 140, 255, .08)
    }

    .ach:last-child {
      border: none
    }

    .ach-ic {
      width: 42px;
      height: 42px;
      flex: none;
      border-radius: 12px;
      background: var(--surface2);
      border: 1px solid var(--line2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
      color: var(--faint)
    }

    .ach.done .ach-ic {
      background: var(--grad-primary);
      color: #fff;
      border: none
    }

    .ach.claimed .ach-ic {
      background: rgba(52, 211, 153, .15);
      color: var(--success);
      border-color: rgba(52, 211, 153, .4)
    }

    .ach-info {
      flex: 1;
      min-width: 0
    }

    .ach-info b {
      font-size: 13.5px;
      display: block
    }

    .ach-info p {
      font-size: 11px;
      color: var(--muted)
    }

    .ach-bar {
      height: 5px;
      border-radius: 3px;
      background: rgba(8, 4, 18, .7);
      margin-top: 5px;
      overflow: hidden
    }

    .ach-bar i {
      display: block;
      height: 100%;
      background: var(--grad-cyan);
      border-radius: 3px
    }

    .ach-claim {
      flex: none;
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 11.5px;
      font-weight: 800;
      padding: 7px 10px;
      border-radius: 10px;
      background: rgba(255, 197, 61, .12);
      border: 1px solid rgba(255, 197, 61, .4);
      color: #FFC53D
    }

    .ach-claim.off {
      opacity: .4
    }

    .ach-claimed {
      flex: none;
      color: var(--success);
      font-size: 18px
    }

    /* ============ SETTINGS ============ */
    .seg {
      display: flex;
      background: rgba(8, 4, 18, .6);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 4px;
      gap: 4px
    }

    .seg button {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 9px 4px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 12.5px;
      color: var(--muted);
      transition: all .2s
    }

    .seg button.active {
      background: var(--grad-primary);
      color: #fff
    }

    .seg-desc {
      font-size: 11.5px;
      color: var(--muted);
      margin-top: 8px;
      text-align: center
    }

    .sw-row {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 0;
      border-bottom: 1px solid rgba(160, 140, 255, .08)
    }

    .sw-row:last-child {
      border: none
    }

    .sw-ic {
      width: 36px;
      height: 36px;
      flex: none;
      border-radius: 10px;
      background: var(--surface2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      color: var(--cyan)
    }

    .sw-info {
      flex: 1
    }

    .sw-info b {
      font-size: 13.5px;
      display: block
    }

    .sw-info p {
      font-size: 11px;
      color: var(--muted)
    }

    .sw {
      position: relative;
      width: 46px;
      height: 26px;
      flex: none;
      cursor: pointer
    }

    .sw input {
      position: absolute;
      opacity: 0;
      width: 100%;
      height: 100%;
      cursor: pointer;
      z-index: 1
    }

    .sw i {
      position: absolute;
      inset: 0;
      border-radius: 999px;
      background: var(--surface3);
      border: 1px solid var(--line2);
      transition: all .25s
    }

    .sw i::after {
      content: '';
      position: absolute;
      top: 2.5px;
      left: 3px;
      width: 19px;
      height: 19px;
      border-radius: 50%;
      background: #8D84B5;
      transition: all .25s
    }

    .sw input:checked+i {
      background: var(--grad-cyan);
      border-color: transparent
    }

    .sw input:checked+i::after {
      transform: translateX(19px);
      background: #fff
    }

    .slider-row {
      padding: 10px 0
    }

    .slider-head {
      display: flex;
      justify-content: space-between;
      font-size: 12.5px;
      font-weight: 700;
      margin-bottom: 7px
    }

    .slider-head span:last-child {
      color: var(--cyan);
      font-family: var(--font-d);
      font-size: 12px
    }

    input[type=range] {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 24px;
      background: transparent;
      cursor: pointer
    }

    input[type=range]::-webkit-slider-runnable-track {
      height: 6px;
      border-radius: 3px;
      background: linear-gradient(90deg, #22D3EE, #8B5CF6, #FF3D8A)
    }

    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #fff;
      border: 3px solid var(--violet);
      margin-top: -7px
    }

    .about {
      text-align: center;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6
    }

    .about b {
      font-family: var(--font-d);
      color: var(--text);
      display: block;
      font-size: 14px;
      margin-bottom: 4px
    }

    .about .copy-box {
      margin-top: 10px;
      padding: 10px;
      border-radius: 12px;
      background: rgba(8, 4, 18, .55);
      border: 1px solid rgba(255, 176, 32, .25);
      font-size: 11px;
      color: #E6DCFF
    }

    /* ============ GAME ============ */
    #stageWrap {
      position: relative;
      flex: 1;
      width: 100%;
      min-height: 0;
      overflow: hidden;
      background: #0B0716
    }

    #cv {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      touch-action: none
    }

    #gameOverlayFx {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: repeating-linear-gradient(0deg, rgba(255, 255, 255, .012) 0 1px, transparent 1px 4px), radial-gradient(ellipse at 50% 45%, transparent 55%, rgba(5, 2, 12, .48) 100%)
    }

    #vignette {
      position: absolute;
      inset: 0;
      pointer-events: none;
      transition: box-shadow .4s
    }

    #vignette.danger {
      animation: dangerpulse 1.1s ease-in-out infinite
    }

    @keyframes dangerpulse {
      0%,
      100% {
        box-shadow: inset 0 0 70px rgba(255, 77, 94, .12)
      }
      50% {
        box-shadow: inset 0 0 120px rgba(255, 77, 94, .34)
      }
    }

    #hud {
      position: relative;
      flex: none;
      width: 100%;
      padding: calc(env(safe-area-inset-top, 0px) + 7px) 12px 7px;
      background: linear-gradient(180deg, rgba(14, 9, 28, .98), rgba(11, 7, 22, .92));
      border-bottom: 1px solid var(--line2);
      z-index: 10;
      box-shadow: 0 4px 18px rgba(3, 1, 10, .55)
    }

    .hud-inner {
      max-width: 680px;
      margin: 0 auto
    }

    .hud-top {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 8px;
      align-items: center
    }

    #hud .btn-icon,
    #hud .mute-btn,
    #hud .fs-btn,
    #hud .chip-btn {
      pointer-events: auto
    }

    .hud-left {
      display: flex;
      gap: 6px;
      align-items: center
    }

    .hud-mid {
      text-align: center;
      min-width: 0
    }

    #hudLevel {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.6px;
      color: var(--muted);
      text-transform: uppercase;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis
    }

    #hudScore {
      font-family: var(--font-d);
      font-weight: 900;
      font-size: 23px;
      line-height: 1.08;
      color: #fff;
      text-shadow: 0 0 16px rgba(139, 92, 246, .8)
    }

    body.large-hud #hudLevel {
      font-size: 12px
    }

    body.large-hud #hudScore {
      font-size: 28px
    }

    #hudTimer {
      font-size: 11px;
      font-weight: 800;
      color: var(--amber);
      display: none
    }

    #hudTimer.show {
      display: block
    }

    .hud-right {
      display: flex;
      align-items: center;
      gap: 6px
    }

    .hud-right-row {
      display: flex;
      gap: 5px
    }

    #hud .mute-btn .m-label {
      display: none
    }

    .hud-coins {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 11.5px;
      font-weight: 800;
      color: #FFC53D;
      background: rgba(20, 12, 34, .82);
      border: 1px solid rgba(255, 197, 61, .35);
      padding: 5px 9px;
      border-radius: 999px
    }

    .hud-sub {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 7px;
      margin-top: 5px;
      flex-wrap: wrap;
      min-height: 22px
    }

    .hud-sub-left {
      display: flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap
    }

    #hudLives {
      display: flex;
      gap: 3px;
      font-size: 14px
    }

    #hudLives .ic {
      color: var(--danger)
    }

    #hudLives .ic svg {
      fill: currentColor
    }

    #hudLives .ic.empty {
      color: #3A3160
    }

    #hudLives .ic.empty svg {
      fill: none
    }

    #hudCombo {
      display: none;
      align-items: center;
      gap: 6px;
      background: rgba(255, 61, 138, .14);
      border: 1px solid rgba(255, 61, 138, .5);
      border-radius: 999px;
      padding: 2px 9px;
      font-family: var(--font-d);
      font-weight: 800;
      font-size: 11.5px;
      color: var(--magenta);
      position: relative;
      overflow: hidden
    }

    #hudCombo.show {
      display: inline-flex
    }

    #comboBar {
      position: absolute;
      left: 0;
      bottom: 0;
      height: 2.5px;
      background: var(--magenta)
    }

    #hudFx {
      display: flex;
      gap: 4px;
      flex-wrap: wrap
    }

    .fx-chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 999px;
      background: rgba(20, 12, 34, .85);
      border: 1px solid var(--fc, #22D3EE);
      color: var(--fc, #22D3EE);
      position: relative;
      overflow: hidden
    }

    .fx-chip .fx-bar {
      position: absolute;
      left: 0;
      bottom: 0;
      height: 2.5px;
      background: var(--fc)
    }

    #boostBar {
      display: none;
      margin-top: 5px;
      padding-top: 5px;
      border-top: 1px solid rgba(160, 140, 255, .1);
      pointer-events: auto
    }

    #boostBar.show {
      display: flex;
      align-items: center;
      gap: 7px
    }

    #boostBar .bb-label {
      font-size: 8.5px;
      font-weight: 800;
      letter-spacing: 1.2px;
      color: var(--faint);
      white-space: nowrap;
      flex: none
    }

    #boostBar .bb-row {
      display: flex;
      gap: 5px;
      overflow-x: auto;
      flex: 1;
      scrollbar-width: none
    }

    #boostBar .bb-row::-webkit-scrollbar {
      display: none
    }

    .chip-btn {
      flex: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10.5px;
      font-weight: 800;
      padding: 4px 8px;
      border-radius: 999px;
      background: rgba(29, 20, 52, .9);
      border: 1px solid var(--line2);
      color: var(--text)
    }

    .chip-btn:active {
      transform: scale(.94)
    }

    .chip-btn.armed {
      color: #0B0716;
      background: var(--grad-acid);
      border-color: transparent
    }

    #fpsBadge {
      position: absolute;
      top: 8px;
      right: 10px;
      background: rgba(11, 7, 22, .78);
      border: 1px solid var(--line2);
      color: var(--lime);
      font-family: monospace;
      font-size: 10.5px;
      font-weight: 700;
      padding: 3px 7px;
      border-radius: 7px;
      pointer-events: none;
      z-index: 12;
      display: none
    }

    #fpsBadge.show {
      display: block
    }

    #gameHint {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
      background: rgba(16, 10, 32, .88);
      border: 1px solid var(--line2);
      color: var(--text);
      font-size: 11.5px;
      font-weight: 600;
      padding: 5px 14px;
      border-radius: 999px;
      pointer-events: none;
      white-space: nowrap;
      transition: opacity .35s;
      z-index: 10;
      box-shadow: 0 4px 16px rgba(0, 0, 0, .5)
    }

    #gameHint.hide {
      opacity: 0
    }

    /* ============ SHEETS ============ */
    #sheetRoot {
      position: absolute;
      inset: 0;
      z-index: 70;
      pointer-events: none
    }

    .backdrop {
      position: absolute;
      inset: 0;
      background: rgba(5, 3, 12, .68);
      backdrop-filter: blur(7px);
      -webkit-backdrop-filter: blur(7px);
      opacity: 0;
      transition: opacity .25s;
      pointer-events: auto
    }

    .sheet {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      max-height: 88%;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: linear-gradient(180deg, #221741 0%, #150E29 100%);
      border: 1px solid var(--line2);
      border-bottom: none;
      border-radius: 26px 26px 0 0;
      padding: 10px 18px calc(env(safe-area-inset-bottom, 0px) + 20px);
      transform: translateY(105%);
      transition: transform .32s cubic-bezier(.32, 1.15, .4, 1);
      pointer-events: auto;
      box-shadow: 0 -18px 60px rgba(3, 1, 10, .7)
    }

    #sheetRoot.open .backdrop {
      opacity: 1
    }

    #sheetRoot.open .sheet {
      transform: none
    }

    #sheetRoot.closing .backdrop {
      opacity: 0
    }

    #sheetRoot.closing .sheet {
      transform: translateY(105%);
      transition: transform .22s ease-in
    }

    .grabber {
      width: 40px;
      height: 4px;
      border-radius: 3px;
      background: var(--line2);
      margin: 2px auto 12px
    }

    .sheet-kicker {
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: 2.2px;
      text-transform: uppercase
    }

    .sheet-title {
      font-size: 23px;
      font-weight: 800;
      letter-spacing: -.3px;
      margin-top: 3px
    }

    .sheet-head {
      margin-bottom: 13px
    }

    .tag-best {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: 1px;
      color: var(--lime);
      border: 1px solid rgba(163, 230, 53, .5);
      background: rgba(163, 230, 53, .1);
      padding: 4px 10px;
      border-radius: 999px;
      margin-top: 7px
    }

    .stars-row {
      display: flex;
      justify-content: center;
      gap: 14px;
      margin: 6px 0 16px
    }

    .big-star {
      font-size: 42px;
      color: #332A5C
    }

    .big-star.earned {
      color: var(--amber);
      filter: drop-shadow(0 0 14px rgba(255, 176, 32, .8))
    }

    .big-star.earned svg {
      fill: currentColor
    }

    .res-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 13px
    }

    .res {
      background: rgba(8, 4, 18, .5);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 9px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center
    }

    .res span {
      font-size: 11.5px;
      color: var(--muted);
      font-weight: 600
    }

    .res b {
      font-family: var(--font-d);
      font-size: 13.5px;
      font-weight: 800
    }

    .coin-lines {
      background: rgba(8, 4, 18, .5);
      border: 1px solid rgba(255, 197, 61, .25);
      border-radius: 14px;
      padding: 11px 14px;
      margin-bottom: 16px
    }

    .coin-lines>div {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12.5px;
      padding: 3.5px 0;
      color: var(--muted)
    }

    .coin-lines>div span {
      display: flex;
      align-items: center;
      gap: 6px
    }

    .coin-lines>div .ic {
      color: #FFC53D;
      font-size: 14px
    }

    .coin-lines>div b {
      color: #FFC53D;
      font-weight: 800
    }

    .coin-lines .total {
      border-top: 1px solid rgba(255, 197, 61, .2);
      margin-top: 5px;
      padding-top: 8px;
      color: var(--text);
      font-weight: 700
    }

    .coin-lines .total b {
      font-family: var(--font-d);
      font-size: 18px
    }

    .sheet-btns {
      display: flex;
      flex-direction: column;
      gap: 9px
    }

    .quick-rows {
      margin-bottom: 14px;
      background: rgba(8, 4, 18, .4);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 2px 13px
    }

    .pause-note {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 14px
    }

    .lose-tip {
      display: flex;
      gap: 8px;
      font-size: 12px;
      color: var(--muted);
      background: rgba(56, 189, 248, .07);
      border: 1px solid rgba(56, 189, 248, .25);
      border-radius: 12px;
      padding: 10px 12px;
      margin-bottom: 14px
    }

    .lose-tip .ic {
      color: var(--info);
      font-size: 15px;
      flex: none;
      margin-top: 1px
    }

    .help-steps {
      display: flex;
      flex-direction: column;
      gap: 9px;
      margin-bottom: 14px
    }

    .hstep {
      display: flex;
      gap: 11px;
      align-items: center;
      background: rgba(8, 4, 18, .4);
      border: 1px solid var(--line);
      border-radius: 13px;
      padding: 10px 12px
    }

    .hstep .hs-ic {
      width: 38px;
      height: 38px;
      flex: none;
      border-radius: 11px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      color: #0B0716
    }

    .hstep b {
      font-size: 13.5px;
      display: block
    }

    .hstep p {
      font-size: 11.5px;
      color: var(--muted)
    }

    .legend {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;
      margin-bottom: 13px
    }

    .leg-item {
      display: flex;
      gap: 8px;
      align-items: center;
      background: rgba(8, 4, 18, .4);
      border: 1px solid var(--line);
      border-radius: 11px;
      padding: 7px 9px
    }

    .leg-ic {
      width: 28px;
      height: 28px;
      flex: none;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      color: #0B0716
    }

    .leg-item b {
      font-size: 11px;
      display: block;
      line-height: 1.2
    }

    .leg-item p {
      font-size: 9.5px;
      color: var(--muted);
      line-height: 1.2
    }

    .hazard-note {
      display: flex;
      gap: 8px;
      align-items: center;
      font-size: 11.5px;
      color: var(--warning);
      background: rgba(255, 176, 32, .08);
      border: 1px solid rgba(255, 176, 32, .3);
      border-radius: 11px;
      padding: 9px 11px;
      margin-bottom: 14px
    }

    .confirm-ic {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      background: rgba(255, 77, 94, .12);
      border: 1px solid rgba(255, 77, 94, .4);
      color: var(--danger);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin: 0 auto 12px
    }

    .confirm-text {
      text-align: center;
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 18px
    }

    /* ============ TOASTS ============ */
    #toastRoot {
      position: absolute;
      top: calc(var(--hdr-h) + 6px);
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
      z-index: 90;
      pointer-events: none
    }

    #app.in-game #toastRoot {
      top: calc(env(safe-area-inset-top, 0px) + 115px)
    }

    .toast {
      display: flex;
      align-items: center;
      gap: 7px;
      background: rgba(26, 17, 48, .96);
      border: 1px solid var(--line2);
      border-radius: 999px;
      padding: 8px 15px;
      font-size: 12.5px;
      font-weight: 700;
      box-shadow: 0 8px 30px rgba(3, 1, 10, .6);
      opacity: 0;
      transform: translateY(-12px) scale(.9);
      transition: all .28s ease;
      max-width: 90%
    }

    .toast.show {
      opacity: 1;
      transform: none
    }

    .toast.hide {
      opacity: 0;
      transform: translateY(-8px) scale(.94)
    }

    .toast .ic {
      font-size: 15px;
      flex: none
    }

    .toast.good .ic {
      color: var(--success)
    }

    .toast.warn .ic {
      color: var(--warning)
    }

    .toast.bad .ic {
      color: var(--danger)
    }

    .toast.info .ic {
      color: var(--cyan)
    }

    .toast.gold .ic {
      color: #FFC53D
    }

    @media(max-width:360px) {
      .rank-pill-hdr {
        display: none
      }

      .hero-num {
        font-size: 32px
      }

      .hero-prev {
        width: 88px;
        height: 60px
      }
    }
  </style>
</head>

<body>

  <div id="bg" aria-hidden="true">
    <div class="aur a1"></div>
    <div class="aur a2"></div>
    <div class="aur a3"></div>
    <div class="fbrick"
      style="width:70px;height:30px;left:8%;top:16%;background:linear-gradient(135deg,#22D3EE,#8B5CF6);animation-delay:-2s">
    </div>
    <div class="fbrick"
      style="width:52px;height:22px;left:14%;top:70%;background:linear-gradient(135deg,#FF3D8A,#FFB020);animation-delay:-6s">
    </div>
    <div class="fbrick"
      style="width:60px;height:26px;right:10%;top:24%;background:linear-gradient(135deg,#A3E635,#22D3EE);animation-delay:-9s">
    </div>
    <div class="fbrick"
      style="width:44px;height:20px;right:16%;top:78%;background:linear-gradient(135deg,#8B5CF6,#FF3D8A);animation-delay:-4s">
    </div>
  </div>

  <div class="side side-l" aria-hidden="true">
    <div class="side-logo">BRICK<b>POP</b></div>
    <p class="side-tag">Nova Ultimate Edition — Unlimited levels, dynamic ranks, 4 arcade modes, bosses, missions &amp;
      pro stats. 100% offline.</p>
    <p class="side-ded">Dedicated to my little Muhib Ullah</p>
    <div class="side-chips">
      <span class="side-chip">UNLIMITED LEVELS</span><span class="side-chip m">UNLIMITED RANKS</span>
      <span class="side-chip l">4 MODES</span><span class="side-chip g">PRO STATS</span>
    </div>
  </div>

  <div class="side side-r" aria-hidden="true">
    <div class="keys-card">
      <h4>CONTROLS</h4>
      <div class="key-row"><span>Move paddle</span><span><kbd>←</kbd> <kbd>→</kbd> / Mouse</span></div>
      <div class="key-row"><span>Launch ball</span><kbd>SPACE</kbd></div>
      <div class="key-row"><span>Use booster</span><span><kbd>1</kbd>–<kbd>5</kbd></span></div>
      <div class="key-row"><span>Pause</span><kbd>P</kbd></div>
      <div class="key-row"><span>Restart</span><kbd>R</kbd></div>
      <div class="key-row"><span>Fullscreen</span><kbd>F</kbd></div>
      <div class="key-row"><span>Mute all</span><kbd>M</kbd></div>
    </div>
    <p class="side-copy">&copy; 2026 <b>Yasin Ullah</b> (Bannu Software Solutions). All rights reserved. Copying or
      reuse prohibited without author attribution.</p>
  </div>

  <div id="app">
    <header id="hdr">
      <div class="logo"><span class="l1">BRICK</span><span class="dia"></span><span class="l2">POP</span></div>
      <div class="sp"></div>
      <button class="rank-pill-hdr" id="hdrRank" data-action="tab" data-arg="awards" title="View Rank & Stats">Novice
        I</button>
      <button class="coins-chip" data-action="tab" data-arg="shop" aria-label="Open shop"><span class="ic"
          data-ic="coin"></span><span id="coinVal">0</span></button>
      <button class="fs-btn" data-action="fullscreen" aria-label="Toggle Fullscreen" title="Fullscreen (F)"><span
          class="ic" data-ic="maximize"></span></button>
      <button class="mute-btn" data-action="mute" aria-label="Toggle sound"></button>
    </header>

    <main id="screens">
      <section class="screen" id="screen-home" aria-label="Home"></section>
      <section class="screen" id="screen-levels" aria-label="Levels"></section>
      <section class="screen" id="screen-shop" aria-label="Shop"></section>
      <section class="screen" id="screen-awards" aria-label="Stats and Awards"></section>
      <section class="screen" id="screen-settings" aria-label="Settings"></section>
      <section class="screen" id="screen-game" aria-label="Game">
        <div id="hud">
          <div class="hud-inner">
            <div class="hud-top">
              <div class="hud-left">
                <button class="btn-icon" data-action="pause" aria-label="Pause" title="Pause (P)"><span class="ic" data-ic="pause"></span></button>
                <button class="btn-icon" data-action="fullscreen" aria-label="Fullscreen" title="Fullscreen (F)"><span class="ic" data-ic="maximize"></span></button>
              </div>
              <div class="hud-mid">
                <div id="hudLevel">LEVEL 1-1</div>
                <div id="hudScore">0</div>
                <div id="hudTimer">2:30</div>
              </div>
              <div class="hud-right">
                <div class="hud-coins"><span class="ic" data-ic="coin"></span><span id="hudCoinsVal">0</span></div>
                <div class="hud-right-row">
                  <button class="mute-btn" data-action="mute" aria-label="Toggle sound"></button>
                </div>
              </div>
            </div>
            <div class="hud-sub">
              <div class="hud-sub-left">
                <div id="hudLives"></div>
                <div id="hudCombo"><span id="comboMult">×2</span><i id="comboBar"></i></div>
              </div>
              <div id="hudFx"></div>
            </div>
            <div id="boostBar">
              <div class="bb-label" id="boostBarLabel">BOOST (1-5)</div>
              <div class="bb-row" id="boostRow"></div>
            </div>
          </div>
        </div>
        <div id="stageWrap">
          <canvas id="cv"></canvas>
          <div id="gameOverlayFx"></div>
          <div id="vignette"></div>
          <div id="fpsBadge">60 FPS</div>
          <div id="gameHint">Drag to move · Tap to launch</div>
        </div>
      </section>
    </main>

    <nav id="tabbar" aria-label="Navigation">
      <button class="tab" data-action="tab" data-arg="home"><span class="ic" data-ic="home"></span>Home</button>
      <button class="tab" data-action="tab" data-arg="levels"><span class="ic" data-ic="grid"></span>Levels</button>
      <button class="tab" data-action="tab" data-arg="shop"><span class="ic" data-ic="bag"></span>Shop</button>
      <button class="tab" data-action="tab" data-arg="awards"><span class="ic" data-ic="trophy"></span>Stats<span
          class="badge" id="badgeAwards" hidden>0</span></button>
      <button class="tab" data-action="tab" data-arg="settings"><span class="ic"
          data-ic="sliders"></span>Settings</button>
    </nav>

    <div id="sheetRoot"></div>
    <div id="toastRoot"></div>
  </div>

  <script>
    'use strict';
    /* ============================================================================
       BRICKPOP NOVA ULTIMATE — Unified V3 Engine + V1/V2 Features + Unlimited
       Levels, Unlimited Ranks & Full Pro Statistics System.
       Copyright (c) 2026 Yasin Ullah — Bannu Software Solutions.
       Dedicated to little Muhib Ullah.
       ============================================================================ */

    /* ---------- utils ---------- */
    const $ = s => document.querySelector(s), $$ = s => Array.from(document.querySelectorAll(s));
    const clamp = (v, a, b) => v < a ? a : v > b ? b : v, lerp = (a, b, t) => a + (b - a) * t;
    const fmt = n => Math.round(n || 0).toLocaleString('en-US');
    const R = Math.random;
    function todayStr() { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0') }
    function mulberry32(a) { return function () { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296 } }
    function shade(hex, p) { const n = parseInt(hex.slice(1), 16); let r = n >> 16 & 255, g = n >> 8 & 255, b = n & 255; const t = p < 0 ? 0 : 255, q = Math.abs(p) / 100; r = Math.round(lerp(r, t, q)); g = Math.round(lerp(g, t, q)); b = Math.round(lerp(b, t, q)); return `rgb(${r},${g},${b})` }
    function rgba(hex, a) { const n = parseInt(hex.slice(1), 16); return `rgba(${n >> 16 & 255},${n >> 8 & 255},${n & 255},${a})` }
    function fmtTime(s) { s = Math.max(0, Math.floor(s || 0)); const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sc = s % 60; return h > 0 ? (h + 'h ' + m + 'm') : (m + ':' + String(sc).padStart(2, '0')) }
    function rr(c, x, y, w, h, r) { r = Math.min(r, w / 2, h / 2); c.beginPath(); c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r); c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r); c.closePath() }
    const RM_SYS = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------- icons ---------- */
    const I = {
      home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/>',
      grid: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>',
      bag: '<path d="M6 7h12l1.2 14H4.8L6 7Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>',
      trophy: '<path d="M8 21h8"/><path d="M12 17v4"/><path d="M7 4h10v6a5 5 0 0 1-10 0V4Z"/><path d="M7 6H4a3 3 0 0 0 3 5"/><path d="M17 6h3a3 3 0 0 1-3 5"/>',
      sliders: '<path d="M4 6h9M19 6h1M4 12h1M11 12h9M4 18h9M19 18h1"/><circle cx="16" cy="6" r="2.4"/><circle cx="8" cy="12" r="2.4"/><circle cx="16" cy="18" r="2.4"/>',
      play: '<path d="M7 4.5v15l13-7.5L7 4.5Z" fill="currentColor" stroke="none"/>',
      pause: '<rect x="6" y="4" width="4.5" height="16" rx="1.5" fill="currentColor" stroke="none"/><rect x="13.5" y="4" width="4.5" height="16" rx="1.5" fill="currentColor" stroke="none"/>',
      restart: '<path d="M3.5 12a8.5 8.5 0 1 0 2.8-6.3"/><path d="M3.5 4v5h5"/>',
      heart: '<path d="M12 20.5C7 16.5 3 13.3 3 9.3 3 6.4 5.2 4.5 7.8 4.5c1.7 0 3.2.9 4.2 2.3 1-1.4 2.5-2.3 4.2-2.3 2.6 0 4.8 1.9 4.8 4.8 0 4-4 7.2-9 11.2Z"/>',
      coin: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.2"/>',
      star: '<path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6L3.2 9.4l6.1-.8L12 3Z"/>',
      lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
      vol: '<path d="M4 9v6h4l5 4V5L8 9H4Z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/>',
      volx: '<path d="M4 9v6h4l5 4V5L8 9H4Z"/><path d="m17 9 5 5M22 9l-5 5"/>',
      x: '<path d="M6 6l12 12M18 6 6 18"/>',
      check: '<path d="m4.5 12.5 5 5 10-11"/>',
      zap: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/>',
      flame: '<path d="M12 22c4 0 6.5-2.6 6.5-6.2 0-2.8-1.7-4.6-3.2-6.3C13.9 7.9 13 6 13 3c-3.5 2.2-5 5-5 7.5-.8-.6-1.4-1.4-1.7-2.5C5 9.6 5.5 12 5.5 15.8 5.5 19.4 8 22 12 22Z"/>',
      leaf: '<path d="M4 20C4 10 10 4 20 4c0 10-6 16-16 16Z"/><path d="M4 20c4-6 8-10 12-12"/>',
      timer: '<circle cx="12" cy="13" r="8"/><path d="M12 9.5v3.5l2.5 2.5M9 2h6"/>',
      wide: '<path d="m7 8-4 4 4 4M17 8l4 4-4 4M3 12h18"/>',
      shrink: '<path d="M9 3v6H3M15 3v6h6M9 21v-6H3M15 21v-6h6"/>',
      multi: '<circle cx="12" cy="7" r="3"/><circle cx="7" cy="16" r="3"/><circle cx="17" cy="16" r="3"/>',
      magnet: '<path d="M5 4h5v7a2 2 0 0 0 4 0V4h5v7a7 7 0 0 1-14 0V4Z"/><path d="M5 8h5M14 8h5"/>',
      shield: '<path d="M12 2 4 5.5V11c0 5 3.2 8.6 8 10.5 4.8-1.9 8-5.5 8-10.5V5.5L12 2Z"/>',
      target: '<circle cx="12" cy="12" r="7"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
      gift: '<rect x="3" y="7" width="18" height="4"/><path d="M5 11v9h14v-9M12 7v13"/><path d="M12 7c-4 0-5.3-3.6-3-4.5C11 1.8 12 5 12 7Zm0 0c4 0 5.3-3.6 3-4.5C13 1.8 12 5 12 7Z"/>',
      calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
      sparkles: '<path d="m12 3 1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3Z"/><path d="m19 15 .9 2.3 2.3.9-2.3.9-.9 2.4-.9-2.4-2.3-.9 2.3-.9L19 15Z"/>',
      infinity: '<path d="M6.5 9C4 9 3 10.5 3 12s1 3 3.5 3c3.5 0 7.5-6 11-6C20 9 21 10.5 21 12s-1 3-3.5 3c-3.5 0-7.5-6-11-6Z"/>',
      info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5h.01"/>',
      trash: '<path d="M4 7h16M9 7V4h6v3M6 7l1 14h10l1-14"/><path d="M10 11v6M14 11v6"/>',
      alert: '<path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4M12 17h.01"/>',
      music: '<path d="M9 18V5l10-2v13"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>',
      vibrate: '<rect x="8" y="4" width="8" height="16" rx="2"/><path d="M4 8v8M2 10v4M20 8v8M22 10v4"/>',
      wand: '<path d="M15 4V2M15 10V8M11.5 6h-2M20.5 6h-2M17.8 3.2l1.4-1.4M17.8 8.8l1.4 1.4"/><path d="m14 8-11 11 2 2 11-11-2-2Z"/>',
      crown: '<path d="m3 7 4.5 4L12 5l4.5 6L21 7l-1.5 12h-15L3 7Z"/>',
      trend: '<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
      gauge: '<path d="m12 15 4-6"/><path d="M4 19a10 10 0 1 1 16 0"/>',
      move: '<path d="M12 2v20M2 12h20"/><path d="m9 5 3-3 3 3M9 19l3 3 3-3M5 9l-3 3 3 3M19 9l3 3-3 3"/>',
      maximize: '<path d="M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5"/>',
      eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>'
    };
    function icon(n) { return '<span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + (I[n] || I.zap) + '</svg></span>' }
    $$('[data-ic]').forEach(el => { el.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + (I[el.dataset.ic] || I.zap) + '</svg>' });

    /* ---------- WORLDS, RANKS, MODES, ITEMS ---------- */
    const WORLDS = [
      { name: 'Neon District', tag: 'Where the grid glows', hues: ['#22D3EE', '#8B5CF6', '#FF3D8A', '#38BDF8'], bg: ['#130A2E', '#0B0716'], glow: ['#7C4DFF', '#22D3EE'] },
      { name: 'Sunset Strip', tag: 'Chrome under a burning sky', hues: ['#FFB020', '#FF6B35', '#FF3D8A', '#FFD166'], bg: ['#2B0F1E', '#12060F'], glow: ['#FF6B35', '#FF3D8A'] },
      { name: 'Acid Garden', tag: 'Everything here bites back', hues: ['#A3E635', '#34D399', '#22D3EE', '#BEF264'], bg: ['#0A1F14', '#071009'], glow: ['#34D399', '#A3E635'] },
      { name: 'Cryo Caverns', tag: 'The wall starts to move', hues: ['#7DD3FC', '#38BDF8', '#A5F3FC', '#818CF8'], bg: ['#0A1630', '#060B1A'], glow: ['#38BDF8', '#818CF8'] },
      { name: 'Magma Core', tag: 'Beware the red capsules', hues: ['#FF4D5E', '#FF8A3D', '#FFB020', '#FF6B6B'], bg: ['#26060B', '#120406'], glow: ['#FF4D5E', '#FF8A3D'] },
      { name: 'Violet Void', tag: 'Deep space, deep combos', hues: ['#A78BFA', '#C084FC', '#F0ABFC', '#8B5CF6'], bg: ['#1A0B33', '#0D0620'], glow: ['#C084FC', '#8B5CF6'] },
      { name: 'Gilded Sky', tag: 'Fortune favors the flawless', hues: ['#FFC53D', '#F59E0B', '#FDE68A', '#D97706'], bg: ['#241505', '#120A03'], glow: ['#FFC53D', '#F59E0B'] },
      { name: 'Prism Storm', tag: 'The final spectrum', hues: ['#FF3D8A', '#22D3EE', '#A3E635', '#FFB020'], bg: ['#160A2E', '#0A0618'], glow: ['#FF3D8A', '#22D3EE'] }
    ];

    /* Unlimited Rank System: 9 Tiers x 3 Divisions = 27 Core Ranks + Infinite Overlord Prestige 1..∞ */
    const RANK_TIERS = [
      { name: 'Novice', icon: '🌱', color: '#94A3B8' },
      { name: 'Bronze Breaker', icon: '🥉', color: '#CD7F32' },
      { name: 'Silver Striker', icon: '🥈', color: '#CBD5E1' },
      { name: 'Gold Smasher', icon: '🥇', color: '#FFD166' },
      { name: 'Platinum Crusher', icon: '💠', color: '#38BDF8' },
      { name: 'Diamond Blaster', icon: '💎', color: '#22D3EE' },
      { name: 'Master Architect', icon: '⚡', color: '#A78BFA' },
      { name: 'Grandmaster Nova', icon: '🔥', color: '#FF6B35' },
      { name: 'Mythic Legend', icon: '👑', color: '#FF3D8A' }
    ];
    const ROMAN = ['I', 'II', 'III'];
    function rankForXP(xp) {
      // Exponentially harder XP thresholds: rank n requires cumulative sum of 250 * n^1.35
      let level = 1, needed = 250, spent = 0;
      while (xp >= spent + needed) { spent += needed; level++; needed = Math.round(250 * Math.pow(level, 1.35)) }
      const curXP = xp - spent, pct = clamp(curXP / needed * 100, 0, 100);
      if (level <= 27) {
        const ti = Math.floor((level - 1) / 3), div = (level - 1) % 3, t = RANK_TIERS[ti];
        return { level, title: t.name + ' ' + ROMAN[div], icon: t.icon, color: t.color, curXP, needed, pct, prestige: 0 };
      }
      const p = level - 27;
      return { level, title: 'Infinite Overlord P' + p, icon: '🌌', color: '#FFC53D', curXP, needed, pct, prestige: p };
    }
    function categoryRank(val, steps, labels) {
      let idx = 0; for (let i = 0; i < steps.length; i++)if (val >= steps[i]) idx = i + 1;
      if (idx < labels.length) return labels[idx];
      return 'Apex Tier +' + (idx - labels.length + 1);
    }

    const AVATARS = ['😎', '🚀', '⚡', '🔥', '👑', '🎮', '💎', '🦁', '🌟', '🤖'];
    const DIFFS = {
      chill: { label: 'Chill', icon: 'leaf', lives: 5, speed: 300, paddle: 108, desc: 'Relaxed speed · 5 lives · wide paddle' },
      classic: { label: 'Classic', icon: 'zap', lives: 3, speed: 360, paddle: 94, desc: 'Arcade standard · 3 lives · balanced' },
      frantic: { label: 'Frantic', icon: 'flame', lives: 2, speed: 432, paddle: 84, desc: 'Fast balls · 2 lives · narrow paddle' }
    };
    const SKINS = [
      { id: 'classic', name: 'Neon Pulse', price: 0, c: ['#22D3EE', '#8B5CF6', '#FF3D8A'] },
      { id: 'sunset', name: 'Sunset Rush', price: 250, c: ['#FFB020', '#FF6B35', '#FF3D8A'] },
      { id: 'toxic', name: 'Acid Surge', price: 400, c: ['#A3E635', '#34D399', '#22D3EE'] },
      { id: 'royal', name: 'Royal Storm', price: 600, c: ['#8B5CF6', '#38BDF8', '#FF3D8A'] },
      { id: 'nova', name: 'Muhib Gold', price: 900, c: ['#FFD166', '#FF8A3D', '#22D3EE'] }
    ];
    const BOOSTERS = [
      { id: 'heart', name: 'Extra Heart', desc: '+1 life immediately or at launch', price: 150, icon: 'heart', color: '#FF4D5E' },
      { id: 'wide', name: 'Wide Paddle', desc: 'Wide paddle for 14s', price: 120, icon: 'wide', color: '#22D3EE' },
      { id: 'multi', name: 'Triple Ball', desc: 'Split into 3 balls', price: 200, icon: 'multi', color: '#A3E635' },
      { id: 'slow', name: 'Slow-Mo', desc: 'Slow balls for 10s', price: 100, icon: 'timer', color: '#38BDF8' },
      { id: 'shield', name: 'Safety Shield', desc: 'Adds 2 floor rescue charges', price: 180, icon: 'shield', color: '#8B5CF6' },
      { id: 'laser', name: 'Twin Lasers', desc: 'Auto-fire twin lasers for 12s', price: 170, icon: 'target', color: '#FF3D8A' },
      { id: 'fire', name: 'Fireball', desc: 'Piercing blazing ball for 10s', price: 190, icon: 'flame', color: '#FF8A3D' }
    ];
    const POWERS = {
      wide: { name: 'Wide Paddle', icon: 'wide', color: '#22D3EE', dur: 14, desc: 'Paddle grows +45%' },
      multi: { name: 'Multiball', icon: 'multi', color: '#A3E635', dur: 0, desc: 'Splits every ball' },
      slow: { name: 'Slow-Mo', icon: 'timer', color: '#38BDF8', dur: 10, desc: 'Balls slow down' },
      laser: { name: 'Twin Lasers', icon: 'target', color: '#FF3D8A', dur: 11, desc: 'Paddle auto-fires' },
      fire: { name: 'Fireball', icon: 'flame', color: '#FF8A3D', dur: 9, desc: 'Pierces all bricks' },
      magnet: { name: 'Magnet / Sticky', icon: 'magnet', color: '#C084FC', dur: 12, desc: 'Catch & aim balls' },
      shield: { name: 'Safety Shield', icon: 'shield', color: '#8B5CF6', dur: 0, desc: '+2 floor rescues' },
      life: { name: 'Extra Life', icon: 'heart', color: '#FF4D5E', dur: 0, desc: '+1 heart' },
      coin: { name: 'Coin Rush', icon: 'coin', color: '#FFC53D', dur: 0, desc: '+25 coins' },
      fast: { name: 'Overdrive', icon: 'gauge', color: '#FFB020', dur: 6, desc: 'TRAP — balls speed up', bad: true },
      shrink: { name: 'Shrink', icon: 'shrink', color: '#FF4D5E', dur: 8, desc: 'TRAP — paddle shrinks', bad: true }
    };
    const DAILY_MISSIONS = [
      { id: 'bricks', name: 'Brick Demolisher', desc: 'Break 90 bricks in any mode today', icon: 'zap', target: 90, reward: 130, xp: 120 },
      { id: 'powers', name: 'Power Collector', desc: 'Catch or use 6 power-ups today', icon: 'gift', target: 6, reward: 115, xp: 100 },
      { id: 'wins', name: 'Victory Lap', desc: 'Clear 3 levels or waves today', icon: 'trophy', target: 3, reward: 180, xp: 160 }
    ];
    const TIPS = [
      'Aim near the paddle edges for sharp diagonal shots into the upper corners.',
      'Keep the ball above the bricks to chain huge combo multipliers up to x8.',
      'Fireball pierces straight through armored bricks and even indestructible steel!',
      'Red-ringed capsules are traps (Overdrive & Shrink) — dodge them!',
      'Press keys 1–5 mid-game (or tap the booster pills) to trigger boosters anytime.',
      'Every 15th level features a Boss Formation with high-HP Core Bricks and bonus XP.',
      'Campaign levels never end — conquer Sector II, III, and beyond for massive ranks!',
      'Complete Daily Missions and the Daily Challenge every day to grow your streak.'
    ];
    const ACHS = [
      { id: 'pop1', name: 'First Pop', desc: 'Break your first brick', icon: 'zap', reward: 25, max: 1, cur: s => s.stats.bricks },
      { id: 'pop100', name: 'Brick Starter', desc: 'Break 100 bricks', icon: 'zap', reward: 50, max: 100, cur: s => s.stats.bricks },
      { id: 'pop1k', name: 'Brick Breaker', desc: 'Break 1,000 bricks', icon: 'flame', reward: 120, max: 1000, cur: s => s.stats.bricks },
      { id: 'pop5k', name: 'Brick Master', desc: 'Break 5,000 bricks', icon: 'crown', reward: 300, max: 5000, cur: s => s.stats.bricks },
      { id: 'combo10', name: 'Combo Rookie', desc: 'Reach a 10x combo', icon: 'sparkles', reward: 50, max: 10, cur: s => s.stats.bestCombo },
      { id: 'combo25', name: 'Combo Pro', desc: 'Reach a 25x combo', icon: 'wand', reward: 120, max: 25, cur: s => s.stats.bestCombo },
      { id: 'combo50', name: 'Combo Legend', desc: 'Reach a 50x combo', icon: 'flame', reward: 250, max: 50, cur: s => s.stats.bestCombo },
      { id: 'pow10', name: 'Power Up', desc: 'Collect 10 power-ups', icon: 'gift', reward: 40, max: 10, cur: s => s.stats.powers },
      { id: 'pow100', name: 'Power Collector', desc: 'Collect 100 power-ups', icon: 'gift', reward: 180, max: 100, cur: s => s.stats.powers },
      { id: 'lvl10', name: 'Getting Started', desc: 'Clear 10 campaign levels', icon: 'grid', reward: 80, max: 10, cur: s => clearedCount() },
      { id: 'lvl60', name: 'Space Navigator', desc: 'Clear 60 campaign levels', icon: 'gauge', reward: 220, max: 60, cur: s => clearedCount() },
      { id: 'lvl120', name: 'Sector Conqueror', desc: 'Clear 120 campaign levels', icon: 'trophy', reward: 500, max: 120, cur: s => clearedCount() },
      { id: 'perf10', name: 'Perfectionist', desc: 'Earn 3 stars on 10 levels', icon: 'star', reward: 160, max: 10, cur: s => threeStars() },
      { id: 'score8k', name: 'High Flyer', desc: 'Score 8,000 in one run', icon: 'trend', reward: 170, max: 8000, cur: s => s.stats.bestScore },
      { id: 'end10', name: 'Wave Rider', desc: 'Reach wave 10 in Endless', icon: 'infinity', reward: 180, max: 10, cur: s => s.stats.endlessWave },
      { id: 'boss5', name: 'Boss Slayer', desc: 'Defeat 5 boss levels', icon: 'crown', reward: 200, max: 5, cur: s => s.stats.bossesDefeated },
      { id: 'daily1', name: 'Daily Hero', desc: 'Complete a Daily Challenge', icon: 'calendar', reward: 125, max: 1, cur: s => s.stats.dailyWins },
      { id: 'time60', name: 'Marathon Player', desc: 'Play for 60 minutes total', icon: 'timer', reward: 200, max: 3600, cur: s => s.stats.playtime }
    ];

    /* ---------- SAVE & PERSISTENCE ---------- */
    const SAVE_KEY = 'brickpop_nova_ultimate_v4';
    function freshDaily() { return { date: todayStr(), bricks: 0, powers: 0, wins: 0, claims: [], rewardClaimed: false, challengeDone: false } }
    function freshSet() {
      return {
        diff: 'classic', ballSpeedPct: 100, paddleSizePct: 100, startLives: 0, aimGuide: 'full', trapDrops: true,
        controlMode: 'drag', sens: 1, keySpeedPct: 100, paddleHeightOffset: 'medium', invertControls: false, tapLaunch: true, autoPauseBlur: true, confirmActions: true,
        haptics: true, hapticStrength: 'medium',
        masterVol: 90, sfx: true, sfxVol: 100, bgm: false, bgmVol: 55, soundTheme: 'arcade',
        graphicsQuality: 'high', particlePct: 100, fx: true, trail: true, shake: true, shakePct: 100, hitFlash: true, bgStars: true, floatTexts: true, showBoostBar: true, showFps: false,
        highContrast: false, reducedMotion: false, colorblindMode: false, largeHud: false
      };
    }
    function freshSave() {
      return {
        v: 5, name: 'Player One', avatar: '😎', coins: 250, xp: 0,
        stars: {}, bestLevelScore: {},
        inv: { heart: 1, wide: 2, multi: 1, slow: 1, shield: 1, laser: 0, fire: 0 },
        skins: ['classic'], skin: 'classic',
        set: freshSet(),
        stats: {
          bricks: 0, brickTypes: { normal: 0, armored: 0, explosive: 0, gold: 0, core: 0, steel: 0 },
          bestCombo: 0, comboSum: 0, comboRuns: 0, playtime: 0, ballsLost: 0, powers: 0, trapsHit: 0, boostersUsed: 0,
          gamesPlayed: 0, gamesWon: 0, perfectClears: 0, bossesDefeated: 0, bestScore: 0, totalScore: 0,
          endlessBest: 0, endlessWave: 0, timedBest: 0, dailyBest: 0, dailyWins: 0, coinsEarned: 250
        },
        recentRuns: [],
        ach: {},
        daily: freshDaily(),
        streak: 0, lastClaimDate: '', muted: false
      }
    }
    let S = freshSave();
    try {
      const raw = localStorage.getItem(SAVE_KEY);
      if (raw) {
        const p = JSON.parse(raw), f = freshSave();
        S = {
          ...f, ...p,
          inv: { ...f.inv, ...(p.inv || {}) },
          set: { ...f.set, ...(p.set || {}) },
          stats: { ...f.stats, ...(p.stats || {}), brickTypes: { ...f.stats.brickTypes, ...(p.stats?.brickTypes || {}) } },
          daily: { ...f.daily, ...(p.daily || {}) },
          stars: p.stars || {}, bestLevelScore: p.bestLevelScore || {}, ach: p.ach || {},
          skins: p.skins || ['classic'], recentRuns: Array.isArray(p.recentRuns) ? p.recentRuns : []
        };
      }
    } catch (e) { }
    function ensureDaily() { if (!S.daily || S.daily.date !== todayStr()) S.daily = freshDaily() }
    ensureDaily();
    let dirty = false;
    function markDirty() { dirty = true }
    function saveNow() { try { localStorage.setItem(SAVE_KEY, JSON.stringify(S)) } catch (e) { } dirty = false }
    function getUnlocked() {
      let maxCleared = -1;
      for (const k in S.stars) { const n = +k; if (S.stars[k] > 0 && n > maxCleared) maxCleared = n }
      return maxCleared + 1; // Unlimited! 0 -> Level 1, 120 -> Level 121, etc.
    }
    function clearedCount() { let n = 0; for (const k in S.stars) if (S.stars[k] > 0) n++; return n }
    function totalStars() { let n = 0; for (const k in S.stars) n += S.stars[k] || 0; return n }
    function threeStars() { let n = 0; for (const k in S.stars) if (S.stars[k] >= 3) n++; return n }
    function worldStars(absWorld) { let n = 0; for (let i = absWorld * 15; i < absWorld * 15 + 15; i++)n += S.stars[i] || 0; return n }
    function addCoins(n) { n = Math.round(n); if (n <= 0) return; S.coins += n; S.stats.coinsEarned += n; markDirty(); syncHeader(true) }
    function addXP(amount) {
      amount = Math.round(amount); if (amount <= 0) return;
      const before = rankForXP(S.xp).level;
      S.xp += amount;
      const after = rankForXP(S.xp);
      if (after.level > before) {
        const bonus = 50 + after.level * 10;
        addCoins(bonus);
        sfx.win();
        toast('RANK UP! ' + after.icon + ' ' + after.title + ' (+' + bonus + ' coins)', 'crown', 'gold');
        if (G) banner('RANK UP: ' + after.title.toUpperCase(), '#FFD166', .28);
      }
      markDirty(); syncHeader(false);
    }

    /* ---------- WEB AUDIO SYNTH (100% OFFLINE) ---------- */
    const AU = { ctx: null, master: null, sfx: null, bgm: null, bgmTimer: null, bgmStep: 0 };
    const BGM_NOTES = [130.81, 164.81, 196.00, 246.94, 261.63, 246.94, 196.00, 164.81, 146.83, 174.61, 220.00, 261.63, 293.66, 261.63, 220.00, 174.61];
    function initAudio() {
      if (AU.ctx) return;
      try {
        const C = window.AudioContext || window.webkitAudioContext; if (!C) return;
        AU.ctx = new C();
        const comp = AU.ctx.createDynamicsCompressor(); comp.threshold.value = -18; comp.ratio.value = 6; comp.connect(AU.ctx.destination);
        AU.master = AU.ctx.createGain(); AU.master.gain.value = S.muted ? 0 : (S.set.masterVol ?? 90) / 100; AU.master.connect(comp);
        AU.sfx = AU.ctx.createGain(); AU.sfx.gain.value = S.set.sfx ? ((S.set.sfxVol ?? 100) / 100) : 0; AU.sfx.connect(AU.master);
        AU.bgm = AU.ctx.createGain(); AU.bgm.gain.value = S.set.bgm ? ((S.set.bgmVol ?? 55) / 100 * 0.25) : 0; AU.bgm.connect(AU.master);
        syncBgmLoop();
      } catch (e) { }
    }
    function syncBgmLoop() {
      if (AU.bgmTimer) { clearInterval(AU.bgmTimer); AU.bgmTimer = null }
      if (!S.set.bgm || S.muted) return;
      AU.bgmTimer = setInterval(() => {
        if (!AU.ctx || AU.ctx.state !== 'running' || !S.set.bgm || S.muted) return;
        if (UI.screen === 'game' && G && G.state === 'paused') return;
        const f = BGM_NOTES[AU.bgmStep % BGM_NOTES.length];
        AU.bgmStep++;
        tone({ f, f2: f * 1.005, d: .21, type: 'triangle', v: .22, lp: 1100, bus: AU.bgm });
        if (AU.bgmStep % 4 === 1) tone({ f: f * 0.5, d: .38, type: 'sine', v: .3, lp: 400, bus: AU.bgm });
      }, 240);
    }
    function unlockAudio() { if (!AU.ctx) initAudio(); else if (AU.ctx.state === 'suspended') AU.ctx.resume().catch(() => { }) }
    function pitchMult() { return S.set.soundTheme === 'crystal' ? 1.22 : S.set.soundTheme === 'bass' ? 0.8 : 1 }
    function tone(o) {
      if (!AU.ctx) return; const c = AU.ctx, t = o.at || c.currentTime;
      const pm = o.bus === AU.bgm ? 1 : pitchMult();
      const osc = c.createOscillator(), g = c.createGain();
      osc.type = o.type || 'sine'; osc.frequency.setValueAtTime(Math.max(20, o.f * pm), t);
      if (o.f2) osc.frequency.exponentialRampToValueAtTime(Math.max(20, o.f2 * pm), t + o.d);
      g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(o.v, t + (o.a || 0.005));
      g.gain.exponentialRampToValueAtTime(0.0001, t + o.d);
      let node = osc;
      if (o.lp) { const f = c.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = o.lp; osc.connect(f); node = f }
      node.connect(g); g.connect(o.bus || AU.sfx); osc.start(t); osc.stop(t + o.d + 0.05);
    }
    function noise(o) {
      if (!AU.ctx) return; const c = AU.ctx, t = o.at || c.currentTime;
      const len = Math.max(1, (o.d * c.sampleRate) | 0), buf = c.createBuffer(1, len, c.sampleRate), d = buf.getChannelData(0);
      for (let i = 0; i < len; i++)d[i] = Math.random() * 2 - 1;
      const src = c.createBufferSource(); src.buffer = buf;
      const f = c.createBiquadFilter(); f.type = o.hp ? 'highpass' : 'lowpass'; f.frequency.value = o.hp || o.lp || 800;
      const g = c.createGain(); g.gain.setValueAtTime(o.v, t); g.gain.exponentialRampToValueAtTime(0.0001, t + o.d);
      src.connect(f); f.connect(g); g.connect(o.bus || AU.sfx); src.start(t); src.stop(t + o.d + 0.05);
    }
    const sfx = {
      click() { tone({ f: 1500, f2: 900, d: .05, type: 'square', v: .06 }) },
      deny() { tone({ f: 220, f2: 160, d: .14, type: 'square', v: .1 }) },
      paddle() { tone({ f: 200, f2: 140, d: .07, type: 'sine', v: .22 }); noise({ d: .03, v: .05, hp: 2000 }) },
      wall() { tone({ f: 130, f2: 100, d: .045, type: 'sine', v: .1 }) },
      pop(cb) { const f = 300 * Math.pow(1.059, Math.min(cb, 22)); tone({ f, f2: f * 1.4, d: .07, type: 'square', v: .14, lp: 3200 }); if (cb > 7) tone({ f: f * 1.5, d: .06, type: 'triangle', v: .08 }); noise({ d: .025, v: .05, hp: 3000 }) },
      steel() { tone({ f: 820, f2: 600, d: .06, type: 'square', v: .09, lp: 2400 }); tone({ f: 1230, d: .04, type: 'square', v: .05 }) },
      boom() { noise({ d: .34, v: .4, lp: 420 }); tone({ f: 110, f2: 38, d: .32, type: 'sine', v: .4 }) },
      power() { [523, 659, 784].forEach((f, i) => tone({ f, d: .08, type: 'triangle', v: .14, at: AU.ctx ? AU.ctx.currentTime + i * .055 : 0 })) },
      bad() { [420, 310, 220].forEach((f, i) => tone({ f, d: .09, type: 'sawtooth', v: .1, lp: 1400, at: AU.ctx ? AU.ctx.currentTime + i * .06 : 0 })) },
      laser() { tone({ f: 1300, f2: 320, d: .08, type: 'sawtooth', v: .06, lp: 2600 }) },
      coin() { tone({ f: 988, d: .06, type: 'sine', v: .14 }); tone({ f: 1319, d: .1, type: 'sine', v: .14, at: AU.ctx ? AU.ctx.currentTime + .06 : 0 }) },
      life() { [523, 659, 784, 1046].forEach((f, i) => tone({ f, d: .12, type: 'triangle', v: .12, at: AU.ctx ? AU.ctx.currentTime + i * .07 : 0 })) },
      launch() { noise({ d: .16, v: .1, hp: 900 }); tone({ f: 280, f2: 620, d: .16, type: 'sine', v: .14 }) },
      shield() { tone({ f: 740, f2: 980, d: .14, type: 'triangle', v: .16 }) },
      lifeLost() { [330, 247].forEach((f, i) => tone({ f, f2: f * .8, d: .16, type: 'sawtooth', v: .12, lp: 1200, at: AU.ctx ? AU.ctx.currentTime + i * .12 : 0 })) },
      win() { [523, 659, 784, 1046, 784, 1318].forEach((f, i) => tone({ f, d: .16, type: 'triangle', v: .16, at: AU.ctx ? AU.ctx.currentTime + i * .11 : 0 })); noise({ d: .5, v: .05, hp: 5000 }) },
      lose() { [392, 311, 262, 196].forEach((f, i) => tone({ f, d: .2, type: 'sawtooth', v: .1, lp: 1000, at: AU.ctx ? AU.ctx.currentTime + i * .15 : 0 })) },
      star(i) { if (!AU.ctx) return; tone({ f: 1046 * (1 + i * .26), d: .18, type: 'triangle', v: .16, at: AU.ctx.currentTime + .2 + i * .18 }) },
      combo(m) { tone({ f: 440 * m * .5, f2: 880 * m * .5, d: .14, type: 'square', v: .09, lp: 2600 }) },
      wave() { [392, 523, 659].forEach((f, i) => tone({ f, d: .1, type: 'triangle', v: .12, at: AU.ctx ? AU.ctx.currentTime + i * .07 : 0 })) },
      warn() { tone({ f: 180, f2: 140, d: .2, type: 'square', v: .08, lp: 700 }) }
    };
    function setMuted(m) { S.muted = m; markDirty(); saveNow(); applyAudioSet(); syncMute(); syncBgmLoop() }
    function syncMute() { $$('.mute-btn').forEach(b => { b.classList.toggle('off', S.muted); b.innerHTML = icon(S.muted ? 'volx' : 'vol') + '<span class="m-label">' + (S.muted ? 'Muted' : 'Sound') + '</span>'; b.setAttribute('aria-pressed', String(!S.muted)) }) }
    function applyAudioSet() {
      if (!AU.ctx) { if (S.set.bgm && !S.muted) initAudio(); return }
      const mv = S.muted ? 0 : ((S.set.masterVol ?? 90) / 100);
      AU.master.gain.setTargetAtTime(mv, AU.ctx.currentTime, .03);
      AU.sfx.gain.setTargetAtTime(S.set.sfx ? ((S.set.sfxVol ?? 100) / 100) : 0, AU.ctx.currentTime, .04);
      if (AU.bgm) AU.bgm.gain.setTargetAtTime(S.set.bgm ? ((S.set.bgmVol ?? 55) / 100 * 0.25) : 0, AU.ctx.currentTime, .05);
      syncBgmLoop();
    }
    function applyDisplaySet() {
      document.body.classList.toggle('high-contrast', !!S.set.highContrast);
      document.body.classList.toggle('reduced-motion', !!S.set.reducedMotion);
      document.body.classList.toggle('large-hud', !!S.set.largeHud);
      const fb = $('#fpsBadge');
      if (fb) fb.classList.toggle('show', !!S.set.showFps);
    }
    function haptic(p) {
      if (!S.set.haptics || !navigator.vibrate) return;
      const mult = S.set.hapticStrength === 'light' ? 0.5 : S.set.hapticStrength === 'strong' ? 1.6 : 1;
      try {
        if (Array.isArray(p)) navigator.vibrate(p.map(x => Math.max(1, Math.round(x * mult))));
        else navigator.vibrate(Math.max(1, Math.round(p * mult)));
      } catch (e) { }
    }

    /* ---------- TOAST & SHEETS ---------- */
    function toast(msg, ic, tone_) {
      const root = $('#toastRoot');
      while (root.children.length >= 3) root.firstChild.remove();
      const el = document.createElement('div'); el.className = 'toast ' + (tone_ || 'info');
      el.innerHTML = icon(ic || 'info') + '<span>' + msg + '</span>'; root.appendChild(el);
      requestAnimationFrame(() => el.classList.add('show'));
      setTimeout(() => { el.classList.add('hide'); setTimeout(() => el.remove(), 300) }, 2400);
    }
    const UI = { screen: 'home', absWorld: 0, levelFilter: 'all', statsTab: 'overview', sheet: null, dismiss: null, sheetTimer: null, closeT: null };
    function openSheet(html, type, dismiss) {
      const root = $('#sheetRoot'); clearTimeout(UI.closeT); clearInterval(UI.sheetTimer);
      UI.sheet = type; UI.dismiss = dismiss || null; root.classList.remove('closing');
      root.innerHTML = '<div class="backdrop" data-action="sheet-backdrop"></div><div class="sheet" role="dialog" aria-modal="true">' + html + '</div>';
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('open')));
    }
    function closeSheet(instant) {
      const root = $('#sheetRoot'); if (!UI.sheet && !root.innerHTML) return;
      UI.sheet = null; UI.dismiss = null; clearInterval(UI.sheetTimer);
      if (instant) { root.classList.remove('open', 'closing'); root.innerHTML = ''; return }
      root.classList.add('closing');
      UI.closeT = setTimeout(() => { root.classList.remove('open', 'closing'); root.innerHTML = '' }, 240);
    }
    function sheetBackdrop() { if (UI.dismiss) actions[UI.dismiss] && actions[UI.dismiss]() }

    /* ---------- UNLIMITED PROCEDURAL LEVEL GENERATOR ---------- */
    const COLS = 11, VW = 480, MIN_VH = 690, SIDE = 14, GAP = 3, BW = (VW - 2 * SIDE - (COLS - 1) * GAP) / COLS, BH = 24, VGAP = 3, TOP = 42, PH = 16, BALL_R = 7;
    function bm(rows) { return rows.map(r => r.split('').map(c => c === '1')) }
    const PATTERNS = [
      { name: 'The Wall', fn: () => true },
      { name: 'Checkerboard', fn: (c, r) => (c + r) % 2 === 0 },
      { name: 'Summit', fn: (c, r, C, Rw) => Math.abs(c - (C - 1) / 2) <= r / (Rw - 1) * (C - 1) / 2 + .01 },
      { name: 'Twin Gates', fn: (c) => c % 3 !== 1 },
      { name: 'Prism', fn: (c, r, C, Rw) => Math.abs(c - (C - 1) / 2) / ((C - 1) / 2) + Math.abs(r - (Rw - 1) / 2) / ((Rw - 1) / 2) <= 1.04 },
      { name: 'Switchback', fn: (c, r) => ((c + r * 2) % 6) < 3 },
      { name: 'The Arch', fn: (c, r, C) => r < 2 || c < 2 || c >= C - 2 },
      { name: 'Tidal', fn: (c, r) => r >= Math.round(1.6 + 1.4 * Math.sin(c * .85)) },
      { name: 'Crossfire', fn: (c, r, C, Rw) => Math.abs(c - (C - 1) / 2) <= 1 || Math.abs(r - (Rw - 1) / 2) <= 1 },
      { name: 'Fortress', fn: (c, r, C, Rw) => c === 0 || c === C - 1 || r === 0 || r === Rw - 1 || (c >= 3 && c <= C - 4 && r >= 3 && r <= Rw - 4) },
      { name: 'The Funnel', fn: (c, r, C, Rw) => Math.abs(c - (C - 1) / 2) >= (C - 1) / 2 - r / (Rw - 1) * (C - 1) / 2 - .01 },
      { name: 'Vortex', fn: (c, r, C, Rw) => { const dx = c - (C - 1) / 2, dy = r - (Rw - 1) / 2; const k = Math.floor(Math.max(Math.abs(dx), Math.abs(dy) * 1.3)); const q = Math.floor((Math.atan2(dy, dx) + Math.PI) / (Math.PI / 2)); return (k + q) % 3 !== 0 } },
      { name: 'Cascade', fn: (c, r) => (((c - r) % 4) + 4) % 4 < 2 },
      { name: 'Lattice', fn: (c, r) => c % 3 === 0 || r % 3 === 0 }
    ];
    const BOSSES = [
      { name: 'THE INVADER', g: bm(['00100000100', '00010001000', '00111111100', '01101110110', '11111111111', '10111111101', '10100000101', '00011011000']) },
      { name: 'SOLAR HEART', g: bm(['00110001100', '01111011110', '11111111111', '11111111111', '11111111111', '01111111110', '00111111100', '00011111000', '00001110000', '00000100000']) },
      { name: 'ACID SMILE', g: bm(['00111111100', '01111111110', '11111111111', '11011111011', '11111111111', '10111111101', '11000000011', '01111111110', '00111111100']) },
      { name: 'FROST CROWN', g: bm(['10000100001', '11001110011', '11111111111', '11111111111', '01111111110', '11111111111', '11111111111', '01111111110']) },
      { name: 'MAGMA SKULL', g: bm(['00111111100', '01111111110', '11111111111', '11001110011', '11111111111', '11110101111', '01111111110', '01101010110', '00111111100']) },
      { name: 'VOID STAR', g: bm(['00000100000', '00001110000', '00001110000', '11111111111', '01111111110', '00111111100', '00111111100', '01111011110', '01100000110', '11000000011']) },
      { name: 'GILDED GEM', g: bm(['00111111100', '01111111110', '11111111111', '01111111110', '00111111100', '00011111000', '00001110000', '00000100000']) },
      { name: 'THE PHOENIX', g: bm(['11000100011', '11101110111', '11111111111', '01111111110', '00111111100', '00011111000', '00110101100', '01100000110']) }
    ];
    /* Brick codes:
       1 = Normal (1 HP)
       2 = Armored (2 HP)
       3 = Heavy Armored (3 HP+)
       4 = Explosive Bomb (1 HP, 3x3 blast)
       5 = Indestructible Steel (broken only by Fireball)
       6 = Gold Coin Brick (extra coins)
       7 = Gift Capsule Brick (guaranteed good power-up)
       8 = Crystal Boss Core (High HP, huge points & XP)
    */
    function buildBricks(mask, rows, o) {
      const rng = o.rng, grid = [];
      const sectorBonus = o.sector || 0;
      for (let r = 0; r < rows; r++) {
        grid[r] = [];
        for (let c = 0; c < COLS; c++) {
          if (!mask[r] || !mask[r][c]) { grid[r][c] = 0; continue }
          let code = 1; const roll = rng();
          if (roll < o.hardP) code = 3; else if (roll < o.hardP + o.toughP) code = 2;
          if (code === 1 && o.steelP > 0 && rng() < o.steelP && r < rows - 1 && !(grid[r][c - 1] === 5 || (grid[r - 1] && grid[r - 1][c] === 5))) code = 5;
          grid[r][c] = code;
        }
      }
      const normals = [];
      for (let r = 0; r < rows; r++)for (let c = 0; c < COLS; c++)if (grid[r][c] === 1) normals.push([r, c]);
      for (let i = normals.length - 1; i > 0; i--) { const j = (rng() * (i + 1)) | 0;[normals[i], normals[j]] = [normals[j], normals[i]] }
      let ni = 0; const put = (n, code) => { for (let k = 0; k < n && ni < normals.length; k++, ni++) { const [r, c] = normals[ni]; grid[r][c] = code } };
      put(o.expl, 4); put(o.coins, 6); put(o.gifts, 7);
      if (o.boss) {
        // Place Crystal Core bricks in the boss center
        const cr = Math.floor(rows / 2), cc = Math.floor(COLS / 2);
        if (grid[cr] && grid[cr][cc]) grid[cr][cc] = 8;
        if (sectorBonus > 0 && grid[cr] && grid[cr][cc - 1]) grid[cr][cc - 1] = 8;
        if (sectorBonus > 0 && grid[cr] && grid[cr][cc + 1]) grid[cr][cc + 1] = 8;
      }
      const bricks = []; let breakable = 0;
      for (let r = 0; r < rows; r++)for (let c = 0; c < COLS; c++) {
        const code = grid[r][c]; if (!code) continue;
        let mhp = code === 2 ? 2 : code === 3 ? (3 + Math.min(2, sectorBonus)) : code === 8 ? (6 + o.absWorld + sectorBonus * 3) : 1;
        const moving = o.moving && (o.boss ? r % 2 === 1 : r % 3 === 1);
        bricks.push({
          c, r, x: SIDE + c * (BW + GAP), y: TOP + r * (BH + VGAP), rx: SIDE + c * (BW + GAP), code, mhp, hp: mhp, alive: true,
          moveAmp: moving ? Math.min(16, 6 + o.wi * 1.5 + sectorBonus * 2) : 0,
          moveSpd: .7 + o.li * .04 + sectorBonus * .18 + rng() * .35, movePh: rng() * 6.283
        });
        if (code !== 5) breakable++;
      }
      return { bricks, breakable, rows };
    }
    const levelCache = new Map();
    function getLevel(idx) {
      if (levelCache.has(idx)) return levelCache.get(idx);
      const absWorld = Math.floor(idx / 15), sector = Math.floor(absWorld / 8), wi = absWorld % 8, li = idx % 15;
      const rng = mulberry32(((idx + 1) * 2654435761) ^ 0x9E3779B9);
      const boss = li === 14;
      let rows = clamp(4 + Math.floor(li * .52) + Math.floor(wi * .45) + Math.min(2, sector), 4, 11), mask, name;
      if (boss) { const B = BOSSES[wi]; mask = B.g; rows = mask.length; name = B.name + (sector > 0 ? ' MK-' + (sector + 1) : '') }
      else {
        const P = PATTERNS[(li + sector * 3) % PATTERNS.length]; name = P.name; mask = [];
        for (let r = 0; r < rows; r++) { mask[r] = []; for (let c = 0; c < COLS; c++)mask[r][c] = P.fn(c, r, COLS, rows) }
        if (rng() < .5) mask = mask.map(row => row.slice().reverse());
        if (wi >= 2 || sector > 0) for (let r = 0; r < rows; r++)for (let c = 0; c < COLS; c++)if (mask[r][c] && rng() < .06) mask[r][c] = false;
      }
      const built = buildBricks(mask, rows, {
        rng, wi, li, absWorld, sector, boss,
        toughP: Math.min(.55, .1 + wi * .05 + li * .008 + sector * .06 + (boss ? .15 : 0)),
        hardP: (wi >= 2 || sector > 0) ? Math.min(.42, .04 + wi * .03 + sector * .06 + (boss ? .12 : 0)) : 0,
        steelP: (wi >= 1 || sector > 0) ? Math.min(.12, .015 + wi * .014 + sector * .015) : 0,
        expl: 1 + Math.floor(wi / 2) + (li > 7 ? 1 : 0) + (boss ? 2 : 0),
        coins: 2 + (li > 5 ? 1 : 0) + (boss ? 2 : 0),
        gifts: 1 + (li >= 10 ? 1 : 0) + (boss ? 1 : 0),
        moving: wi >= 3 || sector > 0
      });
      const lvl = { idx, absWorld, sector, wi, li, boss, name, rows, ...built };
      if (levelCache.size > 250) levelCache.clear();
      levelCache.set(idx, lvl); return lvl;
    }
    function genEndless(wave) {
      const rng = mulberry32(wave * 7919 + 13), wi = (wave - 1) % 8, sector = Math.floor((wave - 1) / 8);
      const rows = Math.min(4 + Math.floor(wave * .5), 10);
      const P = PATTERNS[(rng() * PATTERNS.length) | 0], mask = [];
      for (let r = 0; r < rows; r++) { mask[r] = []; for (let c = 0; c < COLS; c++)mask[r][c] = P.fn(c, r, COLS, rows) }
      return {
        wi, absWorld: wave - 1, sector, li: Math.min(14, wave), boss: wave % 5 === 0, name: wave % 5 === 0 ? ('WAVE ' + wave + ' BOSS') : P.name, rows, ...buildBricks(mask, rows, {
          rng, wi, li: Math.min(14, wave), absWorld: wave - 1, sector, boss: wave % 5 === 0,
          toughP: Math.min(.55, .08 + wave * .03), hardP: wave >= 4 ? Math.min(.38, .02 + wave * .02) : 0,
          steelP: wave >= 3 ? Math.min(.1, .01 + wave * .008) : 0, expl: Math.min(5, 1 + Math.floor(wave / 3)),
          coins: 2 + Math.floor(wave / 4), gifts: 1 + (wave % 3 === 0 ? 1 : 0), moving: wave >= 5
        })
      };
    }
    function genDailyChallenge() {
      const seed = parseInt(todayStr().replace(/-/g, ''), 10);
      const rng = mulberry32(seed), wi = seed % 8;
      const rows = 7, P = PATTERNS[seed % PATTERNS.length], mask = [];
      for (let r = 0; r < rows; r++) { mask[r] = []; for (let c = 0; c < COLS; c++)mask[r][c] = P.fn(c, r, COLS, rows) }
      return {
        wi, absWorld: wi, sector: 1, li: 14, boss: true, name: 'Daily Cosmic Board', rows, ...buildBricks(mask, rows, {
          rng, wi, li: 10, absWorld: wi, sector: 1, boss: true,
          toughP: .28, hardP: .16, steelP: .05, expl: 3, coins: 4, gifts: 2, moving: true
        })
      };
    }
    function genTimeAttack(round) {
      const rng = mulberry32(20261119 + round * 4177), wi = (round + 1) % 8;
      const rows = Math.min(5 + round, 8), P = PATTERNS[(round * 3) % PATTERNS.length], mask = [];
      for (let r = 0; r < rows; r++) { mask[r] = []; for (let c = 0; c < COLS; c++)mask[r][c] = P.fn(c, r, COLS, rows) }
      return {
        wi, absWorld: round, sector: 0, li: round, boss: false, name: 'Speed Stage ' + (round + 1), rows, ...buildBricks(mask, rows, {
          rng, wi, li: round, absWorld: round, sector: 0, boss: false,
          toughP: .18 + round * .04, hardP: round >= 2 ? .12 : 0, steelP: 0, expl: 3, coins: 3, gifts: 2, moving: round >= 2
        })
      };
    }

    function codeColor(b, hues) {
      if (b.code === 4) return '#FF6B35';
      if (b.code === 5) return '#7C86A8';
      if (b.code === 6) return '#FFC53D';
      if (b.code === 7) return '#FF3D8A';
      if (b.code === 8) return '#E879F9';
      return hues[b.r % 4];
    }
    function drawPreview(canvas, idx) {
      const lvl = getLevel(idx), c = canvas.getContext('2d'), cw = canvas.width, ch = canvas.height;
      c.clearRect(0, 0, cw, ch);
      const sx = cw / VW, sy = (ch - 8) / (lvl.rows * (BH + VGAP)), hues = WORLDS[lvl.wi].hues;
      for (const b of lvl.bricks) {
        c.fillStyle = codeColor(b, hues);
        rr(c, b.x * sx + 1, 4 + (b.y - TOP) * sy, BW * sx - 1.5, Math.max(2, BH * sy - 1.5), 2); c.fill();
      }
    }

    /* ---------- GAME ENGINE STATE ---------- */
    let G = null, runSeq = 0;
    const cv = $('#cv'), ctx = cv.getContext('2d');
    let VH = 740, scale = 1, viewX = 0, cssW = 400, cssH = 700, topWall = 6, dpr = 1, fpsSmooth = 60;
    let sprites = new Map(), dropSprites = {}, paddleSprite = null, ballSprite = null, fireSprite = null, auroraA = null, auroraB = null, glowOrange = null, glowMagenta = null, bgGrad = null, shieldGrad = null;
    let trailCol = 'rgba(34,211,238,';
    const keys = { l: false, r: false };
    let drag = null;
    const MAXP = () => {
      if (S.set.reducedMotion) return 40;
      const base = S.set.fx ? 500 : 200;
      return Math.max(30, Math.round(base * ((S.set.particlePct ?? 100) / 100)));
    };

    function skin() { return SKINS.find(s => s.id === S.skin) || SKINS[0] }
    function makeGlow(color, size) {
      const c = document.createElement('canvas'); c.width = c.height = size; const x = c.getContext('2d');
      const g = x.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
      g.addColorStop(0, rgba(color, .85)); g.addColorStop(.35, rgba(color, .32)); g.addColorStop(1, rgba(color, 0));
      x.fillStyle = g; x.fillRect(0, 0, size, size); return c;
    }
    function buildSprites(wi) {
      sprites = new Map(); const hues = WORLDS[wi].hues;
      for (let h = 0; h < 4; h++) {
        for (const code of [1, 2, 3, 4, 5, 6, 7, 8]) {
          const states = code === 2 ? [2, 1] : code === 3 ? [3, 2, 1] : [1];
          for (const hp of states) {
            const key = code + '_' + hp + '_' + h;
            const cnv = document.createElement('canvas'); cnv.width = Math.ceil(BW * 2); cnv.height = BH * 2;
            const c = cnv.getContext('2d'); c.scale(2, 2);
            let base = code === 4 ? '#FF6B35' : code === 5 ? '#7C86A8' : code === 6 ? '#FFC53D' : code === 7 ? '#FF3D8A' : code === 8 ? '#E879F9' : hues[h];
            const g = c.createLinearGradient(0, 0, 0, BH);
            g.addColorStop(0, shade(base, 38)); g.addColorStop(.45, base); g.addColorStop(1, shade(base, -32));
            rr(c, .5, .5, BW - 1, BH - 1, 5.5); c.fillStyle = g; c.fill();
            c.strokeStyle = rgba('#FFFFFF', .3); c.lineWidth = 1; c.stroke();
            rr(c, 3, 2.5, BW - 6, 5, 3); c.fillStyle = 'rgba(255,255,255,.3)'; c.fill();
            rr(c, 3, BH - 6, BW - 6, 3.5, 2); c.fillStyle = 'rgba(0,0,0,.22)'; c.fill();
            if (code === 2 || code === 3) {
              const max = code === 2 ? 2 : 3;
              for (let p = 0; p < max; p++) {
                c.beginPath(); c.arc(BW / 2 + (p - (max - 1) / 2) * 7, BH / 2 + 1, 1.8, 0, 7);
                c.fillStyle = p < hp ? 'rgba(255,255,255,.92)' : 'rgba(0,0,0,.4)'; c.fill()
              }
              if (hp < max) {
                c.strokeStyle = 'rgba(10,5,20,.55)'; c.lineWidth = 1.3; c.beginPath();
                c.moveTo(BW * .25, 3); c.lineTo(BW * .4, BH * .45); c.lineTo(BW * .3, BH - 3); c.stroke()
              }
            }
            if (code === 4) {
              c.beginPath(); c.arc(BW / 2, BH / 2, 5.5, 0, 7); c.fillStyle = '#FFD166'; c.fill();
              c.beginPath(); c.arc(BW / 2, BH / 2, 2.6, 0, 7); c.fillStyle = '#7A1D05'; c.fill();
            }
            if (code === 5) {
              c.strokeStyle = 'rgba(30,36,60,.5)'; c.lineWidth = 2;
              for (let i = -1; i < 4; i++) { c.beginPath(); c.moveTo(i * 12, BH + 2); c.lineTo(i * 12 + 14, -2); c.stroke() }
              c.fillStyle = 'rgba(230,238,255,.75)';
              [[5, 5], [BW - 5, 5], [5, BH - 5], [BW - 5, BH - 5]].forEach(p => { c.beginPath(); c.arc(p[0], p[1], 1.6, 0, 7); c.fill() });
            }
            if (code === 6) {
              c.beginPath(); c.arc(BW / 2, BH / 2, 6.5, 0, 7); c.fillStyle = '#FFE08A'; c.fill();
              c.strokeStyle = '#8A5A00'; c.lineWidth = 1.5; c.stroke();
            }
            if (code === 7) {
              c.fillStyle = 'rgba(255,255,255,.85)'; c.fillRect(BW / 2 - 1.5, 2, 3, BH - 4); c.fillRect(3, BH / 2 - 1.5, BW - 6, 3);
            }
            if (code === 8) {
              c.fillStyle = '#FFF'; c.font = '900 11px sans-serif'; c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillText('★', BW / 2, BH / 2 + 1);
            }
            sprites.set(key, cnv);
          }
        }
      }
      glowOrange = makeGlow('#FFB020', 64); glowMagenta = makeGlow('#FF3D8A', 64);
      buildDropSprites(); buildBallSprites(); buildPaddleSprite();
      auroraA = makeGlow(WORLDS[wi].glow[0], 256); auroraB = makeGlow(WORLDS[wi].glow[1], 256);
    }
    function glyph(c, type, x, y) {
      c.save(); c.translate(x, y); c.strokeStyle = '#fff'; c.fillStyle = '#fff'; c.lineWidth = 2.2; c.lineCap = 'round'; c.lineJoin = 'round';
      switch (type) {
        case 'wide': c.beginPath(); c.moveTo(-7, 0); c.lineTo(7, 0); c.moveTo(-7, 0); c.lineTo(-4, -3); c.moveTo(-7, 0); c.lineTo(-4, 3); c.moveTo(7, 0); c.lineTo(4, -3); c.moveTo(7, 0); c.lineTo(4, 3); c.stroke(); break;
        case 'multi': [[-4, 3], [4, 3], [0, -4]].forEach(p => { c.beginPath(); c.arc(p[0], p[1], 2.6, 0, 7); c.fill() }); break;
        case 'slow': c.beginPath(); c.arc(0, 0, 6, 0, 7); c.stroke(); c.beginPath(); c.moveTo(0, -3.5); c.lineTo(0, 0); c.lineTo(3, 2); c.stroke(); break;
        case 'laser': c.beginPath(); c.moveTo(-4, 4); c.lineTo(-4, -3); c.moveTo(4, 4); c.lineTo(4, -3); c.stroke(); break;
        case 'fire': c.beginPath(); c.moveTo(0, -7); c.quadraticCurveTo(6, -1, 4, 4); c.quadraticCurveTo(2, 7, 0, 7); c.quadraticCurveTo(-2, 7, -4, 4); c.quadraticCurveTo(-6, -1, 0, -7); c.fill(); break;
        case 'magnet': c.beginPath(); c.moveTo(-5, -6); c.lineTo(-5, 1); c.arc(0, 1, 5, Math.PI, 0, true); c.lineTo(5, -6); c.stroke(); break;
        case 'shield': c.beginPath(); c.moveTo(0, -7); c.lineTo(6, -4.5); c.lineTo(6, 1); c.quadraticCurveTo(6, 5, 0, 7.5); c.quadraticCurveTo(-6, 5, -6, 1); c.lineTo(-6, -4.5); c.closePath(); c.stroke(); break;
        case 'life': c.beginPath(); c.moveTo(0, 6); c.bezierCurveTo(-8, 0, -6, -7, 0, -3); c.bezierCurveTo(6, -7, 8, 0, 0, 6); c.fill(); break;
        case 'coin': c.beginPath(); c.arc(0, 0, 6.5, 0, 7); c.stroke(); c.beginPath(); c.arc(0, 0, 3, 0, 7); c.stroke(); break;
        case 'fast': c.beginPath(); c.moveTo(-6, -5); c.lineTo(-1, 0); c.lineTo(-6, 5); c.moveTo(1, -5); c.lineTo(6, 0); c.lineTo(1, 5); c.stroke(); break;
        case 'shrink': c.beginPath(); c.moveTo(-7, 0); c.lineTo(-2, 0); c.moveTo(7, 0); c.lineTo(2, 0); c.stroke(); break;
      }
      c.restore();
    }
    function buildDropSprites() {
      dropSprites = {};
      for (const id in POWERS) {
        const p = POWERS[id], cnv = document.createElement('canvas'); cnv.width = 64; cnv.height = 80;
        const c = cnv.getContext('2d'); c.scale(2, 2);
        const g = c.createLinearGradient(0, 4, 0, 36);
        g.addColorStop(0, shade(p.color, 45)); g.addColorStop(.5, p.color); g.addColorStop(1, shade(p.color, -35));
        rr(c, 3, 4, 26, 32, 12); c.fillStyle = g; c.fill();
        c.strokeStyle = p.bad ? 'rgba(255,255,255,.92)' : 'rgba(255,255,255,.5)'; c.lineWidth = p.bad ? 2 : 1.4; c.stroke();
        rr(c, 7, 7, 18, 7, 4); c.fillStyle = 'rgba(255,255,255,.35)'; c.fill();
        glyph(c, id, 16, 21);
        if (p.bad) { c.fillStyle = '#fff'; c.font = '800 9px sans-serif'; c.textAlign = 'center'; c.fillText('!', 26, 11) }
        dropSprites[id] = cnv;
      }
    }
    function buildBallSprites() {
      const sk = skin();
      trailCol = 'rgba(' + parseInt(sk.c[0].slice(1, 3), 16) + ',' + parseInt(sk.c[0].slice(3, 5), 16) + ',' + parseInt(sk.c[0].slice(5, 7), 16) + ',';
      ballSprite = makeGlow(sk.c[0], 56); fireSprite = makeGlow('#FF8A3D', 56);
    }
    function buildPaddleSprite() {
      if (!G) return; const sk = skin(), w = G.paddle.w, m = 22;
      const cnv = document.createElement('canvas'); cnv.width = Math.ceil((w + m * 2) * 2); cnv.height = (PH + m * 2) * 2;
      const c = cnv.getContext('2d'); c.scale(2, 2);
      const g = c.createRadialGradient(m + w / 2, m + PH / 2, 2, m + w / 2, m + PH / 2, w * .7);
      g.addColorStop(0, rgba(sk.c[0], .4)); g.addColorStop(1, rgba(sk.c[0], 0));
      c.fillStyle = g; c.fillRect(0, 0, w + m * 2, PH + m * 2);
      const lg = c.createLinearGradient(m, 0, m + w, 0);
      lg.addColorStop(0, sk.c[0]); lg.addColorStop(.5, sk.c[1]); lg.addColorStop(1, sk.c[2]);
      rr(c, m, m, w, PH, 8); c.fillStyle = lg; c.fill();
      c.strokeStyle = 'rgba(255,255,255,.5)'; c.lineWidth = 1.2; c.stroke();
      rr(c, m + 5, m + 2.5, w - 10, 4.5, 2.5); c.fillStyle = 'rgba(255,255,255,.45)'; c.fill();
      c.fillStyle = '#fff'; c.beginPath(); c.arc(m + 6, m + PH / 2, 2, 0, 7); c.arc(m + w - 6, m + PH / 2, 2, 0, 7); c.fill();
      paddleSprite = { cnv, m };
    }
    function paddleOffset() {
      return S.set.paddleHeightOffset === 'high' ? 88 : S.set.paddleHeightOffset === 'low' ? 46 : 64;
    }
    function resize() {
      const rect = cv.getBoundingClientRect(); if (rect.width < 2 || rect.height < 2) return;
      cssW = rect.width; cssH = rect.height;
      const maxDpr = S.set.graphicsQuality === 'low' ? 1 : S.set.graphicsQuality === 'medium' ? 1.5 : (S.set.fx ? 2 : 1.35);
      dpr = Math.min(maxDpr, window.devicePixelRatio || 1);
      cv.width = Math.round(cssW * dpr); cv.height = Math.round(cssH * dpr);
      if (cv.width / cv.height <= VW / MIN_VH) {
        scale = cv.width / VW;
        VH = Math.max(MIN_VH, cv.height / scale);
        viewX = 0;
      } else {
        VH = MIN_VH;
        scale = cv.height / VH;
        viewX = (cv.width / scale - VW) / 2;
      }
      ctx.setTransform(scale, 0, 0, scale, viewX * scale, 0);
      topWall = 6;
      if (G) {
        G.paddle.y = VH - paddleOffset();
        for (const b of G.balls) { b.y = Math.min(b.y, G.paddle.y - BALL_R - 1); b.x = clamp(b.x, BALL_R, VW - BALL_R) }
        bgGrad = ctx.createLinearGradient(0, 0, 0, VH);
        const w = WORLDS[G.wi]; bgGrad.addColorStop(0, w.bg[0]); bgGrad.addColorStop(.55, shade(w.bg[0], -12)); bgGrad.addColorStop(1, w.bg[1]);
        shieldGrad = ctx.createLinearGradient(0, 0, VW, 0);
        shieldGrad.addColorStop(0, 'rgba(139,92,246,0)'); shieldGrad.addColorStop(.2, '#8B5CF6'); shieldGrad.addColorStop(.5, '#22D3EE'); shieldGrad.addColorStop(.8, '#8B5CF6'); shieldGrad.addColorStop(1, 'rgba(139,92,246,0)');
      }
    }
    function spawnBall() { G.balls.push({ x: G.paddle.x, y: G.paddle.y - BALL_R - 1, vx: 0, vy: 0, r: BALL_R, sticky: true, off: 0, trail: [] }) }
    function ballSpeed() {
      const userMult = clamp((S.set.ballSpeedPct ?? 100) / 100, 0.6, 1.6);
      let s = (G.speedBase + G.ramp) * userMult * (G.fx.slow ? 0.72 : 1) * (G.fx.fast ? 1.28 : 1);
      return Math.min(760, s);
    }
    function paddleTargetW() {
      const d = DIFFS[S.set.diff] || DIFFS.classic;
      const userMult = clamp((S.set.paddleSizePct ?? 100) / 100, 0.7, 1.5);
      return clamp(d.paddle * userMult * (G.fx.wide ? 1.45 : 1) * (G.fx.shrink ? 0.7 : 1), 52, 195);
    }

    function startGame(mode, idx) {
      closeSheet(true); ensureDaily();
      const d = DIFFS[S.set.diff] || DIFFS.classic;
      const customLives = S.set.startLives > 0 ? S.set.startLives : d.lives;
      let lvl;
      if (mode === 'campaign') lvl = getLevel(idx || 0);
      else if (mode === 'endless') lvl = genEndless(1);
      else if (mode === 'daily') lvl = genDailyChallenge();
      else lvl = genTimeAttack(0);
      const wi = lvl.wi;
      const speedEsc = mode === 'campaign' ? Math.min(200, lvl.absWorld * 14 + lvl.li * 1.5 + lvl.sector * 18) : mode === 'daily' ? 50 : mode === 'timed' ? 30 : 0;
      G = {
        id: ++runSeq, mode, idx: idx || 0, absWorld: lvl.absWorld || 0, sector: lvl.sector || 0, wi, li: lvl.li || 0, boss: !!lvl.boss, name: lvl.name,
        bricks: lvl.bricks.map(b => ({ ...b, hp: b.mhp, alive: true, rx: b.x })), breakable: lvl.breakable, rows: lvl.rows,
        balls: [], drops: [], lasers: [], parts: [], texts: [], blastQ: [], blasting: false,
        paddle: { x: VW / 2, tx: VW / 2, w: d.paddle * ((S.set.paddleSizePct ?? 100) / 100), y: VH - paddleOffset(), pulse: 0 },
        fx: {}, shield: 0, lives: customLives, maxLives: customLives, deaths: 0,
        score: 0, scoreRecorded: 0, combo: 0, comboT: 0, mult: 1, bestComboRun: 0, coinsRun: 0, xpRun: 0, xpAwarded: 0, bricksRun: 0,
        speedBase: d.speed + speedEsc, ramp: 0,
        state: 'ready', prevState: 'ready', launched: false, queued: {}, t: 0, runT: 0, lastRunT: 0,
        timeLeft: mode === 'timed' ? 150 : (mode === 'daily' ? 180 : 0),
        timedRound: 0,
        shake: 0, flash: 0, winT: 0, loseT: 0, sheetShown: false, wave: 1, waveDelay: 0, descT: 14, descInt: 14,
        laserAcc: 0, usedContinue: false, livesDirty: true, fxDirty: true, labelDirty: true, scoreShown: -1, coinsShown: -1, comboShown: -1,
        stars: Array.from({ length: 100 }, () => ({ x: R(), y: R(), z: .3 + R() * .7, tw: R() * 6.28 })),
        newRecord: false, hintMode: ''
      };
      spawnBall();
      buildSprites(wi);
      showScreen('game');
      requestAnimationFrame(() => {
        resize(); buildPaddleSprite();
        const headline = mode === 'campaign' ? ('LEVEL ' + (G.idx + 1)) : mode === 'endless' ? 'ENDLESS MODE' : mode === 'timed' ? 'TIME ATTACK' : 'DAILY CHALLENGE';
        banner(headline, WORLDS[wi].hues[0]);
        setTimeout(() => { if (G && G.state === 'ready') banner(G.name.toUpperCase(), '#FFFFFF', .62) }, 420);
      });
      renderLives(); renderBoostBar(); syncHUD(true);
      $('#vignette').classList.remove('danger');
    }
    function quitGame(dest) {
      closeSheet(true);
      if (G) { S.stats.playtime += G.runT; G.runT = 0; saveNow() }
      G = null;
      showScreen(dest || 'home');
    }
    function restartGame() { if (!G) return; startGame(G.mode, G.idx) }

    /* ---------- EFFECTS, BOOSTERS & POWERS ---------- */
    function applyEffect(id, dur) { G.fx[id] = { t: dur, dur }; G.fxDirty = true }
    function clearTimedEffects() { G.fx = {}; G.fxDirty = true }
    function splitBalls() {
      const cur = G.balls.filter(b => !b.sticky), src = cur.length ? cur : G.balls;
      for (const b of src) {
        for (const a of [-.42, .42]) {
          if (G.balls.length >= 7) return;
          let vx = b.vx, vy = b.vy;
          if (b.sticky) { vx = Math.sin(a) * ballSpeed(); vy = -Math.cos(a) * ballSpeed() }
          else { const ca = Math.cos(a), sa = Math.sin(a); const nx = vx * ca - vy * sa, ny = vx * sa + vy * ca; vx = nx; vy = ny }
          G.balls.push({ x: b.x, y: b.y, vx, vy, r: BALL_R, sticky: false, off: 0, trail: [] });
        }
      }
    }
    function applyPower(id, fromBooster) {
      const p = POWERS[id]; if (!p) return;
      S.stats.powers++; S.daily.powers++; if (fromBooster) S.stats.boostersUsed++;
      if (p.bad) S.stats.trapsHit++;
      markDirty();
      pushText(p.name.toUpperCase(), G.paddle.x, G.paddle.y - 26, p.color, 13);
      if (p.bad) { sfx.bad(); haptic([15, 30, 15]); shake(6) } else { sfx.power(); haptic(12) }
      catchFX(G.paddle.x, G.paddle.y, p.color);
      switch (id) {
        case 'multi': splitBalls(); break;
        case 'life': case 'heart': G.lives = Math.min(6, G.lives + 1); G.maxLives = Math.max(G.maxLives, G.lives); G.livesDirty = true; sfx.life(); break;
        case 'coin': addCoins(25); G.coinsRun += 25; sfx.coin(); coinFX(G.paddle.x, G.paddle.y); break;
        case 'shield': G.shield = Math.min(5, G.shield + 2); G.fxDirty = true; sfx.shield(); break;
        default: applyEffect(id, p.dur);
      }
    }
    function triggerBoosterMidGame(id) {
      if (!G || (G.state !== 'play' && G.state !== 'ready')) return;
      if (!(S.inv[id] > 0)) { sfx.deny(); toast('Out of ' + id + ' boosters — visit Shop', 'bag', 'warn'); return }
      if (!G.launched) {
        G.queued[id] = !G.queued[id]; sfx.click(); haptic(5); renderBoostBar(); return;
      }
      S.inv[id]--; saveNow();
      applyPower(id === 'heart' ? 'life' : id, true);
      renderBoostBar();
    }
    function consumeBoosters() {
      for (const id in G.queued) {
        if (!G.queued[id] || !(S.inv[id] > 0)) continue;
        S.inv[id]--; S.stats.boostersUsed++; markDirty();
        if (id === 'heart') { G.lives = Math.min(6, G.lives + 1); G.maxLives = Math.max(G.maxLives, G.lives); G.livesDirty = true }
        else if (id === 'wide') applyEffect('wide', 14);
        else if (id === 'slow') applyEffect('slow', 10);
        else if (id === 'laser') applyEffect('laser', 12);
        else if (id === 'fire') applyEffect('fire', 10);
        else if (id === 'shield') { G.shield = Math.min(5, G.shield + 2); G.fxDirty = true }
        else if (id === 'multi') splitBalls();
      }
      G.queued = {}; saveNow(); renderBoostBar();
    }
    function launchBalls() {
      if (!G) return;
      const sticky = G.balls.filter(b => b.sticky); if (!sticky.length) return;
      const spd = ballSpeed(), pw = G.paddle.w;
      for (const b of sticky) {
        const rel = clamp(b.off / (pw / 2), -1, 1), ang = rel * .9 + (R() - .5) * .06;
        b.vx = Math.sin(ang) * spd; b.vy = -Math.cos(ang) * spd;
        if (Math.abs(b.vx) < spd * .05) { b.vx = (R() < .5 ? -1 : 1) * spd * .08; b.vy = -Math.sqrt(spd * spd - b.vx * b.vx) }
        b.sticky = false;
      }
      if (G.state === 'ready') {
        if (!G.launched) { G.launched = true; consumeBoosters() }
        G.state = 'play'; renderBoostBar();
      }
      sfx.launch(); haptic(8);
    }

    /* ---------- BRICKS ---------- */
    function brickAt(c, r) { for (const b of G.bricks) if (b.c === c && b.r === r) return b; return null }
    function hitBrick(b, dmg, src) {
      if (!b.alive) return;
      if (b.code === 5 && src !== 'fire') { sparkFX(b.rx + BW / 2, b.y + BH / 2, '#C7D2F5', 4); sfx.steel(); return }
      b.hp -= dmg;
      if (b.hp <= 0) killBrick(b, src);
      else { sparkFX(b.rx + BW / 2, b.y + BH / 2, codeColor(b, WORLDS[G.wi].hues), 3); sfx.pop(Math.max(0, G.combo - 1)) }
    }
    function killBrick(b, src) {
      if (!b.alive) return; b.alive = false;
      const hues = WORLDS[G.wi].hues, col = codeColor(b, hues);
      if (b.code !== 5) G.breakable--;
      G.combo++; G.comboT = 3.2; G.mult = Math.min(8, 1 + Math.floor(G.combo / 5));
      if (G.combo > S.stats.bestCombo) { S.stats.bestCombo = G.combo; markDirty() }
      G.bestComboRun = Math.max(G.bestComboRun, G.combo);
      const base = { 1: 12, 2: 24, 3: 40, 4: 30, 5: 60, 6: 20, 7: 20, 8: 120 }[b.code] || 12;
      const pts = base * G.mult; G.score += pts;
      const cn = { 1: 1, 2: 2, 3: 3, 4: 2, 5: 3, 6: 12, 7: 2, 8: 15 }[b.code] || 1;
      addCoins(cn); G.coinsRun += cn;
      const xpGain = { 1: 2, 2: 4, 3: 6, 4: 5, 5: 8, 6: 4, 7: 4, 8: 20 }[b.code] || 2;
      G.xpRun += xpGain;
      G.bricksRun++; S.stats.bricks++; S.daily.bricks++;
      const bt = S.stats.brickTypes;
      if (b.code === 1) bt.normal++; else if (b.code === 2 || b.code === 3) bt.armored++; else if (b.code === 4) bt.explosive++;
      else if (b.code === 5) bt.steel++; else if (b.code === 6) bt.gold++; else if (b.code === 8) bt.core++; else bt.normal++;
      markDirty();
      brickBurst(b, col);
      pushText('+' + pts + (G.mult > 1 ? ' ×' + G.mult : ''), b.rx + BW / 2, b.y, shade(col === '#7C86A8' ? '#8B5CF6' : hues[b.r % 4], 40), 12);
      sfx.pop(G.combo);
      if (G.combo > 0 && G.combo % 5 === 0) { banner('COMBO ×' + G.mult, '#FF3D8A', .42); sfx.combo(G.mult); if (G.combo >= 10) shake(5) }
      if (b.code === 6) { coinFX(b.rx + BW / 2, b.y + BH / 2); sfx.coin() }
      if (b.code === 4) G.blastQ.push(b);
      if (b.code === 7 || (b.code !== 5 && R() < .135)) spawnDrop(b);
      if (G.breakable <= 0 && G.state === 'play') {
        if (G.mode === 'campaign' || G.mode === 'daily') doWin();
        else if (G.mode === 'timed') nextTimedStage();
        else waveClear();
      }
    }
    function processBlasts() {
      if (G.blasting || !G.blastQ.length) return; G.blasting = true;
      while (G.blastQ.length && G.state === 'play') {
        const e = G.blastQ.shift();
        explodeFX(e.rx + BW / 2, e.y + BH / 2); sfx.boom(); shake(12); G.flash = Math.max(G.flash, .2); haptic(18);
        for (let dr = -1; dr <= 1; dr++)for (let dc = -1; dc <= 1; dc++) {
          if (G.state !== 'play') break;
          if (!dr && !dc) continue;
          const nb = brickAt(e.c + dc, e.r + dr);
          if (nb && nb.alive) hitBrick(nb, 2, 'blast');
        }
      }
      G.blastQ.length = 0;
      G.blasting = false;
    }
    function spawnDrop(b) {
      const table = [['wide', 10], ['multi', 9], ['slow', 8], ['laser', 9], ['fire', 7], ['magnet', 6], ['shield', 6], ['life', 3], ['coin', 10]];
      const hazards = S.set.trapDrops !== false && (G.mode === 'campaign' ? (G.absWorld >= 4) : G.wave >= 3 || G.mode === 'daily');
      if (hazards) table.push(['fast', 7], ['shrink', 7]);
      let tot = 0; for (const t of table) tot += t[1];
      let roll = R() * tot, pick = 'coin';
      for (const t of table) { roll -= t[1]; if (roll <= 0) { pick = t[0]; break } }
      if (b.code === 7) { const good = table.filter(t => !POWERS[t[0]].bad); pick = good[(R() * good.length) | 0][0] }
      G.drops.push({ x: b.rx + BW / 2, y: b.y + BH / 2, type: pick, seed: R() * 6.28 });
    }

    /* ---------- PARTICLES & EFFECTS ---------- */
    function pushPart(p) { if (S.set.reducedMotion && p.type !== 'ring') return; if (G.parts.length >= MAXP()) G.parts.shift(); G.parts.push(p) }
    function brickBurst(b, col) {
      const n = S.set.fx ? 10 : 4;
      for (let i = 0; i < n; i++)pushPart({ type: 'shard', x: b.rx + R() * BW, y: b.y + R() * BH, vx: (R() - .5) * 220, vy: -R() * 160 - 30, g: 420, t: 0, life: .5 + R() * .3, size: 3 + R() * 3.8, color: R() < .5 ? col : shade(b.code === 5 ? '#7C86A8' : WORLDS[G.wi].hues[b.r % 4], 30), rot: R() * 6.28, vr: (R() - .5) * 12 });
      pushPart({ type: 'ring', x: b.rx + BW / 2, y: b.y + BH / 2, t: 0, life: .28, size: 6, grow: 120, color: col });
    }
    function sparkFX(x, y, col, n) { for (let i = 0; i < n; i++)pushPart({ type: 'spark', x, y, vx: (R() - .5) * 240, vy: (R() - .5) * 240, g: 0, t: 0, life: .2 + R() * .14, size: 2, color: col }) }
    function explodeFX(x, y) {
      pushPart({ type: 'ring', x, y, t: 0, life: .45, size: 10, grow: 330, color: '#FFB020' });
      pushPart({ type: 'ring', x, y, t: 0, life: .3, size: 6, grow: 210, color: '#FF4D5E' });
      const n = S.set.fx ? 20 : 8;
      for (let i = 0; i < n; i++) { const a = R() * 6.28, s = 60 + R() * 230; pushPart({ type: 'ember', x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, g: 160, t: 0, life: .38 + R() * .35, size: 2 + R() * 3.2, color: R() < .5 ? '#FFB020' : '#FF6B35' }) }
    }
    function catchFX(x, y, col) { for (let i = 0; i < (S.set.fx ? 10 : 4); i++) { const a = R() * 6.28, s = 40 + R() * 130; pushPart({ type: 'ember', x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 60, g: 220, t: 0, life: .36 + R() * .28, size: 2 + R() * 2.2, color: col }) } }
    function coinFX(x, y) { for (let i = 0; i < (S.set.fx ? 7 : 3); i++)pushPart({ type: 'ember', x, y, vx: (R() - .5) * 150, vy: -R() * 190 - 40, g: 380, t: 0, life: .46 + R() * .25, size: 2.5 + R() * 2, color: '#FFC53D' }) }
    function wallFX(b) { if (S.set.fx) pushPart({ type: 'ember', x: b.x, y: b.y, vx: (R() - .5) * 60, vy: (R() - .5) * 60, g: 0, t: 0, life: .2, size: 2, color: '#8B5CF6' }) }
    function paddleFX(b) { for (let i = 0; i < (S.set.fx ? 5 : 2); i++)pushPart({ type: 'ember', x: b.x, y: G.paddle.y, vx: (R() - .5) * 120, vy: -R() * 80, g: 200, t: 0, life: .28, size: 2, color: skin().c[0] }) }
    function shieldFX(b) { pushPart({ type: 'ring', x: b.x, y: VH - 24, t: 0, life: .4, size: 8, grow: 190, color: '#22D3EE' }); sparkFX(b.x, VH - 24, '#8B5CF6', 7) }
    function ballBurst(b) { for (let i = 0; i < (S.set.fx ? 12 : 5); i++) { const a = R() * 6.28, s = 60 + R() * 190; pushPart({ type: 'ember', x: b.x, y: b.y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, g: 200, t: 0, life: .46, size: 2.5, color: skin().c[2] }) } }
    function confettiFX() {
      const n = (RM_SYS || S.set.reducedMotion) ? 25 : (S.set.fx ? 130 : 60), cols = [...WORLDS[G.wi].hues, '#FFFFFF', '#FFC53D'];
      for (let i = 0; i < n; i++)pushPart({ type: 'confetti', x: R() * VW, y: -20 - R() * VH * .3, vx: (R() - .5) * 120, vy: 60 + R() * 160, g: 150, t: 0, life: 2 + R() * 1.4, size: 4 + R() * 4.5, color: cols[(R() * cols.length) | 0], rot: R() * 6.28, vr: (R() - .5) * 10, sway: R() * 6.28 });
    }
    function pushText(str, x, y, color, size) { if (S.set.floatTexts === false) return; G.texts.push({ str, x, y, color, size: size || 12, t: 0, life: .85, banner: false }) }
    function banner(str, color, yf) { G.texts.push({ str, x: VW / 2, y: VH * (yf || .34), color: color || '#fff', size: 26, t: 0, life: 1.45, banner: true }) }
    function shake(n) {
      if (!S.set.shake || S.set.reducedMotion) return;
      const mult = ((S.set.shakePct ?? 100) / 100) * (RM_SYS ? .2 : (S.set.fx ? 1 : .45));
      G.shake = Math.max(G.shake, n * mult);
    }

    /* ---------- WIN / LOSE / MODES ---------- */
    function recordRunStats(won) {
      if (!G.countedGame) { S.stats.gamesPlayed++; G.countedGame = true }
      if (won && !G.countedWin) { S.stats.gamesWon++; G.countedWin = true }
      const scoreDelta = Math.max(0, G.score - (G.scoreRecorded || 0));
      S.stats.totalScore += scoreDelta;
      G.scoreRecorded = G.score;
      S.stats.bestScore = Math.max(S.stats.bestScore, G.score);
      if (!G.comboRecorded) { S.stats.comboSum += G.bestComboRun; S.stats.comboRuns++; G.comboRecorded = true }
      S.stats.playtime += G.runT; G.lastRunT += G.runT; G.runT = 0;
      S.recentRuns.push({ mode: G.mode, score: G.score, bricks: G.bricksRun, won, at: Date.now() });
      if (S.recentRuns.length > 10) S.recentRuns.shift();
      if (G.mode === 'endless') { S.stats.endlessBest = Math.max(S.stats.endlessBest, G.score); S.stats.endlessWave = Math.max(S.stats.endlessWave, G.wave) }
      else if (G.mode === 'timed') { S.stats.timedBest = Math.max(S.stats.timedBest, G.score) }
      else if (G.mode === 'daily') { S.stats.dailyBest = Math.max(S.stats.dailyBest, G.score) }
      else { S.bestLevelScore[G.idx] = Math.max(S.bestLevelScore[G.idx] || 0, G.score) }
    }
    function doWin() {
      if (G.state !== 'play') return;
      G.state = 'won'; G.winT = 1.0; G.sheetShown = false;
      for (const b of G.balls) ballBurst(b); G.balls.length = 0; G.drops.length = 0; G.lasers.length = 0;
      confettiFX(); sfx.win(); haptic([15, 30, 15, 30, 60]); shake(7);
      const stars = G.deaths === 0 ? 3 : G.deaths === 1 ? 2 : 1;
      G.earnedStars = stars;
      if (G.mode === 'campaign') {
        const prev = S.stars[G.idx] || 0; G.newBest = stars > prev;
        S.stars[G.idx] = Math.max(prev, stars);
        if (stars === 3) S.stats.perfectClears++;
        if (G.boss) S.stats.bossesDefeated++;
      } else if (G.mode === 'daily') {
        if (!S.daily.challengeDone) { S.daily.challengeDone = true; S.stats.dailyWins++ }
      }
      S.daily.wins++;
      const bonusBase = G.mode === 'daily' ? 160 : (25 + stars * 15 + G.sector * 15);
      const flaw = stars === 3 ? 25 : 0, bossB = G.boss ? 80 : 0;
      G.bonusBase = bonusBase; G.flaw = flaw; G.bossB = bossB;
      const unrewardedXp = Math.max(0, G.xpRun - (G.xpAwarded || 0));
      const xpTotal = unrewardedXp + (G.boss ? 140 : 60) + stars * 25 + G.sector * 30;
      G.xpAwarded = G.xpRun;
      G.xpTotal = xpTotal;
      recordRunStats(true);
      addCoins(bonusBase + flaw + bossB);
      addXP(xpTotal);
      for (let i = 0; i < stars; i++)sfx.star(i);
      banner(stars === 3 ? 'FLAWLESS!' : 'LEVEL CLEAR!', stars === 3 ? '#A3E635' : '#22D3EE');
      saveNow(); updateBadges();
    }
    function doLose(reason) {
      if (G.state !== 'play' && G.state !== 'ready') return;
      G.state = 'lost'; G.loseT = .9; G.sheetShown = false; G.loseReason = reason;
      for (const b of G.balls) ballBurst(b); G.balls.length = 0;
      shake(12); if (S.set.hitFlash !== false) G.flash = .16; sfx.lose(); haptic([30, 40, 30]);
      const prevBest = G.mode === 'endless' ? S.stats.endlessBest : (G.mode === 'timed' ? S.stats.timedBest : 0);
      G.newRecord = (G.mode === 'endless' || G.mode === 'timed') && G.score > prevBest;
      recordRunStats(false);
      const unrewardedXp = Math.max(0, G.xpRun - (G.xpAwarded || 0));
      G.xpAwarded = G.xpRun;
      addXP(unrewardedXp);
      saveNow(); updateBadges();
    }
    function loseLife() {
      G.deaths++; S.stats.ballsLost++; markDirty();
      clearTimedEffects(); G.drops.length = 0; G.lasers.length = 0;
      G.lives--; G.livesDirty = true; shake(9); sfx.lifeLost(); haptic([25, 35, 25]);
      if (G.lives > 0) { spawnBall(); G.state = 'ready'; banner('BALL LOST', '#FF4D5E', .42) }
      else doLose('balls');
    }
    function waveClear() {
      G.wave++; G.waveDelay = .75; G.labelDirty = true;
      G.speedBase += 11; G.descInt = Math.max(5.5, 14 - G.wave * .45); G.descT = G.descInt;
      S.stats.endlessWave = Math.max(S.stats.endlessWave, G.wave - 1); S.daily.wins++; markDirty();
      banner('WAVE ' + G.wave, '#A3E635'); sfx.wave();
      if (G.wave % 3 === 1 && G.wave > 1) { G.lives = Math.min(6, G.lives + 1); G.maxLives = Math.max(G.maxLives, G.lives); G.livesDirty = true; pushText('+1 LIFE', VW / 2, VH * .45, '#FF4D5E', 16); sfx.life() }
      const rw = 15 + G.wave * 4; addCoins(rw); G.coinsRun += rw; addXP(40 + G.wave * 10);
    }
    function ensureBallsBelowGrid() {
      const safeY = TOP + G.rows * (BH + VGAP) + 28;
      for (const b of G.balls) {
        if (!b.sticky && b.y < safeY) { b.y = Math.min(G.paddle.y - 24, safeY); if (b.vy < 0) b.vy = Math.abs(b.vy) }
      }
    }
    function nextTimedStage() {
      G.timedRound++; G.timeLeft += 20; S.daily.wins++;
      const lvl = genTimeAttack(G.timedRound);
      G.wi = lvl.wi; G.bricks = lvl.bricks.map(b => ({ ...b, hp: b.mhp, alive: true, rx: b.x }));
      G.breakable = lvl.breakable; G.rows = lvl.rows; G.name = lvl.name; G.labelDirty = true;
      G.blastQ.length = 0; G.lasers.length = 0; ensureBallsBelowGrid();
      G.speedBase += 14; addCoins(30); G.coinsRun += 30; addXP(55);
      banner('+20s · STAGE ' + (G.timedRound + 1), '#FFB020'); sfx.wave();
      buildSprites(G.wi); resize();
    }
    function spawnWave() {
      const lvl = genEndless(G.wave);
      G.wi = lvl.wi; G.bricks = lvl.bricks.map(b => ({ ...b, hp: b.mhp, alive: true, rx: b.x }));
      G.breakable = lvl.breakable; G.rows = lvl.rows; G.name = lvl.name;
      G.blastQ.length = 0; G.lasers.length = 0; ensureBallsBelowGrid();
      buildSprites(G.wi); resize();
    }

    /* ---------- MAIN UPDATE ---------- */
    function update(dt) {
      if (!G || G.state === 'paused') return;
      G.t += dt;
      const playing = G.state === 'play', ready = G.state === 'ready';
      if (playing || ready) {
        G.runT += dt;
        if (playing) {
          G.ramp = Math.min(100, G.ramp + dt * 1.3);
          if (G.mode === 'timed' || G.mode === 'daily') {
            G.timeLeft -= dt;
            if (G.timeLeft <= 0) { G.timeLeft = 0; doLose('time'); return }
          }
        }
        const p = G.paddle;
        const kSpd = 560 * ((S.set.keySpeedPct ?? 100) / 100) * (S.set.invertControls ? -1 : 1);
        if (keys.l) p.tx -= kSpd * dt; if (keys.r) p.tx += kSpd * dt;
        const tw = paddleTargetW();
        if (Math.abs(p.w - tw) > .5) { p.w = tw; buildPaddleSprite() }
        p.tx = clamp(p.tx, p.w / 2 + 4, VW - p.w / 2 - 4);
        p.x = lerp(p.x, p.tx, 1 - Math.exp(-20 * dt));
        p.pulse = Math.max(0, p.pulse - dt * 5);
        for (const id in G.fx) { G.fx[id].t -= dt; if (G.fx[id].t <= 0) { delete G.fx[id]; G.fxDirty = true } }
        if (G.comboT > 0) { G.comboT -= dt; if (G.comboT <= 0) { G.combo = 0; G.mult = 1 } }
        for (const b of G.bricks) { if (!b.alive) continue; b.rx = b.moveAmp ? b.x + Math.sin(G.t * b.moveSpd + b.movePh) * b.moveAmp : b.x }
        if (G.fx.laser && playing) {
          G.laserAcc += dt;
          while (G.laserAcc > .46) { G.laserAcc -= .46; G.lasers.push({ x: p.x - p.w * .42, y: p.y - 6 }, { x: p.x + p.w * .42, y: p.y - 6 }); sfx.laser() }
        }
        for (let i = G.lasers.length - 1; i >= 0; i--) {
          const L = G.lasers[i]; L.y -= 780 * dt;
          let dead = L.y < topWall;
          if (!dead) for (const b of G.bricks) {
            if (!b.alive) continue;
            if (L.x >= b.rx && L.x <= b.rx + BW && L.y <= b.y + BH && L.y >= b.y - 8) { hitBrick(b, 1, 'laser'); sparkFX(L.x, b.y + BH, '#FF3D8A', 3); dead = true; break }
          }
          if (dead) G.lasers.splice(i, 1);
        }
        processBlasts();
        for (let i = G.drops.length - 1; i >= 0; i--) {
          const d = G.drops[i];
          d.y += (152 + (G.mode === 'endless' ? G.wave * 4 : 0)) * dt; d.x += Math.sin(G.t * 3 + d.seed) * 14 * dt;
          if (Math.abs(d.x - p.x) < p.w / 2 + 14 && d.y + 16 >= p.y && d.y - 16 <= p.y + PH) { applyPower(d.type, false); G.drops.splice(i, 1); continue }
          if (d.y > VH + 24) G.drops.splice(i, 1);
        }
        updateBalls(dt);
        if (playing && G.mode === 'endless') {
          if (G.waveDelay > 0) { G.waveDelay -= dt; if (G.waveDelay <= 0) spawnWave() }
          else {
            G.descT -= dt;
            if (G.descT <= 0) {
              G.descT = G.descInt; let maxY = 0;
              for (const b of G.bricks) if (b.alive) { b.y += 20; maxY = Math.max(maxY, b.y + BH) }
              sfx.warn();
              if (maxY >= p.y - 8) { doLose('crushed'); return }
              if (maxY > p.y - 140) banner('THE WALL DESCENDS', '#FFB020', .5);
            }
          }
        }
      }
      if (G.state === 'won') { G.winT -= dt; if (G.winT <= 0 && !G.sheetShown) { G.sheetShown = true; openWinSheet() } }
      if (G.state === 'lost') { G.loseT -= dt; if (G.loseT <= 0 && !G.sheetShown) { G.sheetShown = true; openLoseSheet() } }
      for (let i = G.parts.length - 1; i >= 0; i--) {
        const q = G.parts[i]; q.t += dt;
        if (q.t >= q.life) { G.parts.splice(i, 1); continue }
        if (q.type !== 'ring') {
          q.vy += (q.g || 0) * dt; q.x += q.vx * dt; q.y += q.vy * dt;
          if (q.rot !== undefined) q.rot += q.vr * dt;
          if (q.type === 'confetti') q.x += Math.sin(q.t * 4 + q.sway) * 30 * dt;
        }
      }
      for (let i = G.texts.length - 1; i >= 0; i--) { const t = G.texts[i]; t.t += dt; if (t.t >= t.life) G.texts.splice(i, 1) }
      G.shake *= Math.exp(-6 * dt); if (G.shake < .1) G.shake = 0;
      G.flash = Math.max(0, G.flash - dt * 1.4);
    }
    function antiFlat(b) {
      const spd = Math.hypot(b.vx, b.vy) || 1;
      if (Math.abs(b.vy) < spd * .18) { const s = b.vy < 0 ? -1 : 1; b.vy = s * spd * .18; const vx = Math.sqrt(Math.max(0, spd * spd - b.vy * b.vy)); b.vx = (b.vx < 0 ? -1 : 1) * vx }
      if (Math.abs(b.vx) < spd * .05) { const s = b.vx < 0 ? -1 : (b.vx > 0 ? 1 : (R() < .5 ? -1 : 1)); b.vx = s * spd * .06; const vy = Math.sqrt(Math.max(0, spd * spd - b.vx * b.vx)); b.vy = (b.vy < 0 ? -1 : 1) * vy }
    }
    function updateBalls(dt) {
      const p = G.paddle, pw = p.w, px = p.x, py = p.y;
      for (let i = G.balls.length - 1; i >= 0; i--) {
        const b = G.balls[i];
        if (b.sticky) { b.x = clamp(px + b.off, b.r + 2, VW - b.r - 2); b.y = py - b.r - 1; b.trail.length = 0; continue }
        const spd = ballSpeed(), m = Math.hypot(b.vx, b.vy) || 1;
        b.vx = b.vx / m * spd; b.vy = b.vy / m * spd;
        const steps = Math.max(1, Math.ceil(spd * dt / 6)), sdt = dt / steps;
        let removed = false;
        for (let s = 0; s < steps; s++) {
          b.x += b.vx * sdt; b.y += b.vy * sdt;
          if (b.x < b.r) { b.x = b.r; b.vx = Math.abs(b.vx); sfx.wall(); wallFX(b) }
          else if (b.x > VW - b.r) { b.x = VW - b.r; b.vx = -Math.abs(b.vx); sfx.wall(); wallFX(b) }
          if (b.y < topWall + b.r) { b.y = topWall + b.r; b.vy = Math.abs(b.vy); sfx.wall(); wallFX(b) }
          if (G.shield > 0 && b.vy > 0 && b.y + b.r >= VH - 24) { b.y = VH - 24 - b.r; b.vy = -Math.abs(b.vy); G.shield--; G.fxDirty = true; sfx.shield(); shieldFX(b) }
          if (b.vy > 0 && b.y + b.r >= py && b.y - b.r <= py + PH && Math.abs(b.x - px) <= pw / 2 + b.r) {
            const rel = clamp((b.x - px) / (pw / 2), -1, 1), ang = rel * 1.05;
            b.vx = Math.sin(ang) * spd; b.vy = -Math.cos(ang) * spd; b.y = py - b.r - .5;
            antiFlat(b);
            if (G.combo > 0) { G.combo = 0; G.comboT = 0; G.mult = 1 }
            p.pulse = 1; sfx.paddle(); paddleFX(b);
            if (G.fx.magnet) { b.sticky = true; b.off = clamp(b.x - px, -pw / 2 + 8, pw / 2 - 8) }
            continue;
          }
          let bounced = false;
          for (const br of G.bricks) {
            if (!br.alive) continue;
            const bx = br.rx, by = br.y;
            if (b.y + b.r < by || b.y - b.r > by + BH || b.x + b.r < bx || b.x - b.r > bx + BW) continue;
            const nx = clamp(b.x, bx, bx + BW), ny = clamp(b.y, by, by + BH);
            const dx = b.x - nx, dy = b.y - ny, d2 = dx * dx + dy * dy;
            if (d2 > b.r * b.r) continue;
            if (G.fx.fire) { hitBrick(br, 99, 'fire'); continue }
            hitBrick(br, 1, 'ball');
            if (d2 > 1e-6) {
              const d = Math.sqrt(d2), ux = dx / d, uy = dy / d;
              b.x = nx + ux * (b.r + .05); b.y = ny + uy * (b.r + .05);
              const dot = b.vx * ux + b.vy * uy;
              if (dot < 0) { b.vx -= 2 * dot * ux; b.vy -= 2 * dot * uy }
            } else {
              const l = b.x - bx, rgt = bx + BW - b.x, tp = b.y - by, bt = by + BH - b.y, mn = Math.min(l, rgt, tp, bt);
              if (mn === l) { b.x = bx - b.r; b.vx = -Math.abs(b.vx) }
              else if (mn === rgt) { b.x = bx + BW + b.r; b.vx = Math.abs(b.vx) }
              else if (mn === tp) { b.y = by - b.r; b.vy = -Math.abs(b.vy) }
              else { b.y = by + BH + b.r; b.vy = Math.abs(b.vy) }
            }
            bounced = true; break;
          }
          processBlasts();
          if (bounced) antiFlat(b);
          if (b.y - b.r > VH + 10) { G.balls.splice(i, 1); removed = true; ballBurst(b); break }
          if (G.state !== 'play') break;
        }
        if (removed) continue;
        if (S.set.trail) { b.trail.push({ x: b.x, y: b.y }); if (b.trail.length > 10) b.trail.shift() }
        else b.trail.length = 0;
        if (G.fx.fire && S.set.fx && R() < .35) pushPart({ type: 'ember', x: b.x, y: b.y, vx: (R() - .5) * 40, vy: (R() - .5) * 40, g: -60, t: 0, life: .28, size: 2.4, color: R() < .5 ? '#FF8A3D' : '#FFB020' });
      }
      if (G.balls.length === 0 && G.state === 'play') loseLife();
    }

    /* ---------- RENDER ---------- */
    function render() {
      if (!G || !bgGrad) return;
      ctx.fillStyle = bgGrad; ctx.fillRect(-viewX - 2, 0, VW + viewX * 2 + 4, VH);
      ctx.save();
      if (G.shake > 0) ctx.translate((R() - .5) * G.shake, (R() - .5) * G.shake);
      if (S.set.bgStars !== false) {
        for (const s of G.stars) {
          const y = (s.y * VH + G.t * 6 * s.z) % VH;
          const x = -viewX + s.x * (VW + viewX * 2);
          ctx.globalAlpha = (.2 + .3 * (0.5 + 0.5 * Math.sin(G.t * 2 + s.tw))) * s.z;
          ctx.fillStyle = '#CFC6FF'; ctx.fillRect(x, y, s.z * 1.7, s.z * 1.7);
        }
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = S.set.fx ? .45 : .25;
      const drift = S.set.reducedMotion ? 0 : (S.set.fx ? 1 : .15);
      ctx.drawImage(auroraA, VW * .22 + Math.sin(G.t * .13 * drift) * 60 - 190, VH * .2 + Math.cos(G.t * .1 * drift) * 40 - 190, 380, 380);
      ctx.drawImage(auroraB, VW * .8 + Math.cos(G.t * .09 * drift) * 50 - 230, VH * .55 + Math.sin(G.t * .12 * drift) * 60 - 230, 460, 460);
      ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = 1;
      if (viewX > 2) {
        ctx.fillStyle = 'rgba(6, 3, 14, 0.45)';
        ctx.fillRect(-viewX - 2, 0, viewX + 2, VH);
        ctx.fillRect(VW, 0, viewX + 2, VH);
        ctx.strokeStyle = 'rgba(139, 92, 246, 0.45)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(0, 0); ctx.lineTo(0, VH);
        ctx.moveTo(VW, 0); ctx.lineTo(VW, VH);
        ctx.stroke();
      }
      if (G.shield > 0) {
        ctx.globalAlpha = .7 + .3 * Math.sin(G.t * 5);
        ctx.fillStyle = shieldGrad; ctx.fillRect(0, VH - 26, VW, 3.5);
        ctx.globalAlpha = .25; ctx.fillRect(0, VH - 30, VW, 11); ctx.globalAlpha = 1;
      }
      const cbMode = !!S.set.colorblindMode;
      for (const b of G.bricks) {
        if (!b.alive) continue;
        const spr = sprites.get(b.code + '_' + Math.min(b.hp, 3) + '_' + (b.r % 4));
        if (spr) ctx.drawImage(spr, b.rx, b.y, BW, BH);
        if (b.code === 8 && b.mhp > 1) {
          const pct = clamp(b.hp / b.mhp, 0, 1);
          ctx.fillStyle = 'rgba(0,0,0,.5)'; ctx.fillRect(b.rx + 3, b.y + BH - 4, BW - 6, 2.5);
          ctx.fillStyle = '#FFD166'; ctx.fillRect(b.rx + 3, b.y + BH - 4, (BW - 6) * pct, 2.5);
        }
        if (cbMode && b.code > 1) {
          const sym = { 2: '2', 3: '3', 4: 'B', 5: 'X', 6: '$', 7: '?', 8: '★' }[b.code] || '';
          if (sym) {
            ctx.fillStyle = '#FFFFFF'; ctx.font = '800 9px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillText(sym, b.rx + BW - 6, b.y + 6);
          }
        }
        if (b.code === 4) {
          ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = .22 + .15 * Math.sin(G.t * 6 + b.c);
          ctx.drawImage(glowOrange, b.rx + BW / 2 - 17, b.y + BH / 2 - 17, 34, 34); ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = 1
        }
        if (b.code === 7) {
          ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = .18 + .13 * Math.sin(G.t * 4 + b.r);
          ctx.drawImage(glowMagenta, b.rx + BW / 2 - 16, b.y + BH / 2 - 16, 32, 32); ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = 1
        }
      }
      for (const d of G.drops) {
        ctx.save(); ctx.translate(d.x, d.y); ctx.rotate(Math.sin(G.t * 3 + d.seed) * .16);
        const spr = dropSprites[d.type]; if (spr) ctx.drawImage(spr, -16, -20, 32, 40);
        if (cbMode) {
          ctx.fillStyle = '#0B0716'; ctx.font = '900 8px sans-serif'; ctx.textAlign = 'center';
          ctx.fillText(d.type.slice(0, 2).toUpperCase(), 0, -9);
        }
        ctx.restore();
      }
      for (const L of G.lasers) {
        ctx.fillStyle = 'rgba(255,61,138,.35)'; ctx.fillRect(L.x - 3, L.y - 14, 6, 18);
        ctx.fillStyle = '#FF9EC4'; ctx.fillRect(L.x - 1.2, L.y - 12, 2.4, 14);
      }
      if (paddleSprite) {
        const p = G.paddle, m = paddleSprite.m, pu = p.pulse;
        const w = (p.w + m * 2) * (1 + .04 * pu), h = (PH + m * 2) * (1 + .28 * pu);
        ctx.drawImage(paddleSprite.cnv, p.x - w / 2, p.y + PH / 2 - h / 2, w, h);
      }
      const fire = !!G.fx.fire;
      for (const b of G.balls) {
        ctx.globalCompositeOperation = 'lighter';
        const tc = fire ? 'rgba(255,138,61,' : trailCol;
        for (let i = 0; i < b.trail.length; i++) {
          const tr = b.trail[i], f = i / b.trail.length;
          ctx.globalAlpha = f * .28; ctx.fillStyle = tc + '1)';
          ctx.beginPath(); ctx.arc(tr.x, tr.y, b.r * f * .85, 0, 7); ctx.fill();
        }
        ctx.globalAlpha = .9; ctx.drawImage(fire ? fireSprite : ballSprite, b.x - 24, b.y - 24, 48, 48);
        ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = 1;
        ctx.fillStyle = fire ? '#FFE0B8' : '#FFFFFF'; ctx.beginPath(); ctx.arc(b.x, b.y, b.r * .85, 0, 7); ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,.9)'; ctx.beginPath(); ctx.arc(b.x - 2, b.y - 2.5, 2, 0, 7); ctx.fill();
      }
      const stickyB = G.balls.find(b => b.sticky);
      if (stickyB && (G.state === 'ready' || G.state === 'play') && S.set.aimGuide !== 'off') {
        const rel = clamp(stickyB.off / (G.paddle.w / 2), -1, 1), ang = rel * .9;
        let dx = Math.sin(ang), dy = -Math.cos(ang);
        const steps = S.set.aimGuide === 'short' ? 6 : 14;
        let cx = stickyB.x, cy = stickyB.y;
        ctx.fillStyle = 'rgba(255,255,255,.78)';
        for (let i = 1; i <= steps; i++) {
          cx += dx * 16; cy += dy * 16;
          if (cx < BALL_R) { cx = BALL_R + (BALL_R - cx); dx = -dx }
          else if (cx > VW - BALL_R) { cx = (VW - BALL_R) - (cx - (VW - BALL_R)); dx = -dx }
          if (cy < topWall + BALL_R) break;
          ctx.globalAlpha = .8 * (1 - i / (steps + 2));
          ctx.beginPath(); ctx.arc(cx, cy, 2.3, 0, 7); ctx.fill();
        }
        ctx.globalAlpha = 1;
      }
      for (const q of G.parts) {
        const f = 1 - q.t / q.life;
        if (q.type === 'shard' || q.type === 'confetti') {
          ctx.save(); ctx.translate(q.x, q.y); ctx.rotate(q.rot);
          ctx.globalAlpha = Math.min(1, f * 1.6); ctx.fillStyle = q.color;
          ctx.fillRect(-q.size / 2, -q.size / 2, q.size, q.type === 'confetti' ? q.size * .6 : q.size);
          ctx.restore();
        } else if (q.type === 'spark') {
          ctx.globalAlpha = f; ctx.strokeStyle = q.color; ctx.lineWidth = 1.6;
          ctx.beginPath(); ctx.moveTo(q.x, q.y); ctx.lineTo(q.x - q.vx * .03, q.y - q.vy * .03); ctx.stroke();
        } else if (q.type === 'ring') {
          ctx.globalAlpha = f * .8; ctx.strokeStyle = q.color; ctx.lineWidth = 2.4 * f + .5;
          ctx.beginPath(); ctx.arc(q.x, q.y, q.size + q.grow * q.t, 0, 7); ctx.stroke();
        } else {
          ctx.globalAlpha = f; ctx.fillStyle = q.color;
          ctx.beginPath(); ctx.arc(q.x, q.y, q.size * f + .4, 0, 7); ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
      for (const t of G.texts) {
        const age = t.t, f = 1 - age / t.life;
        if (t.banner) {
          const sc = age < .25 ? (1.5 - 0.5 * (age / .25)) : 1;
          ctx.save(); ctx.translate(t.x, t.y); ctx.scale(sc, sc);
          ctx.globalAlpha = age > t.life - .4 ? (t.life - age) / .4 : 1;
          ctx.font = '900 ' + t.size + 'px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
          ctx.lineWidth = 5; ctx.strokeStyle = 'rgba(8,4,18,.65)'; ctx.strokeText(t.str, 0, 0);
          ctx.fillStyle = t.color; ctx.fillText(t.str, 0, 0);
          ctx.restore();
        } else {
          ctx.globalAlpha = Math.min(1, f * 2);
          ctx.font = '800 ' + t.size + 'px sans-serif'; ctx.textAlign = 'center';
          ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(8,4,18,.55)';
          const y = t.y - age * 42;
          ctx.strokeText(t.str, t.x, y); ctx.fillStyle = t.color; ctx.fillText(t.str, t.x, y);
        }
      }
      ctx.globalAlpha = 1;
      ctx.restore();
      if (G.flash > 0 && S.set.hitFlash !== false) { ctx.globalAlpha = G.flash; ctx.fillStyle = '#FFF3E0'; ctx.fillRect(-viewX, 0, VW + viewX * 2, VH); ctx.globalAlpha = 1 }
    }

    /* ---------- HUD ---------- */
    function renderLives() {
      if (!G) return;
      let h = '';
      for (let i = 0; i < Math.max(G.maxLives, G.lives); i++)h += '<span class="ic' + (i < G.lives ? '' : ' empty') + '"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + I.heart + '</svg></span>';
      $('#hudLives').innerHTML = h;
      $('#vignette').classList.toggle('danger', G.lives === 1);
    }
    function renderFxChips() {
      let h = '';
      for (const id in G.fx) {
        const p = POWERS[id];
        h += '<span class="fx-chip" data-fx="' + id + '" style="--fc:' + p.color + '">' + icon(p.icon) + p.name.split(' ')[0] + '<i class="fx-bar"></i></span>';
      }
      if (G.shield > 0) h += '<span class="fx-chip" style="--fc:#8B5CF6">' + icon('shield') + 'Shield ×' + G.shield + '</span>';
      $('#hudFx').innerHTML = h;
    }
    function renderBoostBar() {
      if (!G) return;
      const bar = $('#boostBar');
      if (S.set.showBoostBar === false) { bar.classList.remove('show'); return }
      const owned = BOOSTERS.filter(b => S.inv[b.id] > 0).slice(0, 5);
      if (!owned.length) { bar.classList.remove('show'); return }
      bar.classList.add('show');
      $('#boostBarLabel').textContent = G.launched ? 'BOOST (1-5):' : 'ARM (1-5):';
      $('#boostRow').innerHTML = owned.map((b, i) => '<button class="chip-btn' + (G.queued[b.id] ? ' armed' : '') + '" data-action="boost" data-arg="' + b.id + '">' + icon(b.icon) + b.name.split(' ')[0] + ' ×' + S.inv[b.id] + '</button>').join('');
    }
    function syncHUD(force) {
      if (!G) return;
      if (G.score !== G.scoreShown || force) { G.scoreShown = G.score; $('#hudScore').textContent = fmt(G.score) }
      if (G.coinsRun !== G.coinsShown || force) { G.coinsShown = G.coinsRun; $('#hudCoinsVal').textContent = fmt(G.coinsRun) }
      const tEl = $('#hudTimer');
      if (G.mode === 'timed' || G.mode === 'daily') { tEl.classList.add('show'); tEl.textContent = '⏱ ' + fmtTime(G.timeLeft) }
      else tEl.classList.remove('show');
      if (G.labelDirty || force) {
        G.labelDirty = false;
        const lbl = G.mode === 'campaign' ? ('LVL ' + (G.idx + 1) + ' · S' + (G.sector + 1) + ' · ' + G.name) : G.mode === 'endless' ? ('ENDLESS · WAVE ' + G.wave) : G.mode === 'timed' ? ('TIME ATTACK · STAGE ' + (G.timedRound + 1)) : 'DAILY CHALLENGE';
        $('#hudLevel').textContent = lbl;
      }
      if (G.livesDirty || force) { G.livesDirty = false; renderLives() }
      if (G.fxDirty || force) { G.fxDirty = false; renderFxChips() }
      for (const id in G.fx) {
        const el = document.querySelector('.fx-chip[data-fx="' + id + '"] .fx-bar');
        if (el) el.style.width = Math.max(0, G.fx[id].t / G.fx[id].dur * 100) + '%'
      }
      const showCombo = G.combo >= 3, hc = $('#hudCombo');
      hc.classList.toggle('show', showCombo);
      if (showCombo) {
        if (G.combo !== G.comboShown) { G.comboShown = G.combo; $('#comboMult').textContent = '×' + G.mult + ' · ' + G.combo }
        $('#comboBar').style.width = Math.max(0, G.comboT / 3.2 * 100) + '%';
      } else G.comboShown = -1;
      const hint = $('#gameHint');
      let mode = '';
      if (G.state === 'ready') mode = 'Drag to move · Tap or Space to launch';
      else if (G.state === 'play' && G.balls.some(b => b.sticky)) mode = 'Magnet hold — tap to release';
      if (mode !== G.hintMode) { G.hintMode = mode; if (mode) { hint.textContent = mode; hint.classList.remove('hide') } else hint.classList.add('hide') }
    }

    /* ---------- SHEETS ---------- */
    function openPause() {
      if (!G || (G.state !== 'play' && G.state !== 'ready')) return;
      if (UI.sheet === 'pause') { actions.resume(); return }
      G.prevState = G.state; G.state = 'paused';
      const d = DIFFS[S.set.diff] || DIFFS.classic;
      openSheet('<div class="grabber"></div><div class="sheet-head"><div class="sheet-kicker" style="color:var(--cyan)">' + (G.mode === 'campaign' ? 'LEVEL ' + (G.idx + 1) + ' · ' + G.name : G.mode.toUpperCase()) + '</div><h2 class="sheet-title">Game Paused</h2></div>' +
        '<div class="quick-rows">' +
        swRow('sfx', 'Sound FX', 'Pops, zaps & booms', 'zap', S.set.sfx) +
        swRow('bgm', 'Synthwave Music', 'Procedural arcade soundtrack', 'music', S.set.bgm) +
        swRow('haptics', 'Haptics', 'Vibration feedback', 'vibrate', S.set.haptics) +
        '</div>' +
        '<div class="pause-note">' + icon(d.icon) + ' Difficulty: <b>&nbsp;' + d.label + '</b> &nbsp;·&nbsp; Speed: <b>' + (S.set.ballSpeedPct ?? 100) + '%</b></div>' +
        '<div class="sheet-btns"><button class="btn btn-primary" data-action="resume">' + icon('play') + ' Resume Game</button>' +
        '<div class="btn-row"><button class="btn btn-ghost" data-action="restart">' + icon('restart') + ' Restart</button>' +
        '<button class="btn btn-ghost" data-action="map">' + icon('grid') + ' Levels</button></div>' +
        '<div class="btn-row"><button class="btn btn-ghost" data-action="go-settings">' + icon('sliders') + ' Settings</button>' +
        '<button class="btn btn-danger" data-action="home">' + icon('home') + ' Quit to Home</button></div></div>', 'pause', 'resume');
      sfx.click();
    }
    function openWinSheet() {
      const w = WORLDS[G.wi], stars = G.earnedStars;
      const total = G.coinsRun + G.bonusBase + G.flaw + G.bossB;
      const kicker = G.mode === 'daily' ? 'DAILY CHALLENGE CLEARED' : (G.boss ? 'BOSS DEFEATED · LEVEL ' + (G.idx + 1) : 'LEVEL ' + (G.idx + 1) + ' · ' + G.name);
      const title = G.mode === 'daily' ? 'Daily Hero!' : (G.boss ? 'Boss Conquered!' : 'Level Clear!');
      openSheet('<div class="grabber"></div><div class="sheet-head"><div class="sheet-kicker" style="color:' + w.hues[0] + '">' + kicker + '</div><h2 class="sheet-title">' + title + '</h2>' +
        (G.newBest ? '<span class="tag-best">' + icon('sparkles') + ' NEW BEST</span>' : '') + '</div>' +
        '<div class="stars-row">' + [0, 1, 2].map(i => '<span class="big-star' + (i < stars ? ' earned' : '') + '">' + icon('star') + '</span>').join('') + '</div>' +
        '<div class="res-grid"><div class="res"><span>Score</span><b>' + fmt(G.score) + '</b></div><div class="res"><span>Rank XP</span><b>+' + fmt(G.xpTotal || 0) + '</b></div><div class="res"><span>Best Combo</span><b>×' + G.bestComboRun + '</b></div><div class="res"><span>Time</span><b>' + fmtTime(G.lastRunT) + '</b></div></div>' +
        '<div class="coin-lines"><div><span>' + icon('coin') + ' Bricks & Pickups</span><b>+' + G.coinsRun + '</b></div>' +
        '<div><span>' + icon('gift') + ' Clear Bonus</span><b>+' + G.bonusBase + '</b></div>' +
        (G.flaw ? '<div><span>' + icon('sparkles') + ' Flawless 3★</span><b>+' + G.flaw + '</b></div>' : '') +
        (G.bossB ? '<div><span>' + icon('crown') + ' Boss Bounty</span><b>+' + G.bossB + '</b></div>' : '') +
        '<div class="total"><span>Total Coins</span><b id="winCoins">0</b></div></div>' +
        '<div class="sheet-btns"><button class="btn btn-primary" data-action="' + (G.mode === 'daily' ? 'home' : 'next') + '">' + icon(G.mode === 'daily' ? 'home' : 'play') + ' ' + (G.mode === 'daily' ? 'Finish & Home' : 'Next Level (Lvl ' + (G.idx + 2) + ')') + '</button>' +
        '<div class="btn-row"><button class="btn btn-ghost" data-action="replay">' + icon('restart') + ' Replay</button>' +
        '<button class="btn btn-ghost" data-action="map">' + icon('grid') + ' Levels</button>' +
        '<button class="btn btn-danger" data-action="home">' + icon('home') + ' Quit</button></div></div>', 'win', null);
      let shown = 0; const el = $('#winCoins');
      UI.sheetTimer = setInterval(() => {
        shown = Math.min(total, shown + Math.max(1, Math.round(total / 30)));
        if (el) el.textContent = fmt(shown); if (shown >= total) clearInterval(UI.sheetTimer)
      }, 28);
      updateBadges();
    }
    function openLoseSheet() {
      const endless = G.mode === 'endless', timed = G.mode === 'timed';
      const canCont = G.mode === 'campaign' && !G.usedContinue && S.coins >= 50;
      const tip = TIPS[(R() * TIPS.length) | 0];
      const heading = G.loseReason === 'crushed' ? 'The Wall Reached You!' : G.loseReason === 'time' ? 'Time\'s Up!' : 'Out of Balls!';
      openSheet('<div class="grabber"></div><div class="sheet-head"><div class="sheet-kicker" style="color:var(--danger)">' + (endless ? 'ENDLESS · WAVE ' + G.wave : timed ? 'TIME ATTACK' : 'LEVEL ' + (G.idx + 1)) + '</div>' +
        '<h2 class="sheet-title">' + heading + '</h2>' +
        (G.newRecord ? '<span class="tag-best">' + icon('sparkles') + ' NEW RECORD</span>' : '') + '</div>' +
        '<div class="res-grid"><div class="res"><span>Score</span><b>' + fmt(G.score) + '</b></div><div class="res"><span>Bricks</span><b>' + G.bricksRun + '</b></div>' +
        '<div class="res"><span>Rank XP</span><b>+' + fmt(G.xpRun) + '</b></div><div class="res"><span>Best Combo</span><b>×' + G.bestComboRun + '</b></div></div>' +
        '<div class="lose-tip">' + icon('info') + '<span>' + tip + '</span></div>' +
        '<div class="sheet-btns">' +
        (canCont ? '<button class="btn btn-cyan" data-action="continue-run">' + icon('coin') + ' Continue — 50 Coins</button>' : '') +
        '<button class="btn btn-primary" data-action="replay">' + icon('restart') + ' Try Again</button>' +
        '<div class="btn-row"><button class="btn btn-ghost" data-action="map">' + icon('grid') + ' Levels</button>' +
        '<button class="btn btn-ghost" data-action="go-shop">' + icon('bag') + ' Shop</button>' +
        '<button class="btn btn-danger" data-action="home">' + icon('home') + ' Quit</button></div></div>', 'lose', null);
    }
    function openHelp() {
      const steps = [
        ['move', 'Drag / Keys / Tap', 'Steer with finger drag, direct cursor follow, tap sides, or ← → / A D keys.', '#22D3EE'],
        ['target', 'Launch & Aim Guide', 'Tap or press Space to launch. Use the trajectory guide & paddle edges for sharp angles.', '#A3E635'],
        ['zap', 'Unlimited Climb', 'Clear infinite levels, defeat bosses, customize every setting & climb unlimited ranks!', '#FF3D8A']
      ];
      const legend = Object.keys(POWERS).map(id => {
        const p = POWERS[id];
        return '<div class="leg-item"><span class="leg-ic" style="background:' + p.color + '">' + icon(p.icon) + '</span><div><b>' + p.name + '</b><p>' + p.desc + '</p></div></div>'
      }).join('');
      openSheet('<div class="grabber"></div><div class="sheet-head"><div class="sheet-kicker" style="color:var(--cyan)">HOW TO PLAY</div><h2 class="sheet-title">BrickPop Nova Ultimate</h2></div>' +
        '<div class="help-steps">' + steps.map(s => '<div class="hstep"><span class="hs-ic" style="background:' + s[3] + '">' + icon(s[0]) + '</span><div><b>' + s[1] + '</b><p>' + s[2] + '</p></div></div>').join('') + '</div>' +
        '<div class="sec-title" style="margin-top:4px">ALL 11 POWER-UPS &amp; TRAPS</div><div class="legend">' + legend + '</div>' +
        '<div class="hazard-note">' + icon('alert') + ' Red-ringed capsules are traps — dodge them! Keys 1–5 activate owned boosters mid-game.</div>' +
        '<div class="sheet-btns"><button class="btn btn-primary" data-action="close-sheet">' + icon('check') + ' Got It</button></div>', 'help', 'close-sheet');
    }
    function swRow(key, label, desc, ic, on) {
      return '<div class="sw-row"><span class="sw-ic">' + icon(ic) + '</span><div class="sw-info"><b>' + label + '</b><p>' + desc + '</p></div><label class="sw"><input type="checkbox" data-set="' + key + '"' + (on ? ' checked' : '') + ' aria-label="' + label + '"><i></i></label></div>';
    }

    /* ---------- SCREENS ---------- */
    function showScreen(name) {
      if (UI.sheet) closeSheet(true);
      UI.screen = name;
      $$('.screen').forEach(s => s.classList.toggle('active', s.id === 'screen-' + name));
      $('#app').classList.toggle('in-game', name === 'game');
      $$('.tab').forEach(t => t.classList.toggle('active', t.dataset.arg === name));
      if (name === 'home') renderHome();
      else if (name === 'levels') renderLevels();
      else if (name === 'shop') renderShop();
      else if (name === 'awards') renderAwards();
      else if (name === 'settings') renderSettings();
      else if (name === 'game') requestAnimationFrame(resize);
      const el = $('#screen-' + name); if (el) el.scrollTop = 0;
    }
    function syncHeader(pulse) {
      $('#coinVal').textContent = fmt(S.coins);
      const rk = rankForXP(S.xp);
      $('#hdrRank').textContent = rk.icon + ' ' + rk.title;
      if (pulse) { const c = $('.coins-chip'); c.classList.remove('pulse'); void c.offsetWidth; c.classList.add('pulse') }
    }
    function claimableCount() {
      ensureDaily();
      const a = ACHS.filter(x => !S.ach[x.id] && x.cur(S) >= x.max).length;
      const m = DAILY_MISSIONS.filter(x => !S.daily.claims.includes(x.id) && (S.daily[x.id] || 0) >= x.target).length;
      return a + m;
    }
    function updateBadges() { const n = claimableCount(), b = $('#badgeAwards'); b.hidden = n === 0; b.textContent = n }
    function starRow(n) { let h = ''; for (let i = 0; i < 3; i++)h += '<span class="ic' + (i < n ? ' on' : '') + '"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + I.star + '</svg></span>'; return h }

    function renderHome() {
      ensureDaily();
      const unlocked = getUnlocked(), lvl = getLevel(unlocked), w = WORLDS[lvl.wi];
      const ws = worldStars(lvl.absWorld), rk = rankForXP(S.xp);
      const claimed = S.daily.rewardClaimed;
      const nextStreak = claimed ? S.streak : (S.lastClaimDate === new Date(Date.now() - 864e5).toISOString().slice(0, 10) ? S.streak + 1 : 1);
      const reward = 100 + Math.min(nextStreak, 7) * 25;
      $('#screen-home').innerHTML =
        '<div class="dedication-strip">💛 Dedicated to my little Muhib Ullah · Created by Yasin Ullah</div>' +
        '<div class="hero" style="--wa:' + w.hues[0] + ';--wb:' + w.hues[2] + '"><div class="hero-kicker">' + icon('zap') + ' SECTOR ' + (lvl.sector + 1) + ' · WORLD ' + (lvl.wi + 1) + ' · ' + w.name.toUpperCase() + '</div>' +
        '<div class="hero-main"><div><div class="hero-num">LVL ' + (unlocked + 1) + '</div><div class="hero-name">' + lvl.name + '</div><div class="hero-sub">' + (lvl.boss ? '👑 Boss Battle · ' : '') + lvl.breakable + ' bricks · ' + DIFFS[S.set.diff].label + '</div></div>' +
        '<canvas class="hero-prev" id="heroPrev" width="216" height="144"></canvas></div>' +
        '<div class="hero-meta"><span>World Progress (Unlimited Campaign)</span><span>' + ws + ' / 45 ★</span></div>' +
        '<div class="hero-bar"><i style="width:' + (ws / 45 * 100) + '%"></i></div>' +
        '<button class="btn btn-primary" data-action="start-level" data-arg="' + unlocked + '">' + icon('play') + ' Play Level ' + (unlocked + 1) + '</button></div>' +

        '<div class="rank-banner" data-action="tab" data-arg="awards" style="cursor:pointer">' +
        '<div class="rank-emblem">' + rk.icon + '</div>' +
        '<div class="rank-info"><b>' + S.avatar + ' ' + S.name + ' · <span style="color:' + rk.color + '">' + rk.title + '</span></b>' +
        '<small>Rank Level ' + rk.level + ' · ' + fmt(rk.curXP) + ' / ' + fmt(rk.needed) + ' XP to next rank</small>' +
        '<div class="xp-bar"><i style="width:' + rk.pct + '%"></i></div></div></div>' +

        '<div class="card daily"><span class="daily-ic">' + icon(claimed ? 'check' : 'gift') + '</span><div class="daily-info"><b>Daily Check-in Gift</b><p>' + (claimed ? 'Claimed · ' + S.streak + '-day streak · come back tomorrow' : 'Day ' + nextStreak + ' streak · +' + reward + ' coins ready') + '</p></div>' +
        (claimed ? '<span class="pill">' + icon('calendar') + ' DONE</span>' : '<button class="btn btn-gold btn-sm" data-action="claim-daily">' + icon('coin') + ' Claim</button>') + '</div>' +

        '<div class="mode-grid">' +
        '<button class="mode endless" data-action="start-endless"><span class="m-ic">' + icon('infinity') + '</span><b>Endless Waves</b><span>Best: ' + fmt(S.stats.endlessBest) + ' · Wave ' + S.stats.endlessWave + '</span></button>' +
        '<button class="mode timed" data-action="start-timed"><span class="m-ic">' + icon('timer') + '</span><b>Time Attack</b><span>150s Rush · Best: ' + fmt(S.stats.timedBest) + '</span></button>' +
        '<button class="mode dailyc" data-action="start-daily"><span class="m-ic">' + icon('calendar') + '</span><b>Daily Challenge</b><span>' + (S.daily.challengeDone ? 'Completed today ✓' : 'New cosmic board today!') + '</span></button>' +
        '<button class="mode help" data-action="help"><span class="m-ic">' + icon('info') + '</span><b>How to Play</b><span>Controls, Bricks &amp; 11 Powers</span></button></div>' +

        '<div class="strip"><div class="stat-chip s1"><b>' + totalStars() + '</b><span>Total Stars</span></div><div class="stat-chip s2"><b>' + fmt(S.stats.bricks) + '</b><span>Bricks Broken</span></div><div class="stat-chip s3"><b>×' + S.stats.bestCombo + '</b><span>Best Combo</span></div></div>' +
        '<div class="card tip-card">' + icon('sparkles') + '<span id="tipText">' + TIPS[0] + '</span></div>' +
        '<p class="foot"><strong>BRICKPOP NOVA ULTIMATE</strong> · Unlimited Levels &amp; Ranks · 100% Offline<br>&copy; 2026 Yasin Ullah (Bannu Software Solutions) · Attribution Required</p>';
      const hp = $('#heroPrev'); if (hp) drawPreview(hp, unlocked);
    }

    function renderLevels() {
      const unlocked = getUnlocked();
      const maxAbsWorld = Math.floor(unlocked / 15);
      const sector = Math.floor(UI.absWorld / 8);
      const maxSector = Math.floor(maxAbsWorld / 8);
      const wi = UI.absWorld % 8, w = WORLDS[wi], ws = worldStars(UI.absWorld);
      let chips = '';
      for (let i = 0; i < 8; i++) {
        const aw = sector * 8 + i, ww = WORLDS[i], locked = aw * 15 > unlocked;
        chips += '<button class="wchip' + (aw === UI.absWorld ? ' active' : '') + (locked ? ' locked' : '') + '" data-action="world" data-arg="' + aw + '" style="--wa:' + ww.hues[0] + '"><span class="wchip-num">' + (i + 1) + '</span>' + ww.name + (locked ? icon('lock') : '') + '</button>';
      }
      let cells = '';
      for (let li = 0; li < 15; li++) {
        const idx = UI.absWorld * 15 + li, locked = idx > unlocked, st = S.stars[idx] || 0, next = idx === unlocked, boss = li === 14;
        if (UI.levelFilter === 'open' && locked) continue;
        if (UI.levelFilter === 'stars' && st < 3) continue;
        if (UI.levelFilter === 'boss' && !boss) continue;
        cells += '<button class="lvl' + (locked ? ' locked' : '') + (next ? ' next' : '') + (boss ? ' boss' : '') + '" data-action="start-level" data-arg="' + idx + '">' +
          '<canvas class="lvl-prev" data-idx="' + idx + '" width="132" height="88"></canvas>' +
          '<div class="lvl-meta"><span class="lvl-num">#' + (idx + 1) + '</span><span class="lvl-stars">' + starRow(st) + '</span></div>' +
          (locked ? '<span class="lvl-lock">' + icon('lock') + '</span>' : '') +
          (boss ? '<span class="lvl-boss">' + icon('crown') + '</span>' : '') +
          (next ? '<span class="lvl-play">PLAY</span>' : '') + '</button>';
      }
      $('#screen-levels').innerHTML =
        '<div><h1 class="big-title">Unlimited Levels</h1><p class="sub-title">' + clearedCount() + ' cleared · Highest unlocked: Level ' + (unlocked + 1) + ' · ' + totalStars() + ' ★</p></div>' +
        '<div class="sector-bar"><div class="sector-nav"><button class="btn btn-ghost btn-sm" data-action="sector-prev" ' + (sector <= 0 ? 'disabled' : '') + '>◀</button><span class="pill">SECTOR ' + (sector + 1) + '</span><button class="btn btn-ghost btn-sm" data-action="sector-next" ' + (sector >= maxSector + 1 ? 'disabled' : '') + '>▶</button></div>' +
        '<div class="filter-row">' + [['all', 'All'], ['open', 'Open'], ['stars', '3★'], ['boss', 'Boss']].map(f => '<button class="' + (UI.levelFilter === f[0] ? 'active' : '') + '" data-action="lvl-filter" data-arg="' + f[0] + '">' + f[1] + '</button>').join('') + '</div></div>' +
        '<div class="wchips" id="wchips">' + chips + '</div>' +
        '<div class="wbanner" style="--wa:' + w.hues[0] + ';--wb:' + w.hues[2] + '"><h3>Sector ' + (sector + 1) + ' · ' + w.name + '</h3><p>' + w.tag + ' · Difficulty ×' + (1 + sector * .35).toFixed(2) + ' · Boss: ' + BOSSES[wi].name + '</p>' +
        '<div class="wb-row"><div class="wb-bar"><i style="width:' + (ws / 45 * 100) + '%"></i></div><span class="wb-stars">' + icon('star') + ' ' + ws + '/45</span></div></div>' +
        '<div class="lvl-grid">' + (cells || '<p style="grid-column:1/-1;color:var(--muted);padding:20px;text-align:center">No levels match this filter in this world yet.</p>') + '</div>';
      $$('.lvl-prev').forEach(c => drawPreview(c, +c.dataset.idx));
    }

    function renderShop() {
      const items = BOOSTERS.map(b => {
        const cant = S.coins < b.price;
        return '<div class="shop-item"><span class="si-ic" style="background:linear-gradient(135deg,' + shade(b.color, 30) + ',' + b.color + ')">' + icon(b.icon) + (S.inv[b.id] > 0 ? '<span class="si-own">×' + S.inv[b.id] + '</span>' : '') + '</span>' +
          '<div class="si-info"><b>' + b.name + '</b><p>' + b.desc + '</p></div>' +
          '<button class="si-buy' + (cant ? ' cant' : '') + '" data-action="buy-booster" data-arg="' + b.id + '">' + icon('coin') + ' ' + b.price + '</button></div>';
      }).join('');
      const skins = SKINS.map(sk => {
        const owned = S.skins.includes(sk.id), eq = S.skin === sk.id;
        return '<div class="skin' + (eq ? ' equipped' : '') + '" style="--sc1:' + sk.c[0] + ';--sc2:' + sk.c[1] + ';--sc3:' + sk.c[2] + '">' +
          '<div class="skin-prev"><span class="skin-ball"></span><span class="skin-pad"></span></div><b>' + sk.name + '</b>' +
          (eq ? '<button class="btn btn-ghost btn-sm dis">' + icon('check') + ' Equipped</button>' :
            owned ? '<button class="btn btn-cyan btn-sm" data-action="equip-skin" data-arg="' + sk.id + '">' + icon('wand') + ' Equip</button>' :
              '<button class="btn btn-ghost btn-sm' + (S.coins < sk.price ? ' cant' : '') + '" data-action="buy-skin" data-arg="' + sk.id + '">' + icon('coin') + ' ' + sk.price + '</button>') + '</div>';
      }).join('');
      $('#screen-shop').innerHTML =
        '<div><h1 class="big-title">Power-Up Shop</h1><p class="sub-title">Arm boosters before launch or press 1–5 mid-game</p></div>' +
        '<div class="card balance"><span class="b-ic">' + icon('coin') + '</span><div><b>' + fmt(S.coins) + '</b><span>coin balance · ' + fmt(S.stats.coinsEarned) + ' earned all-time</span></div></div>' +
        '<div class="sec-title">BOOSTERS (7 TYPES)</div><div class="card">' + items + '</div>' +
        '<div class="sec-title">PADDLE &amp; BALL SKINS</div><div class="skins-row">' + skins + '</div>' +
        '<p class="foot">Skins stay unlocked forever. Boosters can also drop free from bricks!</p>';
    }

    function renderAwards() {
      ensureDaily();
      const st = S.stats, rk = rankForXP(S.xp);
      const winRate = st.gamesPlayed > 0 ? Math.round(st.gamesWon / st.gamesPlayed * 100) : 0;
      const avgCombo = st.comboRuns > 0 ? (st.comboSum / st.comboRuns).toFixed(1) : '0.0';
      const subtabs = '<div class="subtabs">' + [['overview', 'Ranks & Profile'], ['stats', 'Pro Stats'], ['missions', 'Missions'], ['achs', 'Awards']].map(t => '<button class="' + (UI.statsTab === t[0] ? 'active' : '') + '" data-action="stats-tab" data-arg="' + t[0] + '">' + t[1] + '</button>').join('') + '</div>';
      let body = '';
      if (UI.statsTab === 'overview') {
        const campRank = categoryRank(clearedCount(), [5, 15, 35, 60, 100, 150, 220], ['Initiate', 'Scout', 'Vanguard', 'Commander', 'Warlord', 'Galactic', 'Ascendant']);
        const endRank = categoryRank(st.endlessWave, [3, 6, 10, 16, 25, 40], ['Survivor', 'Runner', 'Gladiator', 'Titan', 'Immortal', 'Eternal']);
        const timeRank = categoryRank(st.timedBest, [1500, 4000, 8000, 15000, 25000], ['Sprinter', 'Blitzer', 'Velocity', 'Lightspeed', 'Chrono']);
        const comboRank = categoryRank(st.bestCombo, [5, 12, 20, 35, 50, 75], ['Spark', 'Chain', 'Flow', 'Surge', 'Overload', 'Godlike']);
        const bossRank = categoryRank(st.bossesDefeated, [1, 3, 6, 12, 20, 35], ['Challenger', 'Hunter', 'Slayer', 'Destroyer', 'Nemesis', 'Executioner']);
        body =
          '<div class="card"><div class="profile-box"><button class="avatar-btn" data-action="cycle-avatar" title="Tap to change avatar">' + S.avatar + '</button>' +
          '<div style="flex:1"><div style="font-size:11px;color:var(--muted);font-weight:700">PLAYER NAME (TAP AVATAR TO CHANGE)</div><input class="name-input" id="playerNameInput" maxlength="22" value="' + S.name.replace(/"/g, '&quot;') + '" aria-label="Player Name"></div></div>' +
          '<div class="rank-banner" style="margin:12px 0 0"><div class="rank-emblem">' + rk.icon + '</div><div class="rank-info"><b style="color:' + rk.color + '">' + rk.title + ' (Rank #' + rk.level + ')</b><small>Total XP: ' + fmt(S.xp) + ' · Next Rank: ' + fmt(rk.curXP) + ' / ' + fmt(rk.needed) + ' XP</small><div class="xp-bar"><i style="width:' + rk.pct + '%"></i></div></div></div></div>' +
          '<div class="sec-title">CATEGORY MASTERY RANKS</div>' +
          '<div class="card">' +
          '<div class="cat-rank-row"><span>🚀 Campaign Mastery (' + clearedCount() + ' lvls)</span><b>' + campRank + '</b></div>' +
          '<div class="cat-rank-row"><span>♾️ Endless Mastery (Wave ' + st.endlessWave + ')</span><b>' + endRank + '</b></div>' +
          '<div class="cat-rank-row"><span>⏱️ Time Attack Mastery (' + fmt(st.timedBest) + ')</span><b>' + timeRank + '</b></div>' +
          '<div class="cat-rank-row"><span>🔥 Combo Mastery (×' + st.bestCombo + ')</span><b>' + comboRank + '</b></div>' +
          '<div class="cat-rank-row"><span>👑 Boss Slayer (' + st.bossesDefeated + ' bosses)</span><b>' + bossRank + '</b></div></div>' +
          '<div class="sec-title">PERSONAL RECORDS BY MODE</div>' +
          '<div class="stats-grid">' +
          '<div class="sg-tile"><b>' + fmt(st.bestScore) + '</b><span>Highest Run Score</span></div>' +
          '<div class="sg-tile"><b>' + fmt(st.endlessBest) + '</b><span>Endless Record</span></div>' +
          '<div class="sg-tile"><b>' + fmt(st.timedBest) + '</b><span>Time Attack Record</span></div>' +
          '<div class="sg-tile"><b>' + fmt(st.dailyBest) + '</b><span>Daily Record</span></div></div>';
      } else if (UI.statsTab === 'stats') {
        const runs = S.recentRuns.length ? S.recentRuns : [{ score: 0, mode: 'none' }];
        const maxS = Math.max(100, ...runs.map(r => r.score));
        const bars = runs.map((r, i) => '<div class="cbar-col"><div class="cbar" style="height:' + Math.max(6, Math.round(r.score / maxS * 76)) + 'px;background:' + (r.won ? 'var(--grad-acid)' : 'var(--grad-hot)') + '" title="' + r.mode + ': ' + fmt(r.score) + '"></div><span class="cbar-lbl">#' + (i + 1) + '</span></div>').join('');
        const bt = st.brickTypes, totB = Math.max(1, st.bricks);
        const bRows = [
          ['Normal Bricks', bt.normal, '#22D3EE'], ['Armored Bricks', bt.armored, '#8B5CF6'],
          ['Explosive Bombs', bt.explosive, '#FF6B35'], ['Gold Coin Bricks', bt.gold, '#FFC53D'],
          ['Boss Crystal Cores', bt.core, '#E879F9'], ['Steel Destroyed (Fireball)', bt.steel, '#94A3B8']
        ].map(r => '<div class="btype-row"><div class="btype-head"><span>' + r[0] + '</span><b>' + fmt(r[1]) + ' (' + Math.round(r[1] / totB * 100) + '%)</b></div><div class="btype-track"><i style="width:' + clamp(r[1] / totB * 100, 0, 100) + '%;background:' + r[2] + '"></i></div></div>').join('');
        body =
          '<div class="stats-grid">' +
          '<div class="sg-tile"><b>' + fmt(st.totalScore) + '</b><span>Lifetime Score</span></div>' +
          '<div class="sg-tile"><b>' + winRate + '%</b><span>Win Rate (' + st.gamesWon + '/' + st.gamesPlayed + ')</span></div>' +
          '<div class="sg-tile"><b>' + fmt(st.bricks) + '</b><span>Bricks Broken</span></div>' +
          '<div class="sg-tile"><b>' + avgCombo + '</b><span>Avg Best Combo</span></div>' +
          '<div class="sg-tile"><b>' + st.perfectClears + '</b><span>Perfect 3★ Clears</span></div>' +
          '<div class="sg-tile"><b>' + st.bossesDefeated + '</b><span>Bosses Defeated</span></div>' +
          '<div class="sg-tile"><b>' + fmt(st.powers) + '</b><span>Power-Ups Caught</span></div>' +
          '<div class="sg-tile"><b>' + fmt(st.boostersUsed) + '</b><span>Boosters Used</span></div>' +
          '<div class="sg-tile"><b>' + st.dailyWins + '</b><span>Daily Wins</span></div>' +
          '<div class="sg-tile"><b>' + fmtTime(st.playtime) + '</b><span>Total Playtime</span></div></div>' +
          '<div class="card"><b style="font-size:13.5px">Recent 10 Runs Score Trend</b><p style="font-size:11px;color:var(--muted)">Green = Win · Orange = Attempt</p><div class="chart-bars">' + bars + '</div></div>' +
          '<div class="card"><b style="font-size:13.5px;display:block;margin-bottom:10px">Brick Destruction Breakdown</b>' + bRows + '</div>';
      } else if (UI.statsTab === 'missions') {
        const mHtml = DAILY_MISSIONS.map(m => {
          const cur = Math.min(S.daily[m.id] || 0, m.target), done = cur >= m.target, cl = S.daily.claims.includes(m.id);
          return '<div class="ach' + (done ? ' done' : '') + (cl ? ' claimed' : '') + '"><span class="ach-ic">' + icon(m.icon) + '</span>' +
            '<div class="ach-info"><b>' + m.name + '</b><p>' + m.desc + ' · ' + cur + '/' + m.target + ' · +' + m.xp + ' XP</p><div class="ach-bar"><i style="width:' + (cur / m.target * 100) + '%"></i></div></div>' +
            (cl ? '<span class="ach-claimed">' + icon('check') + '</span>' : '<button class="ach-claim' + (done ? '' : ' off') + '" data-action="claim-mission" data-arg="' + m.id + '">' + icon('coin') + ' +' + m.reward + '</button>') + '</div>';
        }).join('');
        body = '<div class="card"><b style="font-size:14px">Daily Missions (' + todayStr() + ')</b><p style="font-size:11.5px;color:var(--muted);margin-bottom:8px">Resets every day at midnight. Earn bonus coins &amp; Rank XP!</p>' + mHtml + '</div>' +
          '<div class="card"><b style="font-size:14px">Daily Challenge Status</b><p style="font-size:12px;color:var(--muted);margin:4px 0 12px">' + (S.daily.challengeDone ? 'You conquered today\'s cosmic board! Come back tomorrow for a new layout.' : 'A special seeded board awaits today with bonus XP and coins.') + '</p><button class="btn btn-primary btn-sm" data-action="start-daily">' + icon('play') + ' Play Daily Challenge</button></div>';
      } else {
        const achs = ACHS.map(a => {
          const cur = Math.min(a.cur(S), a.max), done = cur >= a.max, claimed = !!S.ach[a.id];
          return '<div class="ach' + (done ? ' done' : '') + (claimed ? ' claimed' : '') + '"><span class="ach-ic">' + icon(a.icon) + '</span>' +
            '<div class="ach-info"><b>' + a.name + '</b><p>' + a.desc + ' · ' + fmt(cur) + ' / ' + fmt(a.max) + '</p><div class="ach-bar"><i style="width:' + (cur / a.max * 100) + '%"></i></div></div>' +
            (claimed ? '<span class="ach-claimed">' + icon('check') + '</span>' :
              '<button class="ach-claim' + (done ? '' : ' off') + '" data-action="claim-ach" data-arg="' + a.id + '">' + icon('coin') + ' +' + a.reward + '</button>') + '</div>';
        }).join('');
        body = '<div class="card"><b style="font-size:14px;display:block;margin-bottom:6px">Achievements (' + ACHS.filter(a => S.ach[a.id]).length + ' / ' + ACHS.length + ')</b>' + achs + '</div>';
      }
      $('#screen-awards').innerHTML = '<div><h1 class="big-title">Stats, Ranks &amp; Awards</h1><p class="sub-title">Full analytics, mastery ranks, daily missions &amp; trophies</p></div>' + subtabs + body;
      const inp = $('#playerNameInput');
      if (inp) inp.addEventListener('change', e => { S.name = e.target.value.trim().slice(0, 22) || 'Player One'; e.target.value = S.name; saveNow(); toast('Player name saved', 'check', 'good') });
    }

    function segRow(label, desc, key, opts) {
      const cur = S.set[key];
      return '<div style="padding:10px 0;border-bottom:1px solid rgba(160,140,255,.08)">' +
        '<div style="margin-bottom:7px"><b style="font-size:13.5px;display:block">' + label + '</b>' + (desc ? '<span style="font-size:11px;color:var(--muted)">' + desc + '</span>' : '') + '</div>' +
        '<div class="seg">' + opts.map(o => '<button class="' + (cur === o[0] ? 'active' : '') + '" data-action="set-opt" data-key="' + key + '" data-arg="' + o[0] + '">' + o[1] + '</button>').join('') + '</div></div>';
    }
    function rangeRow(key, label, valText, min, max, step, val) {
      return '<div class="slider-row" style="border-bottom:1px solid rgba(160,140,255,.08)"><div class="slider-head"><span>' + label + '</span><span id="lbl_' + key + '">' + valText + '</span></div>' +
        '<input type="range" min="' + min + '" max="' + max + '" step="' + step + '" value="' + val + '" data-range="' + key + '" aria-label="' + label + '"></div>';
    }
    function renderSettings() {
      const d = S.set.diff || 'classic';
      const seg = Object.keys(DIFFS).map(k => '<button class="' + (k === d ? 'active' : '') + '" data-action="difficulty" data-arg="' + k + '">' + icon(DIFFS[k].icon) + DIFFS[k].label + '</button>').join('');
      $('#screen-settings').innerHTML =
        '<div><h1 class="big-title">Pro Settings Studio</h1><p class="sub-title">Full customization: gameplay, physics, controls, audio, graphics, accessibility &amp; backups</p></div>' +

        '<div class="sec-title">GAMEPLAY &amp; PHYSICS</div><div class="card">' +
        '<div style="margin-bottom:10px"><b style="font-size:13.5px;display:block;margin-bottom:6px">Difficulty Preset</b><div class="seg">' + seg + '</div><p class="seg-desc">' + DIFFS[d].desc + '</p></div>' +
        rangeRow('ballSpeedPct', 'Ball Speed Multiplier', (S.set.ballSpeedPct ?? 100) + '%', 70, 150, 5, S.set.ballSpeedPct ?? 100) +
        rangeRow('paddleSizePct', 'Paddle Size Multiplier', (S.set.paddleSizePct ?? 100) + '%', 75, 140, 5, S.set.paddleSizePct ?? 100) +
        segRow('Starting Lives Override', 'Use difficulty preset lives or custom starting hearts', 'startLives', [[0, 'Preset (' + DIFFS[d].lives + '♥)'], [2, '2 ♥'], [3, '3 ♥'], [4, '4 ♥'], [5, '5 ♥']]) +
        segRow('Aim Trajectory Guide', 'Dotted bounce preview when aiming from paddle', 'aimGuide', [['off', 'Off'], ['short', 'Short'], ['full', 'Full Bounce']]) +
        swRow('trapDrops', 'Hazard Trap Capsules', 'Allow Overdrive & Shrink red trap drops in later worlds', 'alert', S.set.trapDrops !== false) +
        swRow('autoPauseBlur', 'Auto-Pause on Tab Switch', 'Automatically pause game when window loses focus', 'pause', S.set.autoPauseBlur !== false) +
        '</div>' +

        '<div class="sec-title">CONTROLS &amp; ERGONOMICS</div><div class="card">' +
        segRow('Touch / Pointer Steering Mode', 'Choose how pointer or finger moves the paddle', 'controlMode', [['drag', 'Relative Drag'], ['direct', 'Direct Follow'], ['tap', 'Tap Left/Right']]) +
        rangeRow('sens', 'Touch Drag Sensitivity', Math.round((S.set.sens ?? 1) * 100) + '%', 50, 200, 5, Math.round((S.set.sens ?? 1) * 100)) +
        rangeRow('keySpeedPct', 'Keyboard Steering Speed', (S.set.keySpeedPct ?? 100) + '%', 60, 180, 10, S.set.keySpeedPct ?? 100) +
        segRow('Paddle Vertical Position', 'Raise paddle higher on mobile for thumb comfort', 'paddleHeightOffset', [['low', 'Low'], ['medium', 'Standard'], ['high', 'High (Thumb)']]) +
        swRow('tapLaunch', 'Tap / Click Screen to Launch', 'Quick tap anywhere on arena launches held ball', 'target', S.set.tapLaunch !== false) +
        swRow('invertControls', 'Invert Left / Right Controls', 'Reverse horizontal steering direction', 'move', !!S.set.invertControls) +
        swRow('haptics', 'Haptic Vibration Feedback', 'Physical vibration on mobile devices', 'vibrate', !!S.set.haptics) +
        segRow('Haptic Intensity', 'Strength of vibration pulses', 'hapticStrength', [['light', 'Light'], ['medium', 'Medium'], ['strong', 'Strong']]) +
        '</div>' +

        '<div class="sec-title">AUDIO &amp; SYNTH SOUNDTRACK</div><div class="card">' +
        rangeRow('masterVol', 'Master Volume', (S.set.masterVol ?? 90) + '%', 0, 100, 5, S.set.masterVol ?? 90) +
        swRow('sfx', 'Sound Effects (SFX)', 'Pops, lasers, explosions &amp; chimes', 'zap', !!S.set.sfx) +
        rangeRow('sfxVol', 'SFX Volume', (S.set.sfxVol ?? 100) + '%', 10, 100, 5, S.set.sfxVol ?? 100) +
        swRow('bgm', 'Arcade Synthwave Music (BGM)', 'Procedural offline background music loop', 'music', !!S.set.bgm) +
        rangeRow('bgmVol', 'Music Volume', (S.set.bgmVol ?? 55) + '%', 10, 100, 5, S.set.bgmVol ?? 55) +
        segRow('Synth Sound Profile', 'Change harmonic pitch character of game audio', 'soundTheme', [['arcade', 'Classic Arcade'], ['crystal', 'Crystal High'], ['bass', 'Deep Bass']]) +
        '</div>' +

        '<div class="sec-title">GRAPHICS, HUD &amp; VISUAL FX</div><div class="card">' +
        segRow('Render Resolution Quality', 'Adjust canvas pixel density for sharpness vs battery', 'graphicsQuality', [['low', 'Battery (1x)'], ['medium', 'Balanced'], ['high', 'Ultra HD (2x)']]) +
        rangeRow('particlePct', 'Particle Burst Density', (S.set.particlePct ?? 100) + '%', 25, 175, 25, S.set.particlePct ?? 100) +
        swRow('fx', 'High Dynamic Glow &amp; Shaders', 'Full neon bloom, aurora drift &amp; confetti', 'wand', !!S.set.fx) +
        swRow('trail', 'Neon Ball Motion Trail', 'Glowing streak behind moving balls', 'sparkles', !!S.set.trail) +
        swRow('shake', 'Camera Impact Shake', 'Screen shake on explosions &amp; combos', 'gauge', !!S.set.shake) +
        rangeRow('shakePct', 'Screen Shake Intensity', (S.set.shakePct ?? 100) + '%', 25, 150, 25, S.set.shakePct ?? 100) +
        swRow('hitFlash', 'Explosion Screen Flash', 'Brief flash on bomb blasts &amp; ball loss', 'flame', S.set.hitFlash !== false) +
        swRow('bgStars', 'Animated Starfield Backdrop', 'Drifting deep-space stars behind bricks', 'sparkles', S.set.bgStars !== false) +
        swRow('floatTexts', 'Floating Score &amp; Combo Popups', 'Show +points popups when bricks break', 'trend', S.set.floatTexts !== false) +
        swRow('showBoostBar', 'Show Booster Bar in HUD', 'Display quick-trigger 1-5 booster pills in game HUD', 'bag', S.set.showBoostBar !== false) +
        swRow('showFps', 'Show Live FPS Counter', 'Display real-time frame rate badge in corner', 'gauge', !!S.set.showFps) +
        '</div>' +

        '<div class="sec-title">ACCESSIBILITY</div><div class="card">' +
        swRow('colorblindMode', 'Colorblind Assist Symbols', 'Draw high-contrast symbols (2, 3, B, X, $, ★) on bricks &amp; capsules', 'eye', !!S.set.colorblindMode) +
        swRow('highContrast', 'High Contrast UI Theme', 'Brighter text &amp; stronger panel borders', 'eye', !!S.set.highContrast) +
        swRow('largeHud', 'Large In-Game HUD Text', 'Increase score &amp; level counter size for readability', 'maximize', !!S.set.largeHud) +
        swRow('reducedMotion', 'Reduced Motion Mode', 'Minimize animations, drift &amp; particle bursts', 'leaf', !!S.set.reducedMotion) +
        '</div>' +

        '<div class="sec-title">SAVE DATA, BACKUP &amp; RESET</div><div class="card">' +
        '<div class="btn-row" style="margin-bottom:9px"><button class="btn btn-cyan btn-sm" data-action="export-save">' + icon('bag') + ' Export Save Backup</button>' +
        '<button class="btn btn-ghost btn-sm" data-action="import-save">' + icon('sparkles') + ' Import Backup</button></div>' +
        '<button class="btn btn-ghost btn-sm" data-action="reset-settings" style="width:100%;margin-bottom:9px">' + icon('restart') + ' Restore Default Settings (Keep Progress)</button>' +
        '<button class="btn btn-danger btn-sm" data-action="reset-progress" style="width:100%">' + icon('trash') + ' Erase All Progress &amp; Save Data</button></div>' +

        '<div class="card about"><b>BRICKPOP NOVA ULTIMATE</b>Unlimited Levels &amp; Ranks · 4 Modes · 11 Power-Ups · 100% Offline<br>💛 Dedicated to my little <b>Muhib Ullah</b>' +
        '<div class="copy-box"><b>&copy; 2026 Yasin Ullah — Bannu Software Solutions</b><br>WhatsApp: 0336-1593533<br>Copying, modification, redistribution, or reuse is strictly prohibited without explicit permission and attribution to the original author (Yasin Ullah).</div></div>';
    }

    /* ---------- ACTIONS ---------- */
    function toggleFullscreen() {
      const target = $('#app');
      if (document.fullscreenElement) { document.exitFullscreen?.().catch(() => { }) }
      else if (target.requestFullscreen) { target.requestFullscreen().catch(() => toast('Fullscreen unavailable in this view', 'info', 'info')) }
      else toast('Fullscreen unavailable here', 'info', 'info');
    }
    const actions = {
      tab(arg) { if (UI.screen === arg) return; sfx.click(); haptic(4); showScreen(arg) },
      mute() { unlockAudio(); setMuted(!S.muted); haptic(6) },
      fullscreen() { sfx.click(); toggleFullscreen() },
      world(arg) { UI.absWorld = +arg; sfx.click(); renderLevels() },
      'sector-prev'() { const sec = Math.floor(UI.absWorld / 8); if (sec > 0) { UI.absWorld = (sec - 1) * 8; sfx.click(); renderLevels() } },
      'sector-next'() { const sec = Math.floor(UI.absWorld / 8); UI.absWorld = (sec + 1) * 8; sfx.click(); renderLevels() },
      'lvl-filter'(arg) { UI.levelFilter = arg; sfx.click(); renderLevels() },
      'stats-tab'(arg) { UI.statsTab = arg; sfx.click(); renderAwards() },
      'cycle-avatar'() { const idx = (AVATARS.indexOf(S.avatar) + 1) % AVATARS.length; S.avatar = AVATARS[idx]; saveNow(); sfx.click(); renderAwards() },
      'start-level'(arg) {
        const idx = +arg;
        if (idx > getUnlocked()) { sfx.deny(); toast('Clear Level ' + idx + ' first to unlock!', 'lock', 'warn'); return }
        unlockAudio(); sfx.click(); haptic(8); startGame('campaign', idx);
      },
      'start-endless'() { unlockAudio(); sfx.click(); haptic(8); startGame('endless', 0) },
      'start-timed'() { unlockAudio(); sfx.click(); haptic(8); startGame('timed', 0) },
      'start-daily'() { unlockAudio(); sfx.click(); haptic(8); startGame('daily', 0) },
      help() { sfx.click(); openHelp() },
      'close-sheet'() { sfx.click(); closeSheet() },
      'sheet-backdrop'() { sheetBackdrop() },
      pause() { openPause() },
      resume() { if (!G) return; closeSheet(); if (G.state === 'paused') G.state = G.prevState; sfx.click() },
      restart() { sfx.click(); restartGame() },
      replay() { sfx.click(); restartGame() },
      quit() { sfx.click(); quitGame('levels') },
      map() { sfx.click(); quitGame('levels') },
      home() { sfx.click(); quitGame('home') },
      'go-shop'() { sfx.click(); quitGame('shop') },
      'go-settings'() { sfx.click(); quitGame('settings') },
      next() {
        sfx.click();
        if (!G) return;
        if (G.mode === 'daily') quitGame('home');
        else startGame('campaign', G.idx + 1);
      },
      'continue-run'() {
        if (!G || S.coins < 50) return;
        S.coins -= 50; markDirty(); syncHeader(true); saveNow();
        G.usedContinue = true; G.lives = 2; G.maxLives = Math.max(G.maxLives, 2); G.livesDirty = true;
        G.state = 'ready'; spawnBall(); closeSheet(); sfx.life(); toast('Second chance! +2 Lives', 'heart', 'good');
      },
      boost(arg) { triggerBoosterMidGame(arg) },
      'claim-daily'() {
        ensureDaily();
        if (S.daily.rewardClaimed) { sfx.deny(); return }
        const yest = new Date(Date.now() - 864e5).toISOString().slice(0, 10);
        S.streak = S.lastClaimDate === yest ? S.streak + 1 : 1;
        S.lastClaimDate = todayStr(); S.daily.rewardClaimed = true;
        const reward = 100 + Math.min(S.streak, 7) * 25;
        addCoins(reward); addXP(50); saveNow(); sfx.coin(); haptic([10, 20, 10]);
        toast('+' + reward + ' coins & +50 XP · Day ' + S.streak + ' streak!', 'coin', 'gold');
        renderHome(); updateBadges();
      },
      'claim-mission'(arg) {
        ensureDaily();
        const m = DAILY_MISSIONS.find(x => x.id === arg);
        if (!m || S.daily.claims.includes(arg) || (S.daily[arg] || 0) < m.target) { sfx.deny(); toast('Complete the mission goal first!', 'target', 'warn'); return }
        S.daily.claims.push(arg); addCoins(m.reward); addXP(m.xp); saveNow();
        sfx.life(); haptic([10, 20, 10]); toast(m.name + ' claimed! +' + m.reward + ' coins', 'trophy', 'gold');
        renderAwards(); updateBadges();
      },
      'buy-booster'(arg) {
        const b = BOOSTERS.find(x => x.id === arg); if (!b) return;
        if (S.coins < b.price) { sfx.deny(); toast('Not enough coins — break more bricks!', 'coin', 'warn'); return }
        S.coins -= b.price; S.inv[arg] = (S.inv[arg] || 0) + 1; saveNow(); syncHeader(true);
        sfx.coin(); haptic(10); toast(b.name + ' added to inventory', 'bag', 'good'); renderShop();
      },
      'buy-skin'(arg) {
        const sk = SKINS.find(x => x.id === arg); if (!sk) return;
        if (S.coins < sk.price) { sfx.deny(); toast('Not enough coins for ' + sk.name, 'coin', 'warn'); return }
        S.coins -= sk.price; S.skins.push(arg); S.skin = arg; saveNow(); syncHeader(true);
        sfx.power(); haptic(12); toast(sk.name + ' unlocked & equipped!', 'wand', 'good'); renderShop();
      },
      'equip-skin'(arg) { S.skin = arg; saveNow(); sfx.click(); haptic(6); renderShop() },
      'claim-ach'(arg) {
        const a = ACHS.find(x => x.id === arg); if (!a || S.ach[arg]) return;
        if (a.cur(S) < a.max) { sfx.deny(); toast('Keep playing to unlock this award', 'trophy', 'warn'); return }
        S.ach[arg] = true; addCoins(a.reward); addXP(100); saveNow();
        sfx.life(); haptic([10, 20, 10]); toast(a.name + ' · +' + a.reward + ' coins & +100 XP', 'trophy', 'gold');
        renderAwards(); updateBadges();
      },
      difficulty(arg) { S.set.diff = arg; saveNow(); sfx.click(); haptic(5); renderSettings() },
      'set-opt'(arg, el) {
        const key = el.dataset.key;
        if (!key) return;
        S.set[key] = (key === 'startLives') ? +arg : arg;
        saveNow(); applyAudioSet(); applyDisplaySet();
        sfx.click(); haptic(5);
        if (UI.screen === 'settings') renderSettings();
      },
      'reset-settings'() {
        S.set = freshSet(); saveNow(); applyAudioSet(); applyDisplaySet();
        sfx.power(); toast('All settings restored to factory defaults', 'check', 'good');
        renderSettings();
      },
      'export-save'() {
        sfx.click();
        const data = JSON.stringify(S, null, 2);
        try {
          const blob = new Blob([data], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url; a.download = 'brickpop_nova_backup_' + todayStr() + '.json';
          document.body.appendChild(a); a.click(); a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
        } catch (e) { }
        if (navigator.clipboard?.writeText) navigator.clipboard.writeText(data).catch(() => { });
        toast('Save backup downloaded & copied to clipboard!', 'check', 'good');
      },
      'import-save'() {
        sfx.click();
        openSheet('<div class="grabber"></div><div class="sheet-head"><div class="sheet-kicker" style="color:var(--cyan)">RESTORE BACKUP</div><h2 class="sheet-title">Import Save Data</h2></div>' +
          '<p style="font-size:12px;color:var(--muted);margin-bottom:10px">Paste your exported JSON backup below or choose a backup file:</p>' +
          '<input type="file" id="importFileInp" accept=".json,application/json" style="width:100%;margin-bottom:10px;font-size:12px;color:var(--muted)">' +
          '<textarea id="importJsonTxt" rows="5" placeholder="Paste exported JSON here..." style="width:100%;background:rgba(8,4,18,.75);border:1px solid var(--line2);border-radius:12px;padding:10px;color:var(--text);font-family:monospace;font-size:11.5px;margin-bottom:14px"></textarea>' +
          '<div class="sheet-btns"><button class="btn btn-primary" data-action="confirm-import">' + icon('check') + ' Restore Save Data</button>' +
          '<button class="btn btn-ghost" data-action="close-sheet">' + icon('x') + ' Cancel</button></div>', 'import', 'close-sheet');
        setTimeout(() => {
          const fi = $('#importFileInp');
          if (fi) fi.addEventListener('change', ev => {
            const file = ev.target.files?.[0]; if (!file) return;
            const reader = new FileReader();
            reader.onload = () => { const ta = $('#importJsonTxt'); if (ta) ta.value = String(reader.result || '') };
            reader.readAsText(file);
          });
        }, 40);
      },
      'confirm-import'() {
        const raw = $('#importJsonTxt')?.value?.trim();
        if (!raw) { sfx.deny(); toast('Please paste or select a valid backup JSON', 'alert', 'warn'); return }
        try {
          const p = JSON.parse(raw), f = freshSave();
          if (typeof p !== 'object' || !p) throw new Error('Invalid');
          S = {
            ...f, ...p,
            inv: { ...f.inv, ...(p.inv || {}) },
            set: { ...f.set, ...(p.set || {}) },
            stats: { ...f.stats, ...(p.stats || {}), brickTypes: { ...f.stats.brickTypes, ...(p.stats?.brickTypes || {}) } },
            daily: { ...f.daily, ...(p.daily || {}) },
            stars: p.stars || {}, bestLevelScore: p.bestLevelScore || {}, ach: p.ach || {},
            skins: p.skins || ['classic'], recentRuns: Array.isArray(p.recentRuns) ? p.recentRuns : []
          };
          saveNow(); closeSheet(); applyAudioSet(); applyDisplaySet(); syncHeader(true); syncMute(); updateBadges();
          sfx.win(); toast('Save backup restored successfully!', 'check', 'good');
          renderSettings();
        } catch (err) {
          sfx.deny(); toast('Invalid backup JSON format', 'alert', 'bad');
        }
      },
      'reset-progress'() {
        sfx.click();
        openSheet('<div class="grabber"></div><div class="confirm-ic">' + icon('alert') + '</div><h2 class="sheet-title" style="text-align:center">Reset All Progress?</h2>' +
          '<p class="confirm-text">All levels, ranks, XP, stats, stars, coins, boosters, skins, and achievements will be permanently erased.</p>' +
          '<div class="sheet-btns"><button class="btn btn-danger" data-action="confirm-reset">' + icon('trash') + ' Yes, Erase Everything</button>' +
          '<button class="btn btn-ghost" data-action="close-sheet">' + icon('x') + ' Keep My Progress</button></div>', 'confirm', 'close-sheet');
      },
      'confirm-reset'() {
        try { localStorage.removeItem(SAVE_KEY) } catch (e) { }
        S = freshSave(); saveNow(); closeSheet(); applyAudioSet(); applyDisplaySet(); syncHeader(); syncMute(); updateBadges();
        UI.absWorld = 0; showScreen('home'); sfx.bad(); toast('Fresh start — good luck!', 'sparkles', 'info');
      }
    };

    /* ---------- EVENTS ---------- */
    document.addEventListener('click', e => {
      const el = e.target.closest('[data-action]'); if (!el) return;
      const fn = actions[el.dataset.action]; if (fn) fn(el.dataset.arg, el, e);
    });
    document.addEventListener('change', e => {
      const el = e.target.closest('[data-set]'); if (!el || el.type !== 'checkbox') return;
      const k = el.dataset.set; S.set[k] = el.checked; saveNow(); applyAudioSet(); applyDisplaySet();
      if (G) { if (k === 'fx') resize(); if (k === 'showBoostBar') renderBoostBar() }
      sfx.click(); haptic(5);
    });
    document.addEventListener('input', e => {
      const el = e.target.closest('[data-range]'); if (!el) return;
      const k = el.dataset.range, v = +el.value;
      if (k === 'sens') S.set.sens = v / 100;
      else S.set[k] = v;
      markDirty();
      const lbl = $('#lbl_' + k); if (lbl) lbl.textContent = v + '%';
      if (k === 'masterVol' || k === 'sfxVol' || k === 'bgmVol') applyAudioSet();
    });
    function logicalX(e) {
      const r = cv.getBoundingClientRect();
      return ((e.clientX - r.left) / Math.max(1, r.width) * (cv.width / scale)) - viewX;
    }
    function steerTo(rawX, isDrag, dragObj) {
      const inv = S.set.invertControls ? -1 : 1;
      const mode = S.set.controlMode || 'drag';
      if (mode === 'tap' && dragObj && dragObj.moved < 12) {
        const dir = (rawX < VW / 2 ? -1 : 1) * inv;
        G.paddle.tx = clamp(G.paddle.tx + dir * 38, G.paddle.w / 2 + 4, VW - G.paddle.w / 2 - 4);
        return;
      }
      if (mode === 'direct' || (dragObj && dragObj.type === 'mouse') || !isDrag) {
        const target = S.set.invertControls ? (VW - rawX) : rawX;
        G.paddle.tx = clamp(target, G.paddle.w / 2 + 4, VW - G.paddle.w / 2 - 4);
      } else if (dragObj) {
        const dx = (rawX - dragObj.startX) * inv;
        G.paddle.tx = clamp(dragObj.paddleStart + dx * 1.15 * (S.set.sens ?? 1), G.paddle.w / 2 + 4, VW - G.paddle.w / 2 - 4);
      }
    }
    function onDown(e) {
      unlockAudio();
      if (!G || UI.sheet || (G.state !== 'play' && G.state !== 'ready')) return;
      if (drag) return;
      const x = logicalX(e);
      drag = { id: e.pointerId, startX: x, paddleStart: G.paddle.tx, moved: 0, t0: performance.now(), type: e.pointerType };
      try { cv.setPointerCapture(e.pointerId) } catch (err) { }
      if (e.pointerType === 'mouse' || S.set.controlMode === 'direct' || S.set.controlMode === 'tap') steerTo(x, true, drag);
      e.preventDefault();
    }
    function onMove(e) {
      if (!G || UI.sheet) return;
      if (e.pointerType === 'mouse' && !drag) { steerTo(logicalX(e), false, null); return }
      if (!drag || e.pointerId !== drag.id) return;
      const x = logicalX(e), dx = x - drag.startX;
      drag.moved = Math.max(drag.moved, Math.abs(dx));
      steerTo(x, true, drag);
      e.preventDefault();
    }
    function onUp(e) {
      if (!drag || e.pointerId !== drag.id) return;
      const quick = performance.now() - drag.t0 < 400 && drag.moved < 10;
      drag = null;
      if (quick && G && !UI.sheet && S.set.tapLaunch !== false && S.set.controlMode !== 'tap') launchBalls();
    }
    cv.addEventListener('pointerdown', onDown);
    cv.addEventListener('pointermove', onMove);
    cv.addEventListener('pointerup', onUp);
    cv.addEventListener('pointercancel', () => { drag = null });
    cv.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('pointerdown', unlockAudio, true);
    document.addEventListener('keydown', e => {
      unlockAudio();
      const tag = (e.target.tagName || '').toUpperCase();
      if (tag === 'INPUT') return;
      if (e.key === 'm' || e.key === 'M') { actions.mute(); return }
      if (e.key === 'f' || e.key === 'F') { actions.fullscreen(); return }
      if (e.key === 'Escape') {
        if (UI.sheet) { if (UI.dismiss) actions[UI.dismiss](); return }
        if (UI.screen === 'game') openPause(); return;
      }
      if (UI.screen !== 'game') return;
      if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') { keys.l = true; e.preventDefault() }
      else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') { keys.r = true; e.preventDefault() }
      else if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        if (UI.sheet === 'pause') actions.resume();
        else if (UI.sheet === 'win') actions.next();
        else if (UI.sheet === 'lose') actions.replay();
        else if (!UI.sheet) launchBalls();
      }
      else if (e.key === 'p' || e.key === 'P') { if (!UI.sheet) openPause(); else if (UI.sheet === 'pause') actions.resume() }
      else if (e.key === 'r' || e.key === 'R') { if (G) restartGame() }
      else if ('12345'.includes(e.key) && !e.repeat && !UI.sheet) {
        const owned = BOOSTERS.filter(b => S.inv[b.id] > 0).slice(0, 5);
        const chosen = owned[Number(e.key) - 1];
        if (chosen) triggerBoosterMidGame(chosen.id);
      }
    });
    document.addEventListener('keyup', e => {
      if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') keys.l = false;
      if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') keys.r = false;
    });
    window.addEventListener('resize', () => { if (UI.screen === 'game') resize() });
    document.addEventListener('fullscreenchange', () => { setTimeout(() => { if (UI.screen === 'game') resize() }, 60) });
    window.addEventListener('orientationchange', () => { setTimeout(() => { if (UI.screen === 'game') resize() }, 120) });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (G && (G.state === 'play' || G.state === 'ready') && !UI.sheet && S.set.autoPauseBlur !== false) openPause();
        if (G) { S.stats.playtime += G.runT; G.runT = 0 }
        saveNow();
      }
    });
    window.addEventListener('beforeunload', () => { if (G) { S.stats.playtime += G.runT; G.runT = 0 } saveNow() });

    /* ---------- MAIN LOOP & INIT ---------- */
    let last = performance.now(), fpsTick = 0;
    function frame(now) {
      requestAnimationFrame(frame);
      const rawDt = Math.max(0.001, (now - last) / 1000);
      const dt = Math.min(.05, rawDt); last = now;
      if (UI.screen !== 'game' || !G) return;
      fpsSmooth = lerp(fpsSmooth, 1 / rawDt, 0.08);
      if (S.set.showFps && (++fpsTick % 12 === 0)) {
        const fb = $('#fpsBadge');
        if (fb) fb.textContent = Math.min(240, Math.round(fpsSmooth)) + ' FPS';
      }
      update(dt); render(); syncHUD();
    }
    function init() {
      applyDisplaySet(); syncHeader(); syncMute(); updateBadges();
      UI.absWorld = Math.floor(getUnlocked() / 15);
      showScreen('home');
      requestAnimationFrame(frame);
      let tipIdx = 0;
      setInterval(() => {
        const el = $('#tipText'); if (!el) return;
        el.classList.add('fade');
        setTimeout(() => {
          tipIdx = (tipIdx + 1) % TIPS.length; const e2 = $('#tipText');
          if (e2) { e2.textContent = TIPS[tipIdx]; e2.classList.remove('fade') }
        }, 300);
      }, 5500);
      setInterval(() => { if (dirty) saveNow() }, 5000);
    }
    window.onload = init;
  </script>
</body>

</html>